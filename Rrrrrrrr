function initializeDataChangeTracking() {
    // Track changes in form fields to detect unsaved changes.
    $(document).on('change input', '.admin-form input, .admin-form select, .admin-card-body input, .admin-card-body select, .actor-analysis-form input, .actor-analysis-form select', function () {
        // Ignore Project & Credits screen
        if ($(this).closest('#project-credits-tab').length) {
            return;
        }
        // only mark as dirty if it is real user changes not programatic restoration.
        if (!$(this).data('restoring')) {
