    Private Function BuildDeleteWhere(saveQryId As ProjectCreditsQryIds, id As Integer, projId As Integer, statusId As Integer, flowId As Integer) As String
        Dim baseWhere = $"WHERE RE_PROJ_ID = {projId} " & $"AND RE_PROJ_STATUS_ID = {statusId} " & $"AND RE_PROJ_STATUS_FLOW_ID = {flowId} "

        Select Case saveQryId
            Case ProjectCreditsQryIds.RE_CRED
                Return baseWhere & $"AND RE_CRED_ID = {id}"
            Case ProjectCreditsQryIds.RE_COST
                Return baseWhere & $"AND RE_COST_ID = {id}"
                'Case ProjectCreditsQryIds.RE_ACTR
                '    Return baseWhere & $"AND RE_ACTR_TYPE_ID = {id}"
            Case Else
                Throw New InvalidOperationException("Delete not supported")
        End Select
    End Function

    Public Sub DeleteInvalidRecords(conn As OracleConnection, tx As OracleTransaction, saveQryId As ProjectCreditsQryIds, formName As String, userName As String, idsToDelete As IEnumerable(Of Integer), projId As Integer, statusId As Integer, flowId As Integer)
        For Each id In idsToDelete
            Dim whereClause As String = BuildDeleteWhere(saveQryId, id, projId, statusId, flowId)

            Dim deleteQryId As Integer

            Select Case saveQryId
                Case ProjectCreditsQryIds.RE_CRED
                    deleteQryId = 1
                Case ProjectCreditsQryIds.RE_COST
                    deleteQryId = 2
                    'Case ProjectCreditsQryIds.RE_ACTR
                    '    deleteQryId = 3
                Case Else
                    Throw New InvalidOperationException("Delete not supported")
            End Select

            Using cmd As New OracleCommand(RePrcrDelSpJson, conn)
                cmd.Transaction = tx
                cmd.CommandType = CommandType.StoredProcedure

                cmd.Parameters.Add("P_Formname", OracleDbType.Varchar2).Value = formName
                cmd.Parameters.Add("P_username", OracleDbType.Varchar2).Value = userName
                cmd.Parameters.Add("P_qry_ID", OracleDbType.Int32).Value = deleteQryId
                cmd.Parameters.Add("p_condition", OracleDbType.Varchar2).Value = whereClause

                Dim outParam As New OracleParameter("p_json_re_prcr_OUT", OracleDbType.Clob)
                outParam.Direction = ParameterDirection.Output
                cmd.Parameters.Add(outParam)
                cmd.ExecuteNonQuery()
            End Using
        Next
    End Sub

