        'Get :  Analysis/GetCollateralData  
        <HttpGet>
        Public Function GetCollateralData(Optional projectId As Integer? = Nothing,
                                          Optional projectStatusId As Integer? = Nothing,
                                          Optional projectFlowId As Integer? = Nothing) As JsonResult
            Dim sw = Stopwatch.StartNew()
            Dim userName = Current_LoginUser

            _logger.Information("GetCollateralData - Request received | User: {User} | ProjectId: {ProjectId} | ProjectStatusId: {StatusId} | ProjectFlowId: {FlowId}",
                                userName, projectId, projectStatusId, projectFlowId)

            Try
                ' ===============================  
                ' Resolve Project Context  
                ' ===============================  
                Dim finalProjectId As Integer
                Dim finalProjectStatusId As Integer?
                Dim finalProjectFlowId As Integer?

                If projectId.HasValue AndAlso projectId.Value > 0 Then
                    finalProjectId = projectId.Value
                    finalProjectStatusId = projectStatusId
                    finalProjectFlowId = projectFlowId
                ElseIf Session("AnalysisProjectId") IsNot Nothing Then
                    finalProjectId = CInt(Session("AnalysisProjectId"))
                    finalProjectStatusId = If(Session("AnalysisProjectStatusId"), CType(Nothing, Integer?))
                    finalProjectFlowId = If(Session("AnalysisProjectFlowId"), CType(Nothing, Integer?))
                Else
                    _logger.Warning("GetCollateralData - Project context not found in params or session | User: {User}", userName)
                    Throw New ApplicationException("Project context not found")
                End If
                _logger.Information("GetCollateralData - Checking for saved data (EDIT mode check) | User: {User} | ProjectId: {ProjectId} , ProjectStatusId: {projectStatusId}, ProjectFlowId: {projectFlowId}", userName, projectId, projectStatusId, projectFlowId)
                Dim warnings As New List(Of String)

                ' =============================================
                ' EDIT MODE (QID 1) - Saved data from CLTL table
                ' =============================================
                Dim saved = _collateralTabService.GetSavedCollateralDetails(
            finalProjectId, finalProjectStatusId, finalProjectFlowId)

                If saved IsNot Nothing AndAlso saved.Any() Then
                    _logger.Information("GetCollateralData - Saved data found, loading edit mode| User: {User} | ProjectId: {ProjectId} , ProjectStatusId: {projectStatusId}, ProjectFlowId: {projectFlowId}", userName, projectId, projectStatusId, projectFlowId)
                    Dim otherSavedCollateral = _collateralTabService.GetOtherCollateralData(finalProjectId, finalProjectStatusId, finalProjectFlowId)
                    Dim assetData = _collateralTabService.GetCollateraldata(finalProjectId, finalProjectStatusId, finalProjectFlowId)
                    sw.Stop()
                    _logger.Information("GetCollateralData - EDIT mode response ready | ProjectId: {ProjectId}, ProjectStatusId: {projectStatusId}, ProjectFlowId: {projectFlowId} | ElapsedMs: {ElapsedMs}ms", finalProjectId, finalProjectStatusId, finalProjectFlowId, sw.ElapsedMilliseconds)
                    Return Json(New With {
                .success = True,
                                .mode = "EDIT",
                                .collateral = saved,
                                .asset = assetData,
                                .other = otherSavedCollateral
                    }, JsonRequestBehavior.AllowGet)
                End If

                ' ===============================  
