 Public Interface IAnalysisPdfService
    Function GenerateAnalysisReportPdfAsync(projectId As Integer, projectStatusId As Integer?, projectFlowId As Integer?) As Task(Of Byte())
End Interface











Imports Microsoft.Reporting.WebForms
Imports Serilog
Imports System.Web.Hosting

Public Class AnalysisPdfService
    Implements IAnalysisPdfService

    Private ReadOnly _adminTabService As IAdminTabService
    Private ReadOnly _actorTabService As IActorTabService
    Private ReadOnly _collateralTabService As ICollateralTabService
    Private ReadOnly _assetTabRepository As IAssetTabRepository
    Private ReadOnly _guidanceTabRepository As IGuidanceTabRepository
    Private ReadOnly _projectCreditsTabService As IProjectCreditsTabService
    Private ReadOnly _logger As ILogger

    Private Const RdlcVirtualPath As String = "~/Report/AnalysisReport.rdlc"

    Public Sub New(adminTabService As IAdminTabService,
                   actorTabService As IActorTabService,
                   collateralTabService As ICollateralTabService,
                   assetTabRepository As IAssetTabRepository,
                   guidanceTabRepository As IGuidanceTabRepository,
                   projectCreditsTabService As IProjectCreditsTabService)
        _adminTabService = adminTabService
        _actorTabService = actorTabService
        _collateralTabService = collateralTabService
        _assetTabRepository = assetTabRepository
        _guidanceTabRepository = guidanceTabRepository
        _projectCreditsTabService = projectCreditsTabService
        _logger = Log.ForContext(Of AnalysisPdfService)()
    End Sub

    Public Async Function GenerateAnalysisReportPdfAsync(projectId As Integer, projectStatusId As Integer?, projectFlowId As Integer?) As Task(Of Byte()) Implements IAnalysisPdfService.GenerateAnalysisReportPdfAsync

        Dim allFields As List(Of AnalysisPdfFieldModel) = Await BuildAllFieldsAsync(projectId, projectStatusId, projectFlowId)

        If Not allFields.Any() Then
            _logger.Warning("GenerateAnalysisReportPdfAsync - No fields resolved for any tab | ProjectId: {ProjectId}", projectId)
            Throw New InvalidOperationException("No report data available.")
        End If

        Return RenderPdf(allFields)

    End Function

    Private Async Function BuildAllFieldsAsync(projectId As Integer, projectStatusId As Integer?, projectFlowId As Integer?) As Task(Of List(Of AnalysisPdfFieldModel))

        Dim allFields As New List(Of AnalysisPdfFieldModel)()

        ' ---- Admin tab (CURATED) ----
        Try
            Dim adminData = Await _adminTabService.GetAdminDataAsync(projectId, projectStatusId, projectFlowId)
            allFields.AddRange(_adminTabService.GetAdminPdfFields(adminData))
        Catch ex As Exception
            _logger.Error(ex, "BuildAllFieldsAsync - Admin tab failed | ProjectId: {ProjectId}", projectId)
            allFields.Add(New AnalysisPdfFieldModel("Admin", "Error", "Note", "Admin data unavailable", 0))
        End Try

        ' ---- Actor tab (CURATED - Main Debtor fields) ----
        Try
            If projectStatusId.HasValue AndAlso projectFlowId.HasValue Then
                Dim actorData = Await _actorTabService.GetActorTabDataAsync(projectId, projectStatusId.Value, projectFlowId.Value)
                Dim actorFields = New String() {"ActorId", "ActorName", "BelfiusClient"}
                allFields.AddRange(PdfFieldReflectionHelper.GetAutoPdfFields("Actor", "Main Debtor", actorData.MainDebtor, includeOnly:=actorFields))
            End If
        Catch ex As Exception
            _logger.Error(ex, "BuildAllFieldsAsync - Actor tab failed | ProjectId: {ProjectId}", projectId)
            allFields.Add(New AnalysisPdfFieldModel("Actor", "Error", "Note", "Actor data unavailable", 0))
        End Try

        ' ---- Project & Credits tab (SPECIFIC FIELDS) ----
        Try
            Dim projectCreditsData = _projectCreditsTabService.GetProjectCreditsData(projectId, projectStatusId, projectFlowId)
            Dim excludeProps = New String() {"ProjectCreditsTabData", "JsonForClient"}
            Dim projectCreditsFields = New String() {"ProjectId"}
            allFields.AddRange(PdfFieldReflectionHelper.GetAutoPdfFields("Project & Credits", "All Fields", projectCreditsData, additionalExcludes:=excludeProps, includeOnly:=projectCreditsFields))
        Catch ex As Exception
            _logger.Error(ex, "BuildAllFieldsAsync - Project & Credits tab failed | ProjectId: {ProjectId}", projectId)
            allFields.Add(New AnalysisPdfFieldModel("Project & Credits", "Error", "Note", "Project & Credits data unavailable", 0))
        End Try

        ' ---- Project Asset tab (SPECIFIC FIELDS) ----
        Try
            Dim assetData = _assetTabRepository.GetAssetData(projectId, projectStatusId, projectFlowId)
            Dim assetFields = New String() {"ASST_STREET_NM", "ASST_CITY_NM", "ASST_MARKET_VALUE_AM"}
            Dim assetLabels = New Dictionary(Of String, String) From {
                {"ASST_STREET_NM", "Street"},
                {"ASST_CITY_NM", "City"},
                {"ASST_MARKET_VALUE_AM", "Market Value"}
            }
            allFields.AddRange(PdfFieldReflectionHelper.GetAutoPdfFields("Project Asset", "All Fields", assetData, includeOnly:=assetFields, labelOverrides:=assetLabels))
        Catch ex As Exception
            _logger.Error(ex, "BuildAllFieldsAsync - Project Asset tab failed | ProjectId: {ProjectId}", projectId)
            allFields.Add(New AnalysisPdfFieldModel("Project Asset", "Error", "Note", "Project Asset data unavailable", 0))
        End Try

        ' ---- Collateral tab (CURATED) ----
        Try
            Dim collateralData = _collateralTabService.GetSavedCollateralDetails(projectId, projectStatusId, projectFlowId)
            If collateralData Is Nothing OrElse Not collateralData.Any() Then
                collateralData = _collateralTabService.GetCollateraldata(projectId, projectStatusId, projectFlowId)
            End If
            allFields.AddRange(_collateralTabService.GetCollateralPdfFields(collateralData))
        Catch ex As Exception
            _logger.Error(ex, "BuildAllFieldsAsync - Collateral tab failed | ProjectId: {ProjectId}", projectId)
            allFields.Add(New AnalysisPdfFieldModel("Collateral", "Error", "Note", "Collateral data unavailable", 0))
        End Try

        ' ---- Guidance tab (SPECIFIC FIELDS with friendly labels) ----
        Try
            Dim guidanceData = _guidanceTabRepository.GetGuidanceData(projectId, projectStatusId, projectFlowId)
            Dim guidanceFields = New String() {"PROJ_ID", "PROJ_STATUS_ID"}
            Dim guidanceLabels = New Dictionary(Of String, String) From {
                {"PROJ_ID", "Project ID"},
                {"PROJ_STATUS_ID", "Project Status"}
            }
            allFields.AddRange(PdfFieldReflectionHelper.GetAutoPdfFields("Guidance", "All Fields", guidanceData, includeOnly:=guidanceFields, labelOverrides:=guidanceLabels))
        Catch ex As Exception
            _logger.Error(ex, "BuildAllFieldsAsync - Guidance tab failed | ProjectId: {ProjectId}", projectId)
            allFields.Add(New AnalysisPdfFieldModel("Guidance", "Error", "Note", "Guidance data unavailable", 0))
        End Try

        Return allFields

    End Function

    Private Function RenderPdf(allFields As List(Of AnalysisPdfFieldModel)) As Byte()

        Dim physicalPath As String = HostingEnvironment.MapPath(RdlcVirtualPath)
        If String.IsNullOrEmpty(physicalPath) Then
            Throw New ArgumentException($"AnalysisPdfService - Could not resolve rdlc path: {RdlcVirtualPath}")
        End If

        Dim lrLocalReport As New LocalReport()
        lrLocalReport.ReportPath = physicalPath

        Dim reportDataSource As New ReportDataSource("AnalysisFields", allFields)
        lrLocalReport.DataSources.Add(reportDataSource)

        Dim deviceInfo As String =
            "<DeviceInfo>" &
            "<PageHeight>297mm</PageHeight>" &
            "<PageWidth>210mm</PageWidth>" &
            "<MarginTop>10mm</MarginTop>" &
            "<MarginLeft>10mm</MarginLeft>" &
            "<MarginRight>10mm</MarginRight>" &
            "<MarginBottom>10mm</MarginBottom>" &
            "</DeviceInfo>"

        Dim mimeType, encoding, extension As String
        Dim streamIds As String()
        Dim warnings As Warning()

        Dim pdfBytes As Byte() = lrLocalReport.Render("PDF", deviceInfo, mimeType, encoding, extension, streamIds, warnings)

        _logger.Information("RenderPdf - PDF generated successfully | FieldCount: {Count} | SizeBytes: {Size}", allFields.Count, pdfBytes.Length)

        Return pdfBytes

    End Function

End Class








Private ReadOnly _analysisPdfService As IAnalysisPdfService




_analysisPdfService = analysisPdfService






<HttpGet>
Public Async Function GenerateAnalysisPdf() As Task(Of ActionResult)
    Dim sw = Stopwatch.StartNew()
    Dim userName = Current_LoginUser
    _logger.Information("GenerateAnalysisPdf - Request received | User: {User}", userName)

    Try
        Dim sessionValidation = validateSessionParameters()
        If Not sessionValidation.IsValid Then
            _logger.Warning("GenerateAnalysisPdf - Session invalid | User: {User} | Reason: {Reason}", userName, sessionValidation.Message)
            Return New HttpStatusCodeResult(400, sessionValidation.Message)
        End If

        Dim projectId = sessionValidation.ProjectId
        Dim projectStatusId = sessionValidation.ProjectStatusId
        Dim projectFlowId = sessionValidation.ProjectFlowId

        Dim pdfBytes As Byte() = Await _analysisPdfService.GenerateAnalysisReportPdfAsync(projectId, projectStatusId, projectFlowId)

        sw.Stop()
        _logger.Information("GenerateAnalysisPdf - Completed | User: {User} | ProjectId: {ProjectId} | SizeBytes: {Size} | ElapsedMs: {ElapsedMs}ms",
                            userName, projectId, pdfBytes.Length, sw.ElapsedMilliseconds)

        Dim fileName As String = $"Analysis_Project_{projectId}_{DateTime.Now:yyyyMMdd_HHmmss}.pdf"
        Return File(pdfBytes, "application/pdf", fileName)

    Catch ex As Exception
        sw.Stop()
        _logger.Error(ex, "GenerateAnalysisPdf - Unhandled exception | User: {User} | ElapsedMs: {ElapsedMs}ms", userName, sw.ElapsedMilliseconds)
        Return New HttpStatusCodeResult(500, "Error generating PDF: " & ex.Message)
    End Try
End Function