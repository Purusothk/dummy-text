    Private Function RenderPdf(lrLocalReport As LocalReport, strFileName As String) As String

        Try

            Dim warnings As Warning() = Nothing
            Dim streamids As String() = Nothing
            Dim mimeType As String = Nothing
            Dim encoding As String = Nothing
            Dim extension As String = Nothing
            Dim bytes As Byte()
            Dim deviceInf As String

            'De device info bevat informatie over de marges en paginagrootte van de te renderen PDF
            deviceInf = "<DeviceInfo><PageHeight>297mm</PageHeight><PageWidth>210mm</PageWidth>" _
                              & "<MarginTop>10mm</MarginTop>" _
                              & "<MarginLeft>0cm</MarginLeft>" _
                              & "<MarginRight>0cm</MarginRight>" _
                              & "<MarginBottom>0cm</MarginBottom>" _
                              & "</DeviceInfo>"

            lrLocalReport.Refresh()

            bytes = lrLocalReport.Render("PDF", deviceInf, mimeType, encoding, extension, streamids, warnings)
            'bytes = lrLocalReport.Render("PDF")

            'lrLocalReport.Render("PDF")

            lrLocalReport.ReleaseSandboxAppDomain()
            lrLocalReport.DataSources.Clear()
            lrLocalReport.Dispose()

            GC.Collect()
            GC.WaitForPendingFinalizers()
            GC.Collect(0)

            Dim fs As New FileStream(objParams.GetParam("EXPORT_PATH") & strFileName, FileMode.Create)

            fs.Write(bytes, 0, bytes.Length)
            fs.Close()

            'Cleanup memory

            fs.Dispose()
            fs = Nothing

            encoding = Nothing
            extension = Nothing
            deviceInf = Nothing

            Array.Clear(warnings, 0, warnings.Length)
            warnings = Nothing

            Array.Clear(streamids, 0, streamids.Length)
            streamids = Nothing

            Array.Clear(bytes, 0, bytes.Length)
            bytes = Nothing

            Application.DoEvents()
            GC.Collect()
            GC.WaitForPendingFinalizers()
            GC.Collect(0)

            Return "OK - RenderPdf - " & strFileName

        Catch ex As Exception
            Return "NOK - RenderPdf - " & strFileName & " - " & ex.Message
        End Try

    End Function

