    Public Sub SaveProjectCredits(payload As ProjectCreditsTabSaveDto) Implements IProjectCreditsTabRepository.SaveProjectCredits
        Dim sw = Stopwatch.StartNew()
        _logger.Information("SaveProjectCredits - SP call started | User: {User} | ProjectId: {ProjectId} | StatusId: {StatusId} | FlowId: {FlowId}", Cur_UserID, payload?.ProjectId, payload?.ProjectStatusId, payload?.ProjectStatusFlowId)
        Dim formName As String = "ProjectCredits"
        Dim userName As String = Cur_UserID

        Using conn As OracleConnection = _dbContext.CreateConnection()
            conn.Open()

            Using tx = conn.BeginTransaction()
                Try
                    SaveSingle(conn, tx, formName, userName, ProjectCreditsQryIds.RE_PRCR, payload.RE_PRCR)
                    SaveSingle(conn, tx, formName, userName, ProjectCreditsQryIds.RE_CROI, payload.RE_CROI)
                    SaveSingle(conn, tx, formName, userName, ProjectCreditsQryIds.RE_CRGU, payload.RE_CRGU)
                    SaveSingle(conn, tx, formName, userName, ProjectCreditsQryIds.RE_PRFU, payload.RE_PRFU)
                    SaveListWithDiff(conn, tx, formName, userName, ProjectCreditsQryIds.RE_CRED, payload.ProjectId, payload.ProjectStatusId, payload.ProjectStatusFlowId, payload.RE_CRED)
                    SaveListWithDiff(conn, tx, formName, userName, ProjectCreditsQryIds.RE_COST, payload.ProjectId, payload.ProjectStatusId, payload.ProjectStatusFlowId, payload.RE_COST)

                    tx.Commit()
                    sw.Stop()
                    _logger.Information("SaveProjectCredits - Success | User: {User} | ProjectId: {ProjectId} | ElapsedMs: {ElapsedMs}ms", Cur_UserID, payload.ProjectId, sw.ElapsedMilliseconds)
                Catch ex As Exception
                    tx.Rollback()
                    sw.Stop()
                    _logger.Error(ex, "SaveProjectCredits - Failed, transaction rolled back | User: {User} | ProjectId: {ProjectId} | ElapsedMs: {ElapsedMs}ms", Cur_UserID, payload?.ProjectId, sw.ElapsedMilliseconds)
                    Throw
                End Try
            End Using
        End Using
    End Sub

    Private Function GetTableName(qryId As ProjectCreditsQryIds) As String
        Select Case qryId
            Case ProjectCreditsQryIds.RE_PRCR
                Return QrerSchema & Dot & "RE_PRCR"
            Case ProjectCreditsQryIds.RE_COST
                Return QrerSchema & Dot & "RE_COST"
            Case ProjectCreditsQryIds.RE_CROI
                Return QrerSchema & Dot & "RE_CROI"
            Case ProjectCreditsQryIds.RE_CRGU
                Return QrerSchema & Dot & "RE_CRGU"
            Case ProjectCreditsQryIds.RE_PRFU
                Return QrerSchema & Dot & "RE_PRFU"
            Case ProjectCreditsQryIds.RE_CRED
                Return QrerSchema & Dot & "RE_CRED"
                'Case ProjectCreditsQryIds.RE_ACTR
                '    Return QrerSchema & Dot & "RE_ACTR"
            Case Else
                Throw New ArgumentOutOfRangeException(NameOf(qryId), "Invalid ProjectCreditsQryId")
        End Select
    End Function

    Private Function RecordExists(conn As OracleConnection, tx As OracleTransaction, formName As String, userName As String, saveQryId As ProjectCreditsQryIds, entity As Object) As Boolean

        Dim qry As String = "SELECT COUNT(1) FROM " & GetTableName(saveQryId) & " WHERE RE_PROJ_ID = " & entity.RE_PROJ_ID & " AND RE_PROJ_STATUS_ID = " & entity.RE_PROJ_STATUS_ID & " AND RE_PROJ_STATUS_FLOW_ID = " & entity.RE_PROJ_STATUS_FLOW_ID & If(saveQryId = ProjectCreditsQryIds.RE_CRED, " AND RE_CRED_ID = " & entity.RE_CRED_ID & "", "") & If(saveQryId = ProjectCreditsQryIds.RE_COST, " AND RE_COST_ID = " & entity.RE_COST_ID & "", "")
        'Dim qry As String = "SELECT COUNT(1) FROM " & GetTableName(saveQryId) & " WHERE RE_PROJ_ID = " & entity.RE_PROJ_ID & " AND RE_PROJ_STATUS_ID = " & entity.RE_PROJ_STATUS_ID & " AND RE_PROJ_STATUS_FLOW_ID = " & entity.RE_PROJ_STATUS_FLOW_ID & If(saveQryId = ProjectCreditsQryIds.RE_ACTR, " AND RE_ACTR_TYPE_ID = " & entity.RE_ACTR_TYPE_ID & "", "") & If(saveQryId = ProjectCreditsQryIds.RE_CRED, " AND RE_CRED_ID = " & entity.RE_CRED_ID & "", "") & If(saveQryId = ProjectCreditsQryIds.RE_COST, " AND RE_COST_ID = " & entity.RE_COST_ID & "", "")
        Using cmd As New OracleCommand(ReGetRecCount, conn)
            cmd.Transaction = tx
            cmd.CommandType = CommandType.StoredProcedure

            ' Input Parameters
            cmd.Parameters.Add("P_Formname", OracleDbType.Varchar2).Value = formName
            cmd.Parameters.Add("P_username", OracleDbType.Varchar2).Value = userName
            cmd.Parameters.Add("p_qry", OracleDbType.Varchar2).Value = qry

            ' Output Parameters
            Dim outCnt As New OracleParameter("p_rec_cnt", OracleDbType.Decimal)
            outCnt.Direction = ParameterDirection.Output
            cmd.Parameters.Add(outCnt)
            cmd.ExecuteNonQuery()

            Dim cnt As Integer = 0
            If outCnt.Value IsNot Nothing AndAlso Not Convert.IsDBNull(outCnt.Value) Then
                Dim outputVal As Oracle.ManagedDataAccess.Types.OracleDecimal = CType(outCnt.Value, Oracle.ManagedDataAccess.Types.OracleDecimal)
                cnt = Convert.ToInt32(outputVal.Value)
            End If

            Return cnt > 0
        End Using
    End Function

    Public Function GetExistingIds(conn As OracleConnection, tx As OracleTransaction, formName As String, userName As String, saveQryId As ProjectCreditsQryIds, projId As Integer, statusId As Integer, flowId As Integer) As List(Of Integer)

        Dim qry As String = " WHERE PROJ.RE_PROJ_ID = " & projId & " AND RE_PROJ_STATUS_ID = " & statusId & " AND RE_PROJ_STATUS_FLOW_ID = " & flowId

        Dim ids As New List(Of Integer)
        Dim fetchQryid As Integer

        Select Case saveQryId
            Case ProjectCreditsQryIds.RE_CRED
                fetchQryid = 3
            Case ProjectCreditsQryIds.RE_COST
                fetchQryid = 4
            Case Else
                Throw New InvalidOperationException($"GetExistingIds not supported for {saveQryId}")
        End Select

        Using cmd As New OracleCommand(RePrcrGetSpJson, conn)
            cmd.Transaction = tx
            cmd.CommandType = CommandType.StoredProcedure
            cmd.BindByName = True

            ' Input Parameters
            cmd.Parameters.Add("P_Formname", OracleDbType.Varchar2).Value = formName
            cmd.Parameters.Add("P_username", OracleDbType.Varchar2).Value = userName
            cmd.Parameters.Add("P_qry_ID", OracleDbType.Int32).Value = fetchQryid
            cmd.Parameters.Add("p_condition", OracleDbType.Varchar2).Value = qry

            ' Output Parameters
            Dim outJson As New OracleParameter("p_json_re_prcr_out", OracleDbType.Clob)
            outJson.Direction = ParameterDirection.Output
            cmd.Parameters.Add(outJson)
            cmd.ExecuteNonQuery()

            ' Processing the output
            If outJson.Value IsNot Nothing AndAlso Not Convert.IsDBNull(outJson.Value) Then
                Try
                    Dim jsonString As String

                    If TypeOf outJson.Value Is OracleClob Then
                        Dim clob As OracleClob = DirectCast(outJson.Value, OracleClob)
                        jsonString = clob.Value
                    Else
                        jsonString = outJson.Value.ToString()
                    End If

                    If Not String.IsNullOrEmpty(jsonString) Then
                        ids = JsonConvert.DeserializeObject(Of List(Of Integer))(jsonString)
                    End If
                Catch ex As Exception
                    Console.WriteLine("Error processing output: " & ex.Message)
                End Try
            End If
        End Using
        ' Return the list of ids that are in the db
        Return ids
    End Function


    Private Sub SaveSingle(conn As OracleConnection, tx As OracleTransaction, formName As String, userName As String, saveQryId As ProjectCreditsQryIds, entity As Object)
        Dim sw = Stopwatch.StartNew()
        _logger.Information("SaveSingle - SP call started | Username: {Username}", Cur_UserID)
        If entity Is Nothing Then Exit Sub

        Dim jsonIn = JsonConvert.SerializeObject(entity)

        Dim exists = RecordExists(conn, tx, formName, userName, saveQryId, entity)
        Dim spName = If(exists, RePrcrPutUpdSpJson, RePrcrPutInsSpJson)

        Using cmd As New OracleCommand(spName, conn)
            cmd.Transaction = tx
            cmd.CommandType = CommandType.StoredProcedure
            cmd.BindByName = True

            cmd.Parameters.Add("P_Formname", OracleDbType.Varchar2).Value = formName
            cmd.Parameters.Add("P_username", OracleDbType.Varchar2).Value = userName
            cmd.Parameters.Add("P_qry_ID", OracleDbType.Int32).Value = saveQryId
            cmd.Parameters.Add("p_json_re_prcr_IN", OracleDbType.Clob).Value = jsonIn

            Dim outParam As New OracleParameter("p_json_re_prcr_OUT", OracleDbType.Clob)
            outParam.Direction = ParameterDirection.Output
            cmd.Parameters.Add(outParam)
            cmd.ExecuteNonQuery()
        End Using
        _logger.Information("SaveSingle - Success | User: {User} | ElapsedMs: {ElapsedMs}ms", Cur_UserID, sw.ElapsedMilliseconds)
    End Sub

    Private Sub SaveListWithDiff(conn As OracleConnection, tx As OracleTransaction, formName As String, userName As String, saveQryId As ProjectCreditsQryIds, projId As Integer, statusId As Integer, flowId As Integer, listData As IList)
        If listData Is Nothing OrElse listData.Count = 0 Then Exit Sub

        Dim first = If(listData.Count > 0, listData(0), Nothing)
        If first Is Nothing Then Exit Sub

        ' DB IDs
        Dim dbIds = GetExistingIds(conn, tx, formName, userName, saveQryId, projId, statusId, flowId)
        ' Payload IDs
        Dim payloadIds As New HashSet(Of Integer)

        For Each item In listData
            Select Case saveQryId
                Case ProjectCreditsQryIds.RE_CRED
                    payloadIds.Add(item.RE_CRED_ID)
                Case ProjectCreditsQryIds.RE_COST
                    payloadIds.Add(item.RE_COST_ID)
            End Select
        Next

        ' Delete the invalid records
        DeleteInvalidRecords(conn, tx, saveQryId, formName, userName, dbIds.Except(payloadIds), projId, statusId, flowId)

        ' Insert / Update current rows
        For Each item In listData
            SaveSingle(conn, tx, formName, userName, saveQryId, item)
        Next
    End Sub

