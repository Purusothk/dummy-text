    Private Sub MoveToTargetFolder(strFile As String, strCanac As String, strCountry As String, intNbrOrigPages As Integer)

        Dim strOutput As String = objParams.GetParam("EXPORT_PATH")
        Dim strMailOutput As String = objParams.GetParam("EXPORT_PATH_MAIL")
        Dim strPrintOutput As String = objParams.GetParam("EXPORT_PATH_PRINT")
        Dim strDate As String = Now.ToString("yyyyMMdd")
        Dim strCsvFile As String = strFile.Replace(".pdf", "_OverviewAccounts.csv")
        Dim intNbrPages As Integer
        intNbrPages = Math.Ceiling(intNbrOrigPages / 2)

        'CANAC = 02: E-mail / 04: PAPER
        If strCanac = "02" Then

            If Not Directory.Exists(strMailOutput) Then
                Directory.CreateDirectory(strMailOutput)
            End If

            File.Copy(strOutput & strFile, strMailOutput & "\" & strFile, True)
            If File.Exists(strOutput & strCsvFile) Then
                File.Copy(strOutput & strCsvFile, strMailOutput & "\" & strCsvFile, True)
            End If

        Else

            If strCountry = "BE" Then

                If Not Directory.Exists(strPrintOutput & strDate & "\BINN\" & intNbrPages & "_SHEETS") Then
                    Directory.CreateDirectory(strPrintOutput & strDate & "\BINN\" & intNbrPages & "_SHEETS")
                End If
                File.Copy(strOutput & strFile, strPrintOutput & strDate & "\BINN\" & intNbrPages & "_SHEETS\" & strFile)

            Else

                If Not Directory.Exists(strPrintOutput & strDate & "\BUIT\" & intNbrPages & "_SHEETS") Then
                    Directory.CreateDirectory(strPrintOutput & strDate & "\BUIT\" & intNbrPages & "_SHEETS")
                End If
                File.Copy(strOutput & strFile, strPrintOutput & strDate & "\BUIT\" & intNbrPages & "_SHEETS\" & strFile)

            End If

        End If

    End Sub

    Private Function GenerateType1Pdf(drDataRow As DataRow, TemplateName As String, Language As String, DossierInfosNr As String) As String

        Try

            Dim lrLocalReport As New LocalReport
            Dim strRenderStatus As String = ""
            Dim strMailError As String = ""

            lrLocalReport.SetBasePermissionsForSandboxAppDomain(New PermissionSet(Permissions.PermissionState.Unrestricted))
            lrLocalReport.ExecuteReportInSandboxAppDomain()

            If Environment.UserName.ToUpper() = "UINTD" Then
                lrLocalReport.ReportPath = "N: \EUC\PRD\QVLI\Projects\UINTD\VSNET_Projects\QRFI\QRFI\QRFI\Templates\" & TemplateName
            ElseIf Environment.UserName.ToUpper() = "HOORNR" Then
                lrLocalReport.ReportPath = "N:\EUC\PRD\QVLI\Projects\HOORNR\VSNET_Projects\QRFI\QFRI Frank\QRFI\QRFI\Templates\" & TemplateName
            ElseIf Environment.UserName.ToUpper() = "ES156" Then
                lrLocalReport.ReportPath = "N:\EUC\PRD\QVLI\Projects\ES156\VSNET_Projects\QRFI\QRFI\Templates\" & TemplateName
            Else
                lrLocalReport.ReportPath = objParams.GetParam("TEMPLATE_PATH") & TemplateName
            End If

            Dim prmParameters(13) As ReportParameter
            prmParameters(0) = New ReportParameter("prmCpName1", drDataRow.Item("CP_NAAM1").ToString())
            prmParameters(1) = New ReportParameter("prmCpName2", drDataRow.Item("CP_NAAM2").ToString())
            prmParameters(2) = New ReportParameter("prmDossier", drDataRow.Item("DOSSIER_INFOS").ToString())
            prmParameters(3) = New ReportParameter("prmStreet", drDataRow.Item("TAX_STRAAT").ToString())
            prmParameters(4) = New ReportParameter("prmCity", drDataRow.Item("TAX_GEMEENTE").ToString())
            prmParameters(5) = New ReportParameter("prmZip", drDataRow.Item("TAX_POST").ToString())
            If Language = "NL" Then
                prmParameters(6) = New ReportParameter("prmCountry", "BELGIE")
            Else
                prmParameters(6) = New ReportParameter("prmCountry", "BELGIQUE")
            End If

            prmParameters(7) = New ReportParameter("prmVoRef", drDataRow.Item("VOREF").ToString())
            prmParameters(8) = New ReportParameter("prmName1", drDataRow.Item("TAX_NAAM1").ToString())
            prmParameters(9) = New ReportParameter("prmName2", drDataRow.Item("TAX_NAAM2").ToString())
            prmParameters(10) = New ReportParameter("prmContpb4", drDataRow.Item("CONTP_B4").ToString())
            prmParameters(11) = New ReportParameter("prmDatDem", drDataRow.Item("DATDEM").ToString())
            prmParameters(12) = New ReportParameter("prmLibartic", drDataRow.Item("LIBARTIC").ToString())
            If drDataRow.Item("CP_DABIRT").ToString() = "01/01/1999" Or drDataRow.Item("CP_DABIRT").ToString() = "31/12/9999" Or drDataRow.Item("CP_DABIRT").ToString() = "01/01/9999" Then
                prmParameters(13) = New ReportParameter("prmDabirt", "")
            Else
                prmParameters(13) = New ReportParameter("prmDabirt", " (" & drDataRow.Item("CP_DABIRT").ToString() & ")")
            End If


            lrLocalReport.SetParameters(prmParameters)

            strRenderStatus = RenderPdf(lrLocalReport, "IF_" & drDataRow.Item("DOSSIER_INFOS").ToString().Replace("/", "_") & "_" & drDataRow.Item("IDACT_CLIENT").ToString() & "_" & Language & ".pdf")

            If strRenderStatus.StartsWith("OK") Then

                strMailError = MailDocs(drDataRow.Item("DOSSIER_INFOS").ToString(), drDataRow.Item("IDACT_CLIENT").ToString(), "IF_" & drDataRow.Item("DOSSIER_INFOS").ToString().Replace("/", "_") & "_" & drDataRow.Item("IDACT_CLIENT").ToString() & "_" & Language & ".pdf")
                If strMailError <> "" Then
                    Return "NOK - GenerateType1Pdf - MailDocs"
                Else
                    'Move to the right target folder (MAIL or PRINT)
                    MoveToTargetFolder("IF_" & drDataRow.Item("DOSSIER_INFOS").ToString().Replace("/", "_") & "_" & drDataRow.Item("IDACT_CLIENT").ToString() & "_" & Language & ".pdf", drDataRow.Item("CANAC").ToString(), drDataRow.Item("COCOUNTRY").ToString(), 1)
                    Return "OK - GenerateType1Pdf"
                End If

            Else
                Return strRenderStatus
            End If

        Catch ex As Exception
            Return "NOK - GenerateType1Pdf - " & ex.Message
        End Try

    End Function

