        clearSpecificFieldErrors('#' + nameManualId);
        clearSpecificFieldErrors('#' + qualitySelectId);

        // Fix: If Actor Id is cleared, hide all name and quality fields
        if (!actorId || actorId.trim() === '') {
            $('#' + nameReadonlyId).closest('div').hide();
            $('#' + nameManualId).closest('div').hide();
            $('#' + qualityInputId).closest('div').hide();
