// Display validation error within admin-card-body structure
function displayValidationError(fieldId, message) {
    var $field = $('#' + fieldId);
    if ($field.length === 0) {
        console.warn('Field not found for validation error: ', fieldId);
        return;
    }

    var $formGroup = $field.closest('.form-group');
    var $cardBody = $field.closest('.admin-card-body');

    // removing existing error for this field
    $cardBody.find('.validation-error[data-field="' + fieldId + '"]').remove();
    $formGroup.removeClass('has-error');
    $filed.removeClass('has-error');

    // create and add error message 
    var $errorDiv = $('<div class="validation-error text-danger small" data-field="' + fieldId + '" style="margin-top: 5px; padding-left: 15px;">' +
        'span class="glyphicon glyphicon-exclamation-sign" style="margin-right: 5px;"></span>' +
        message + '</div>');

    // Insert error message after the grom group
    $formGroup.after($errorDiv);

    // Add error styling to the field border
    $field.css({
        'border-color': '#a94442',
        'box-shadow': 'inset 0 1px rgba(0,0,0,.075), 0 0 6px #ce8483'
    });


}

// clear all validation erros from card dom structure 
function clearValidtionErrors() {
    // remove all validation error messages
    $('.admin-card-body .validation-error').remove();
    // remove error styling from form groups
    $('.admin-card-body .form-group').removeClass('.has-error');

    //remove error styling from form fields
    $('.admin-card-body input, .admin-card-body select').removeClass('has-error').css({
        'border-color': '',
        'box-shadow': ''
    });

}

function navigateToNextTab() {
    var tabOrder = getTabOrder();

    // find current active tab
    var currentTabId = getCurrentActiveTab();
    var currentIndex = tabOrder.indexOf(currentTabId);

    // find next tab    
    var nextIndex = (currentIndex + 1);
    var nextTabId = tabOrder[nextIndex]

    if (!nextTabId) return;
    //switch to next tab
    loadTabContent(nextTabId);

}

