Imports Microsoft.Reporting.WebForms
Imports System.IO

Public Class ReportController
    Inherits Controller

    Public Function GenerateReport() As ActionResult
        ' Load the RDLC report  
        Dim reportPath As String = Server.MapPath("~/Reports/Report1.rdlc")
        Dim localReport As New LocalReport()
        localReport.ReportPath = reportPath

        ' Create a list of data for the report  
        Dim reportData As New List(Of ReportData)()
        reportData.Add(New ReportData With {.ID = 1, .Name = "Item 1", .Description = "Description 1"})
        reportData.Add(New ReportData With {.ID = 2, .Name = "Item 2", .Description = "Description 2"})

        ' Add the data source to the report  
        Dim reportDataSource As New ReportDataSource("DataSet1", reportData)
        localReport.DataSources.Add(reportDataSource)

        ' Render the report  
        Dim reportType As String = "PDF" ' or "Excel", "Word", etc.  
        Dim mimeType As String
        Dim encoding As String
        Dim fileNameExtension As String
        Dim deviceInfo As String = "<DeviceInfo><OutputFormat>PDF</OutputFormat></DeviceInfo>"
        Dim streams As String() = Nothing
        Dim renderedBytes As Byte()

        renderedBytes = localReport.Render(reportType, deviceInfo, mimeType, encoding, fileNameExtension, streams, Nothing)

        ' Return the report as a file  
        Return File(renderedBytes, mimeType, "Report.pdf")
    End Function
End Class
