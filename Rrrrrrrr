// Global change tracker (entry-level, not field-level)
var actorChangeTracker = {
    mainDebtorChanged: false,
    mainDebtorOperation: null, // 'UPDATE' or null
    sponsorChanged: false,
    sponsorOperation: null, // 'Insert/Update/Delete/null
    sponsorWasInitiallySelected: false, // track if sponsor was selected when page load
    otherActorsChanged: {}, // key: actorTypeId, value: {isChanged: boolean, operation: 'INSERT/UPDATE/DELETE/null, wasInitiallySelected: boolean'}
    originalData: {}
}

function initializeChangeDetection() {
    // Store original values for tracked fields only
    storeOriginalActorData();

    // Attach change tracking to tracked fields only
    attachChangeTracking();

    // Mark data as clean after initilization (no changes yet)
    markDataAsClean();
}

function storeOriginalActorData() {
    var sponsorSelectionValue = $('#sponsorSelection').val();
    var originalSponsorActorId = $('#sponsorActorId').val() || '';
    var sponsorWasInitiallySelected = (isTcodYes(sponsorSelectionValue) || isDbYes(sponsorSelectionValue)) && originalSponsorActorId.trim() !== '';
    actorChangeTracker.originalData = {
        mainDebtor: {
            belfiusClient: $('#mainDebtorBelfiusClient').val(),
            hasSponsor: sponsorSelectionValue
        },
        sponsor: {
            wasInitiallySelected: sponsorWasInitiallySelected,
            belfiusClient: $('#sponsorBelfiusClient').val(),
            sponsorActorId: $('#sponsorActorId').val(),
            sponsorActorName: $('#sponsorActorName').val(),
            sponsorFinancialCapacity: $('#sponsorFinancialCapacity').val(),
            sponsorExperienceKnowHow: $('#sponsorExperienceKnowHow').val()
        },
        otherActors: {}
    };
    // Initilize the main debtor tracking
    actorChangeTracker.mainDebtorOperation = null;
    actorChangeTracker.mainDebtorChanged = false;

    // Initilize sponstor tracking
    actorChangeTracker.sponsorWasInitiallySelected = sponsorWasInitiallySelected;
    actorChangeTracker.sponsorOperation = null;
    actorChangeTracker.sponsorChanged = false;


    // Store other actors original data
    $('.other-actor-select').each(function () {
        var fieldId = $(this).attr('id'); // eg: actor1
        var actorTypeId = parseInt(fieldId.replace('actor', '')); // eg: 1
        if (!isNaN(actorTypeId)) {
            var field1Id = fieldId + 'Field1'; // eg: actor1Field1
            var actorId = $('#' + field1Id).val() || '';
            var nameManualId = fieldId + 'Field2Manual'; // eg: actor1Field2Manual
            var qualityId = fieldId + 'Quality';  // eg: actor1Quality
            var isValidHiddenId = fieldId + 'IsValidActorId'; // eg: actor1IsValidActorId

            
            var isSelectedValue = $(this).val();
            if (isSelectedValue === null || isSelectedValue === undefined) {
                isSelectedValue = '';
            }
            // INSERT vs Update discriminator: did a row exists at load?
            var hadRowInitially = isSelectedValue !== ''; // 1- true, 0- true, ''- false

            var wasInitiallySelected = isTcodYes(isSelectedValue) // 1-true, 0- false, ''- false

            // Manual-entry rows (hyphen or invlaid actor) need their typed name/quality
            // captured as baseline so subsequent edits flag datachanged.
            var isValidHiddenValue = $('#' + isValidHiddenId).val('') || '';
            var initialManualEntry = (actorId === '-') || (isValidHiddenValue === '0');


            actorChangeTracker.originalData.otherActors[actorTypeId] = {
                isSelected: isSelectedValue,
                hadRowInitially: hadRowInitially, // track if a row existed on page load.
                wasInitiallySelected: wasInitiallySelected, // Track if answer was Yes on page load.
                actorId: actorId,
                IsValidActorId: isValidHiddenValue,
                actorName: initialManualEntry ? ($('#' + nameManualId).val() || '') : '',
                quality: initialManualEntry ? ($('#' + qualityId).val() || '') : ''
            };

            // Initialize change tracking for this actor
            actorChangeTracker.otherActorsChanged[actorTypeId] = {
                isChanged: false,
                operation: null, // will determined when changes are detected
                hadRowInitially: hadRowInitially,
                wasInitiallySelected: wasInitiallySelected
            };

        }
    });

    //console.log("Store original Actor data after load the page: ", actorChangeTracker);
}

// Function to attach change tracking to tracked fields only
function attachChangeTracking() {
    // Main debtor: track only belfiusclient and hasponsor
    $(document).off('change', '#mainDebtorBelfiusClient').on('change', '#mainDebtorBelfiusClient', function () {
        var value = $(this).val();

        clearSpecificFieldErrors(this);
        
        // Handle UI behaviour (show/hide private wealth profile)
        handleMainDebtorBelfiusClienChange(value);
        // Track changes for save optimization
        checkMainDebtorChanges();
    });

    $(document).off('change', '#sponsorSelection').on('change', '#sponsorSelection', function () {
        var value = $(this).val();
        // Handle UI behaviour (show/hide sponsor card)
        handleSponsorSelectionChanges(value);
        // Track changes for save optimization
        checkMainDebtorChanges();
    });

    // Sponsor: track only belfiusclient, actorid, financialexposor, experianceknowhow, sponsorquality
    $(document).off('change', '#sponsorBelfiusClient').on('change', '#sponsorBelfiusClient', function () {
        var value = $(this).val();
        clearSpecificFieldErrors(this);

        // Handle UI behaviour (set N/A values, enable/disable fields)
        handleSponsorBelfiusClientChange(value);
        // Track changes for save optimization
        checkSponsorChanges();
    });

    $(document).off('change', '#sponsorFinancialCapacity').on('change', '#sponsorFinancialCapacity', function () {
        clearSpecificFieldErrors(this);
        checkSponsorChanges();
    });

    $(document).off('change', '#sponsorExperienceKnowHow').on('change', '#sponsorExperienceKnowHow', function () {
        clearSpecificFieldErrors(this);
        checkSponsorChanges();
    });

    $(document).off('input', '#sponsorActorName').on('input', '#sponsorActorName', function () {
         // Remove invalid state marker when user starts typing
         var $input = $(this);
         clearSpecificFieldErrors(this);
    });

    // Clear the invalid state when user starts typing
    $(document).off('input', '#sponsorActorId').on('input', '#sponsorActorId', function () {
        // Remove invalid state marker when user starts typing
        var $input = $(this);
        clearSpecificFieldErrors(this);
    });

    // Sponsor ActorID: fetch actor details when changed and track changes for operation detection
    $(document).off('change', '#sponsorActorId').on('change', '#sponsorActorId', function () {
        var actorId = $(this).val();
        var $input = $(this);

        // check if Belfius client is "No" - if so, prevent AJAX call
        var sponsorBelfiusValue = $('#sponsorBelfiusClient').val();
        var isBelfiusNo = isTcodNo(sponsorBelfiusValue) || isDbNo(sponsorBelfiusValue) || sponsorBelfiusValue === 'No' || sponsorBelfiusValue === '0';

        // Also check if actor ID is "-" or "N/A" - these should not trigger API calls. 
        var isNotApplicable = actorId === '-' || actorId === 'N/A';

        var isProgramaticChange = $input.data('programatic-change');

        // If any of these conditions are true, clear invalid state and skip AJAX call.
        if (isProgramaticChange || isBelfiusNo || isNotApplicable) {
            clearSponsorActorIdInvalidState($input);

            if (isBelfiusNo) {
                // Skipping AJAX call: Belfius client is No
            } else if (isNotApplicable) {
                // Skipping AJAX call: Actor ID is not applicable (- or NA)
            } else if (isProgramaticChange) {
                // Skipping AJAX call: programatic change (setNAVAlues)
            }

            // Track change for save optimization (ActorId change affects operation type)
            checkSponsorChanges();
            return; // Exit early, do not make AJX call
        }

        // Valid Actor Id entered - fetch details
        if (actorId && actorId.trim() !== '') {
            clearNAValues(true); // true = preserve Actor id
            fetchSponsorActorDetails(actorId);
        }
        // Track change for save optimization (ActorId change affects operation type)
        checkSponsorChanges();
    });

    // Other Actors: Track Yes/No select and ActorId (or ActorName+Quality if ActorId="-")
    // Preserve UI behaviour handler while adding change tracker
    $(document).off('change', '.other-actor-select').on('change', '.other-actor-select', function () {
        var fieldId = $(this).attr('id'); // eg: actor1
        var value = $(this).val();
        clearSpecificFieldErrors(this);
        // Handle UI behavior (show/hide details)
        handleOtherActorChanges(fieldId, value);
        var actorTypeId = parseInt(fieldId.replace('actor', '')); // eg: 1
        if (!isNaN(actorTypeId)) {
            checkOtherActorChanges(actorTypeId);
        }
    });

    // Clear invalid state when user starts typing
    $(document).off('input', '.other-actor-details input[id$="Field1"]').on('input', '.other-actor-details input[id$="Field1"]', function () {
        var $input = $(this);
        // Remove invalid state marker when user starts typing
