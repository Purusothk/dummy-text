    Public Sub SplitPdf(ByVal strSourceFile As String, ByVal strDestinationFile1 As String, ByVal strDestinationFile2 As String, ByVal intPageNumber As Integer)
        Try



            Dim prReader As New PdfReader(strSourceFile)
            Dim intTotalPageNumbers As Integer
            intTotalPageNumbers = prReader.NumberOfPages



            If intPageNumber < 2 Or intPageNumber > intTotalPageNumbers Then
                Throw New DocumentException("You can't split the document at page " & intPageNumber & ". There is no such page.")
            End If



            Dim document1 As New Document(prReader.GetPageSizeWithRotation(1))
            Dim document2 As New Document(prReader.GetPageSizeWithRotation(intPageNumber))



            Dim writer1 As PdfWriter
            writer1 = PdfWriter.GetInstance(document1, New FileStream(strDestinationFile1, FileMode.Create))



            Dim writer2 As PdfWriter
            writer2 = PdfWriter.GetInstance(document2, New FileStream(strDestinationFile2, FileMode.Create))



            document1.Open()
            Dim cb1 As PdfContentByte = writer1.DirectContent()
            document2.Open()
            Dim cb2 As PdfContentByte = writer2.DirectContent()



            Dim page As PdfImportedPage



            Dim intRotation As Integer
            Dim i As Integer



            intRotation = 0



            While i < intPageNumber - 1
                i += 1
                document1.SetPageSize(prReader.GetPageSizeWithRotation(i))
                document1.NewPage()
                page = writer1.GetImportedPage(prReader, i)
                intRotation = prReader.GetPageRotation(i)
                If intRotation = 90 Or intRotation = 270 Then
                    cb1.AddTemplate(page, 0, -1.0F, 1.0F, 0, 0, prReader.GetPageSizeWithRotation(i).Height())
                Else
                    cb1.AddTemplate(page, 1.0F, 0, 0, 1.0F, 0, 0)
                End If
            End While



            While i < intTotalPageNumbers
                i += 1
                document2.SetPageSize(prReader.GetPageSizeWithRotation(i))
                document2.NewPage()
                page = writer2.GetImportedPage(prReader, i)
                intRotation = prReader.GetPageRotation(i)
                If intRotation = 90 Or intRotation = 270 Then
                    cb2.AddTemplate(page, 0, -1.0F, 1.0F, 0, 0, prReader.GetPageSizeWithRotation(i).Height())
                Else
                    cb2.AddTemplate(page, 1.0F, 0, 0, 1.0F, 0, 0)
                End If
            End While
            document1.Close()
            document2.Close()



        Catch ex As Exception
            Throw ex
        End Try
    End Sub



    Public Sub MergeFiles(strPath As String, strDate As String)



        Dim strFiles() As String



        For Each strDir As String In Directory.GetDirectories(strPath)
            strFiles = Directory.GetFiles(strDir)
            MergePdf(strDir & "_" & strDate & ".pdf", strFiles, True)
        Next



    End Sub



    Public Sub MergePdf(ByVal strDestination As String, ByVal strSourceFiles() As String, blnEndOnEven As Boolean)



        Try



            Dim f As Integer = 0
            Dim reader As PdfReader = New PdfReader(strSourceFiles(f))
            Dim n As Integer = reader.NumberOfPages
            Dim document As New Document(reader.GetPageSizeWithRotation(1))
            Dim writer As PdfWriter = PdfWriter.GetInstance(document, New FileStream(strDestination, FileMode.Create))



            document.Open()



            Dim cb As PdfContentByte = writer.DirectContent
            Dim page As PdfImportedPage
            Dim rotation As Integer



            While f < strSourceFiles.Length



                Dim i As Integer = 0



                While i < n
                    i += 1
                    document.SetPageSize(reader.GetPageSizeWithRotation(i))
                    document.NewPage()
                    page = writer.GetImportedPage(reader, i)
                    rotation = reader.GetPageRotation(i)
                    If rotation = 90 Or rotation = 270 Then
                        cb.AddTemplate(page, 0, -1.0F, 1.0F, 0, 0, reader.GetPageSizeWithRotation(i).Height())
                    Else
                        cb.AddTemplate(page, 1.0F, 0, 0, 1.0F, 0, 0)
                    End If
                End While



                If blnEndOnEven Then
                    If i Mod 2 > 0 Then
                        document.NewPage()
                        Dim chunk As New iTextSharp.text.Chunk
                        document.Add(chunk)
                    End If
                End If



                f += 1



                If f < strSourceFiles.Length Then
                    reader = New PdfReader(strSourceFiles(f))
                    n = reader.NumberOfPages
                End If



            End While



            document.Close()



        Catch ex As Exception
            Throw ex
        End Try



    End Sub



