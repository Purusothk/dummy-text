Public Interface IAdminTabRepository
    Function GetAdminDataAsync(projectId As Integer, Optional projectStatusId As Integer? = Nothing, Optional projectFlowId As Integer? = Nothing) As Task(Of AdminTabViewModel)
    Function SaveAdminDataAsync(adminData As AdminTabViewModel) As Task(Of Boolean)

    Function GetProjectDetailsAsync(projectId As Integer) As Task(Of List(Of AdminTabViewModel))

End Interface
Public Class AdminTabRepository
    Inherits BaseTabRepository
    Implements IAdminTabRepository

    Private ReadOnly _currentLoginUser As String

    Private ReadOnly Property Current_LoginUser As String
        Get
            Return _currentLoginUser
        End Get
    End Property

    Public Sub New()
        MyBase.New(OracleDbContext.GetInstance(), Log.ForContext(Of AdminTabRepository)())

        If HttpContext.Current IsNot Nothing AndAlso
           HttpContext.Current.User IsNot Nothing AndAlso
           HttpContext.Current.User.Identity IsNot Nothing AndAlso
           Not String.IsNullOrWhiteSpace(HttpContext.Current.User.Identity.Name) Then
            _currentLoginUser = HttpContext.Current.User.Identity.Name.ToUpper().Replace("BELWIRED\", "")
        Else
            _currentLoginUser = "Anonymous"
        End If
    End Sub
    Public Async Function GetAdminDataAsync(projectId As Integer, Optional projectStatusId As Integer? = Nothing, Optional projectFlowId As Integer? = Nothing) As Task(Of AdminTabViewModel) Implements IAdminTabRepository.GetAdminDataAsync
        Dim sw = Stopwatch.StartNew()
        Dim adminData As New AdminTabViewModel()
        Dim loginUser As String = Current_LoginUser

        _logger.Information("GetAdminDataAsync - Started | User:{User} | ProjectId: {ProjectId} | StatusId: {StatusId} | FlowId: {FlowId}", loginUser, projectId, projectStatusId, projectFlowId)
        Try
            adminData = Await Task.Run(Function()
                                           Using connection As OracleConnection = _dbContext.CreateConnection()
                                               connection.Open()

                                               ' Build condition string with optional parameters
                                               Dim condition As String = $"Where RE_PROJ_ID = {projectId}"

                                               If projectStatusId.HasValue Then
                                                   condition += $" AND RE_PROJ_STATUS_ID = {projectStatusId.Value}"
                                               End If

                                               If projectFlowId.HasValue Then
                                                   condition += $" AND RE_PROJ_STATUS_FLOW_ID = {projectFlowId.Value}"
                                               End If

                                               _logger.Information("GetAdminDataAsync - Calling SP: {SpName} | User:{User} | Params: QID={Qid}, ProjectId={ProjectId}, StatusId={StatusId}, FlowId={FlowId} | Condition: {Condition}",
                                                       ReProjGetSpJson, loginUser, QueryIdOne, projectId, projectStatusId, projectFlowId, condition)
                                               Dim json As String = ExecuteJsonStoredProcedure(
                                                   connection,
                                                   $"{ReProjGetSpJson}",
                                                   "Frm_Analysis_AdminTab",
                                                   $"{loginUser}",
                                                   $"{QueryIdOne}",
                                                   condition,
                                                   $"{ReProjSpOutParam}"
                                               )

                                               If String.IsNullOrWhiteSpace(json) Then
                                                   _logger.Warning("GetAdminDataAsync - SP returned empty JSON | User:{User} | ProjectId: {ProjectId} | StatusId: {StatusId} | FlowId: {FlowId}",
                                                           loginUser, projectId, projectStatusId, projectFlowId)
                                                   Throw New Exception("Stored Procedure QRER.PKG_SCREEN_TASKLIST.SP_Get_RE_PROJ_JSON retured empy JSON")
                                               End If

                                               ' Remove the square brackets
                                               If json.StartsWith("[") AndAlso json.EndsWith("]") Then
                                                   json = json.Substring(1, json.Length - 2)
                                               End If
                                               Dim result = MapAdminFromJson(json)
                                               result.IsSuccess = True
                                               Return result
                                           End Using
                                       End Function)

            sw.Stop()
            _logger.Information("GetAdminDataAsync - Completed | User:{User} | ProjectId: {ProjectId} | StatusId: {StatusId} | FlowId: {FlowId} | ElapsedMs: {ElapsedMs}ms",
                                loginUser, projectId, projectStatusId, projectFlowId, sw.ElapsedMilliseconds)
        Catch ex As Exception
            sw.Stop()
            _logger.Error(ex, "GetAdminDataAsync - Failed | User:{User} | ProjectId: {ProjectId} | StatusId: {StatusId} | FlowId: {FlowId} | ElapsedMs: {ElapsedMs}ms",
                          loginUser, projectId, projectStatusId, projectFlowId, sw.ElapsedMilliseconds)
            adminData = New AdminTabViewModel()
            adminData.IsSuccess = False
            adminData.Message = "Error loading admin data: " & ex.Message
        End Try
        Return adminData
    End Function

    Public Async Function SaveAdminDataAsync(adminData As AdminTabViewModel) As Task(Of Boolean) Implements IAdminTabRepository.SaveAdminDataAsync
        Dim sw = Stopwatch.StartNew()
        Dim loginUser As String = Current_LoginUser

        _logger.Information("SaveAdminDataAsync - Started | User:{User} | ProjectId: {ProjectId} | StatusId: {StatusId} | FlowId: {FlowId}",
                            loginUser, adminData.ProjectId, adminData.ProjectStatusId, adminData.ProjectStatusFlowId)
        Try
            Dim result = Await Task.Run(Function()
                                            Using connection = _dbContext.CreateConnection()
                                                connection.Open()

                                                ' create minimal DTO with only editable fiedls
                                                Dim updateDto As New AdminUpdateDto(adminData.ProjectId, adminData.ProjectStatusId, adminData.ProjectStatusFlowId, adminData.ProjectReferenceType, adminData.FileReferenceValue, adminData.LastUser, adminData.ProjectName)
                                                updateDto.CommercialReProjId = adminData.CommercialReProjId
                                                updateDto.ReTypeId = adminData.ReTypeId
                                                updateDto.GoalId = adminData.GoalId

                                                ' convert DTO to json array formt [{}] insted of object format {}
                                                Dim jsonArray As New List(Of AdminUpdateDto)()
                                                jsonArray.Add(updateDto)
                                                _logger.Debug("SaveAdminDataAsync - Serializing AdminData into JSON | User:{User} | ProjectId: {ProjectId}", loginUser, adminData.ProjectId)
                                                Dim jsonUpdateQuery As String = JsonConvert.SerializeObject(jsonArray)

                                                _logger.Information("SaveAdminDataAsync - Calling SP: {SpName} | User:{User} | ProjectId: {ProjectId} | StatusId: {StatusId} | FlowId: {FlowId}",
                                                                    ReProjPutSpJson, loginUser, adminData.ProjectId, adminData.ProjectStatusId, adminData.ProjectStatusFlowId)
                                                ' call stored procedure for updte
                                                Dim success As Boolean = ExecuteUpdateStoredProcedure(
                                                    connection,
                                                    $"{ReProjPutSpJson}",
                                                    "Frm_Analysis_AdminTab",
                                                    $"{loginUser}",
                                                    $"{QueryIdTwo}",
                                                    Nothing,
                                                    jsonUpdateQuery,
                                                    $"{ReProjSpOutParam}"
                                                )
                                                Return success
                                            End Using
                                        End Function)

            sw.Stop()
            If result Then
                _logger.Information("SaveAdminDataAsync - Completed successfully | User:{User} | ProjectId: {ProjectId} | StatusId: {StatusId} | FlowId: {FlowId} | ElapsedMs: {ElapsedMs}ms",
                                    loginUser, adminData.ProjectId, adminData.ProjectStatusId, adminData.ProjectStatusFlowId, sw.ElapsedMilliseconds)
            Else
                _logger.Warning("SaveAdminDataAsync - SP returned failure | User:{User} | ProjectId: {ProjectId} | StatusId: {StatusId} | FlowId: {FlowId} | ElapsedMs: {ElapsedMs}ms",
                                loginUser, adminData.ProjectId, adminData.ProjectStatusId, adminData.ProjectStatusFlowId, sw.ElapsedMilliseconds)
            End If
            Return result
        Catch ex As Exception
            sw.Stop()
            _logger.Error(ex, "SaveAdminDataAsync - Failed | User:{User} | ProjectId: {ProjectId} | StatusId: {StatusId} | FlowId: {FlowId} | ElapsedMs: {ElapsedMs}ms",
                          loginUser, adminData.ProjectId, adminData.ProjectStatusId, adminData.ProjectStatusFlowId, sw.ElapsedMilliseconds)
            Return False
        End Try
    End Function

    Public Async Function GetProjectDetailsAsync(projectId As Integer) As Task(Of List(Of AdminTabViewModel)) Implements IAdminTabRepository.GetProjectDetailsAsync
        Dim sw = Stopwatch.StartNew()
        Dim projectHistory As New List(Of AdminTabViewModel)()
        Dim loginUser As String = Current_LoginUser

        _logger.Information("GetProjectDetailsAsync - Started | User:{User} | ProjectId: {ProjectId}", loginUser, projectId)
        Try
            projectHistory = Await Task.Run(Function()
                                                Using connection = _dbContext.CreateConnection()
                                                    connection.Open()

                                                    ' Build condition string with optional parameters
                                                    Dim condition As String = $"Where RE_PROJ_ID = {projectId}"

                                                    Dim json As String = ExecuteJsonStoredProcedure(
                                                        connection,
                                                        $"{ReProjGetSpJson}",
                                                        "Frm_Analysis_AdminTab",
                                                        $"{loginUser}",
                                                        $"{QueryIdOne}",
                                                        condition,
                                                        $"{ReProjSpOutParam}"
                                                    )

                                                    Dim result As New List(Of AdminTabViewModel)()
                                                    If Not String.IsNullOrWhiteSpace(json) Then
                                                        result = ParseProjectHistoryFromJson(json)
                                                    Else
                                                        _logger.Warning("GetProjectDetailsAsync - SP returned empty JSON | User:{User} | ProjectId: {ProjectId}", loginUser, projectId)
                                                    End If
                                                    Return result
                                                End Using
                                            End Function)

            sw.Stop()
            _logger.Information("GetProjectDetailsAsync - Completed | User:{User} | ProjectId: {ProjectId} | RecordCount: {Count} | ElapsedMs: {ElapsedMs}ms",
                                loginUser, projectId, projectHistory.Count, sw.ElapsedMilliseconds)
        Catch ex As Exception
            sw.Stop()
            _logger.Error(ex, "GetProjectDetailsAsync - Failed | User:{User} | ProjectId: {ProjectId} | ElapsedMs: {ElapsedMs}ms",
                          loginUser, projectId, sw.ElapsedMilliseconds)
            projectHistory = New List(Of AdminTabViewModel)()
        End Try
        Return projectHistory
    End Function


    Private Function ParseProjectHistoryFromJson(json As String) As List(Of AdminTabViewModel)
        Dim projectHistory As New List(Of AdminTabViewModel)()
        _logger.Debug("ParseProjectHistoryFromJson - Started deserializing project history data")
        Try
            Dim array As JArray = JArray.Parse(json)

            If array IsNot Nothing Then
                For Each item As JObject In array
                    Dim model As AdminTabViewModel = JsonConvert.DeserializeObject(Of AdminTabViewModel)(item.ToString())
                    model.IsSuccess = True
                    model.Message = ""
                    projectHistory.Add(model)
                Next
                _logger.Debug("ParseProjectHistoryFromJson - Deserialized {Count} records", projectHistory.Count)
                Return projectHistory
            End If
            Return New List(Of AdminTabViewModel)()
        Catch ex As Exception
            _logger.Error(ex, "ParseProjectHistoryFromJson - Failed to deserialize project history data")
            ' Return empty list with error load
            Return New List(Of AdminTabViewModel)()
        End Try
    End Function

    Private Function MapAdminFromJson(json As String) As AdminTabViewModel
        ' Use Jsonconvert directly for auto-mapping
        Try
            Dim model As AdminTabViewModel = JsonConvert.DeserializeObject(Of AdminTabViewModel)(json)
            _logger.Debug("MapAdminFromJson - Successfully deserialized JSON to AdminTabViewModel")
            ' set non Json properties
            model.IsSuccess = True
            model.Message = ""
            Return model
        Catch ex As Exception
            _logger.Error(ex, "MapAdminFromJson - JSON deserialization failed")
            ' Return Empy model with error message
            Dim model As New AdminTabViewModel()
            model.IsSuccess = False
            model.Message = "Error auto-mapping JSON: " & ex.Message
            Return model
        End Try

    End Function
End Class


Imports Serilog
Imports System.Diagnostics
Imports System.Threading.Tasks

Public Interface IAdminTabService
    Function GetAdminDataAsync(projectId As Integer, Optional projectStatusId As Integer? = Nothing,
                               Optional projectFlowId As Integer? = Nothing) As Task(Of AdminTabViewModel)
    Function SaveAdminDataAsync(adminData As AdminTabViewModel) As Task(Of AdminTabViewModel)
    Function GetProjectHistoryAsync(projectId As Integer) As Task(Of List(Of AdminTabViewModel))

End Interface

Public Class AdminTabService
    Implements IAdminTabService

    Private ReadOnly _adminTabRepository As IAdminTabRepository
    Private ReadOnly _logger As ILogger

    Public Sub New(adminTabRepository As IAdminTabRepository)
        _adminTabRepository = adminTabRepository
        _logger = Log.ForContext(Of AdminTabService)()
    End Sub
    Public Async Function GetAdminDataAsync(projectId As Integer, Optional projectStatusId As Integer? = Nothing,
                                            Optional projectFlowId As Integer? = Nothing) As Task(Of AdminTabViewModel) Implements IAdminTabService.GetAdminDataAsync
        Dim sw = Stopwatch.StartNew()
        _logger.Information("GetAdminDataAsync - Started | ProjectId: {ProjectId} | StatusId: {StatusId} | FlowId: {FlowId}",
                            projectId, projectStatusId, projectFlowId)
        Dim adminData As AdminTabViewModel
        Try
            ' validate project id
            If projectId <= 0 Then
                adminData = New AdminTabViewModel()
                adminData.IsSuccess = False
                adminData.Message = "Project ID must be greater than 0"
                _logger.Warning("GetAdminDataAsync - Invalid ProjectId: {ProjectId}", projectId)
                Return adminData
            End If


            'Get data from repository
            adminData = Await _adminTabRepository.GetAdminDataAsync(projectId, projectStatusId, projectFlowId)

            If adminData.IsSuccess Then
                adminData.LastUser = adminData.UserCreator
                adminData.LastUpdateDate = adminData.StatusDate

            End If

            _logger.Information("GetAdminDataAsync - Calling GetProjectHistoryAsync | ProjectId: {ProjectId}", projectId)
            ' Get original creator information from project hihstory 
            Dim projectHistory = Await GetProjectHistoryAsync(projectId)
            If projectHistory.Count > 1 Then
                _logger.Debug("GetAdminDataAsync - Project has multiple records | ProjectId: {ProjectId} | Count: {Count}", projectId, projectHistory.Count)
                ' Multiple records: find the first record with project status = 1
                Dim originalRecord = projectHistory.FirstOrDefault(Function(p) p.ProjectStatusId = 1)
                If originalRecord IsNot Nothing Then
                    adminData.UserCreator = originalRecord.UserCreator
                    adminData.CreationDate = originalRecord.StatusDate
                End If
            ElseIf projectHistory.Count = 1 Then
                _logger.Debug("GetAdminDataAsync - Project has one record | ProjectId: {ProjectId}", projectId)
                ' Single record: use first record
                Dim originalRecord = projectHistory.First()
                If originalRecord IsNot Nothing Then
                    adminData.UserCreator = originalRecord.UserCreator
                    adminData.CreationDate = originalRecord.StatusDate
                End If
            End If

            ' load reference type options for dropdown using the helper function
            adminData.ReferenceTypeOptions = TcodTypeHelper.GetProjectReferenceTypes()
            adminData.ReferenceTypeOptions = adminData.ReferenceTypeOptions.OrderByDescending(
                Function(x) x.TcodId = adminData.ProjectReferenceType).ToList()

            adminData.ProjectStatusItems = TcodTypeHelper.GetProjectStatusTypes()

            adminData.CreProjectOptions = TcodTypeHelper.GetCommercialReProjectTypes()
            adminData.CreTypeOptions = TcodTypeHelper.GetReTypes()
            adminData.ProjectGoalOptions = TcodTypeHelper.GetProjectGoalTypes()
            adminData.DistributionAdviceOptions = TcodTypeHelper.GetDistributionAdviceTypes()

            If adminData IsNot Nothing Then
                If adminData.ProjectStatusId IsNot Nothing Then
                    adminData.ProjectStatusIdDisplyText = GetProjectStatusIdDisplayText(adminData.ProjectStatusId, adminData.ProjectStatusItems)
                End If

                If adminData.DistributionAdvice IsNot Nothing Then
                    adminData.DistributionAdviceDisplayText = GetDistributionAdvicerDispalyText(adminData.DistributionAdvice, adminData.DistributionAdviceOptions)
                End If
            End If

            sw.Stop()
            _logger.Information("GetAdminDataAsync - Completed | ProjectId: {ProjectId} | StatusId: {StatusId} | FlowId: {FlowId} | ElapsedMs: {ElapsedMs}ms",
                                projectId, projectStatusId, projectFlowId, sw.ElapsedMilliseconds)
        Catch ex As Exception
            sw.Stop()
            _logger.Error(ex, "GetAdminDataAsync - Failed | ProjectId: {ProjectId} | StatusId: {StatusId} | FlowId: {FlowId} | ElapsedMs: {ElapsedMs}ms",
                          projectId, projectStatusId, projectFlowId, sw.ElapsedMilliseconds)
            adminData = New AdminTabViewModel()
            adminData.IsSuccess = False
            adminData.Message = "Error retrieving admin data: " & ex.Message
        End Try

        Return adminData
    End Function

    Public Async Function SaveAdminDataAsync(adminData As AdminTabViewModel) As Task(Of AdminTabViewModel) Implements IAdminTabService.SaveAdminDataAsync
        Dim sw = Stopwatch.StartNew()
        _logger.Information("SaveAdminDataAsync - Started | ProjectId: {ProjectId} | StatusId: {StatusId} | FlowId: {FlowId}",
                            adminData.ProjectId, adminData.ProjectStatusId, adminData.ProjectStatusFlowId)
        Dim Current_LoginUser As String = ""
        If HttpContext.Current IsNot Nothing AndAlso
           HttpContext.Current.User IsNot Nothing AndAlso
           HttpContext.Current.User.Identity IsNot Nothing AndAlso
           Not String.IsNullOrWhiteSpace(HttpContext.Current.User.Identity.Name) Then
            Current_LoginUser = HttpContext.Current.User.Identity.Name.ToUpper().Replace("BELWIRED\", "")
        End If
        Try
            ' Update timestamp
            adminData.LastUpdateDate = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")
            adminData.LastUser = Current_LoginUser

            Dim saveResult As Boolean = Await _adminTabRepository.SaveAdminDataAsync(adminData)

            If saveResult Then
                adminData.IsSuccess = True
                adminData.Message = "Admin Data saved succesfully"
                adminData.IsDirty = False
            Else
                adminData.IsSuccess = False
                adminData.Message = "Failed to save admin data"
            End If

            sw.Stop()
            _logger.Information("SaveAdminDataAsync - Completed | ProjectId: {ProjectId} | StatusId: {StatusId} | FlowId: {FlowId} | Success: {Success} | ElapsedMs: {ElapsedMs}ms",
                                adminData.ProjectId, adminData.ProjectStatusId, adminData.ProjectStatusFlowId, saveResult, sw.ElapsedMilliseconds)
        Catch ex As Exception
            sw.Stop()
            _logger.Error(ex, "SaveAdminDataAsync - Failed | ProjectId: {ProjectId} | StatusId: {StatusId} | FlowId: {FlowId} | ElapsedMs: {ElapsedMs}ms",
                          adminData.ProjectId, adminData.ProjectStatusId, adminData.ProjectStatusFlowId, sw.ElapsedMilliseconds)
            adminData.IsSuccess = False
            adminData.Message = "Error saving admin data: " & ex.Message
        End Try

        Return adminData

    End Function

    Public Async Function GetProjectHistoryAsync(projectId As Integer) As Task(Of List(Of AdminTabViewModel)) Implements IAdminTabService.GetProjectHistoryAsync
        Dim sw = Stopwatch.StartNew()
        _logger.Information("GetProjectHistoryAsync - Started | ProjectId: {ProjectId}", projectId)
        Try
            Dim result = Await _adminTabRepository.GetProjectDetailsAsync(projectId)
            sw.Stop()
            _logger.Information("GetProjectHistoryAsync - Completed | ProjectId: {ProjectId} | RecordCount: {Count} | ElapsedMs: {ElapsedMs}ms",
                                projectId, result.Count, sw.ElapsedMilliseconds)
            Return result
        Catch ex As Exception
            sw.Stop()
            _logger.Error(ex, "GetProjectHistoryAsync - Failed | ProjectId: {ProjectId} | ElapsedMs: {ElapsedMs}ms",
                          projectId, sw.ElapsedMilliseconds)
            Return New List(Of AdminTabViewModel)()
        End Try
    End Function


    Private Function GetProjectStatusIdDisplayText(psValue As Integer?, psTypes As List(Of TcodModel)) As String
        Return TcodTypeHelper.GetDisplayText(psValue, psTypes)
    End Function

    Private Function GetDistributionAdvicerDispalyText(distributionAdvicerValue As Integer?, daOptions As List(Of TcodModel)) As String
        Return TcodTypeHelper.GetDisplayText(distributionAdvicerValue, daOptions)
    End Function


End Class



