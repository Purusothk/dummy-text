// Project status IDs (kept in sync with DB PROJECT STATUS category).
// 0 = Created, 1 = Initiated, 2 = Ready for analysis, 3 = Ready for decision.
var PROJECT_STATUS_INITIATED = 1;

// Normalise label text so it can be compared to a configured label name:
// strip the '(*)' mandatory marker, ':' and extra whitespace, lower-case it.
function normalizeLabelText(text) {
    return (text || '')
        .replace(/\(\*\)/g, '')
        .replace(/:/g, '')
        .replace(/\s+/g, ' ')
        .trim()
        .toLowerCase();
}

// The red mandatory-field guidance is shown ONLY when the logged-in user is
// the CRE expert.
function isCreExpertContext() {
    var role = (window.userRole || '').toString().trim().toUpperCase();
    return role === 'CRE EXPERT';
}

// Highlight the CRE-expert-mandatory field labels in red for the given tab.
// Only applies for the CRE expert (or Super User) while status is 'Initiated'.
function applyCreExpertMandatoryHighlight(tabId) {
    if (!isCreExpertContext()) {
        return;
    }

    var fields = CRE_EXPERT_MANDATORY_FIELDS[tabId];
    if (!fields) {
        return;
    }

    // 1) id-based matching (form-group tabs: Admin, Actors)
    if (fields.ids && fields.ids.length) {
        fields.ids.forEach(function (fieldId) {
            var $field = $('#' + fieldId);
            if (!$field.length) {
                return;
            }

            // Prefer an explicit label[for=...]; fall back to the nearest form-group label.
            var $label = $('label[for="' + fieldId + '"]');
            if (!$label.length) {
                $label = $field.closest('.form-group').find('label').first();
            }

            if ($label.length) {
                $label.addClass('cre-mandatory-label');
            }
        });
    }

    // 2) label-text matching (table tabs where label & input are separate cells)
    if (fields.labels && fields.labels.length) {
        // Pre-normalise the configured mandatory label names for comparison.
        var wanted = fields.labels.map(normalizeLabelText);

        // Scan every label inside the currently loaded tab content and colour
        // the ones whose text matches one of our mandatory names.
        $('#tabContent').find('label.control-label, label').each(function () {
            var text = normalizeLabelText($(this).text());
            if (text && wanted.indexOf(text) !== -1) {
                $(this).addClass('cre-mandatory-label');
            }
        });
    }

    // 3) data-label matching (Collateral). Visible label text is duplicated
    //    across sections, but each input's data-label is unique
    //    (e.g. "Mortgage" vs "Basel II Mortgage"). Find the input by its
    //    data-label, then colour the label in its own row/cell.
    //    Entries may be a string (data-label only) or an object
    //    { data: '<data-label>', label: '<visible label text>' } when the
    //    data-label differs from the display text or the row holds more than
    //    one label (e.g. OFI shares a row with "Registration (Current Rank)").
    if (fields.dataLabels && fields.dataLabels.length) {
        fields.dataLabels.forEach(function (entry) {
            var dataLabel = (typeof entry === 'string') ? entry : entry.data;
            var displayText = (typeof entry === 'string') ? null : entry.label;
            var wantedText = displayText ? normalizeLabelText(displayText) : null;

            $('#tabContent').find('[data-label="' + dataLabel + '"]').each(function () {
                var $input = $(this);
                var id = $input.attr('id');
                var $label = $();

                // Per-column applicability (e.g. OFI has one input per column:
                // ofi1, ofi2, ...). A field that is N.A. for a column is rendered
                // hidden / disabled / readonly (e.g. RE Collateral = No, or
                // Number of RE as Collaterals > 1). In that case it is not
                // mandatory, so skip highlighting that specific column's label.
                if (!$input.is(':visible') || $input.is(':disabled') || $input.prop('readonly')) {
                    return; // continue to next matched input (next column)
                }

                // If a display text is given, prefer the label (in the same row)
                // whose text matches it. This disambiguates multi-label rows.
                if (wantedText) {
                    $input.closest('tr').find('label, .control-label').each(function () {
                        if (!$label.length && normalizeLabelText($(this).text()) === wantedText) {
                            $label = $(this);
                        }
                    });
                }

                // Fallbacks: explicit label[for=id] -> first label in the row
                //            -> first label in the cell / form-group.
                if (!$label.length && id) {
                    $label = $('label[for="' + id + '"]');
                }
                if (!$label.length) {
                    $label = $input.closest('tr').find('label, .control-label').first();
                }
                if (!$label.length) {
