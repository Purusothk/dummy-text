        <HttpPost>
        Public Function SaveAnalysisLastTab(jsonInput As String, projectTabId As Integer?, projectStatusId As Integer?, creProjectId As Integer?) As JsonResult
            Dim sw = Stopwatch.StartNew()
            Dim userName = Current_LoginUser
            _logger.Information("SaveAnalysisLastTab - Request received | User: {User} | ProjectTabId: {TabId} | ProjectStatusId: {StatusId} | CreProjectId: {CreId}", userName, projectTabId, projectStatusId, creProjectId)
            Try
                If String.IsNullOrWhiteSpace(jsonInput) Then
                    _logger.Warning("SaveAnalysisLastTab - Empty input | User: {User}", userName)
                    Return Json(New With {.success = False, .message = "Last access tab input is empty."})
                End If
                Dim result = _analysisCommonService.SaveAnalysisLastTab(jsonInput)

                If projectTabId.HasValue Then
                    Session("ProjectTabId") = projectTabId.Value
                End If
                If projectStatusId.HasValue Then
                    Session("AnalysisProjectStatusId") = projectStatusId.Value
                End If
                If creProjectId.HasValue Then
                    Session("AnalysisCreProjectId") = creProjectId.Value
                End If
                sw.Stop()
                _logger.Information("SaveAnalysisLastTab - Success | User: {User} | ElapsedMs: {ElapsedMs}ms", userName, sw.ElapsedMilliseconds)
                Return Json(New With {.success = True, .message = result})
            Catch ex As Exception
                sw.Stop()
                _logger.Error(ex, "SaveAnalysisLastTab - Unhandled exception | User: {User} | ElapsedMs: {ElapsedMs}ms", userName, sw.ElapsedMilliseconds)
                Return Json(New With {.success = False, .message = ex.Message})
            End Try
        End Function

        <HttpGet>
        Public Function RefreshTcodData() As JsonResult
            Try
                Dim userName As String = ""
                If User IsNot Nothing AndAlso User.Identity IsNot Nothing Then
                    userName = User.Identity.Name.ToUpper().Replace("BELWIRED\", "")
                End If

                Dim allowedUsers As New List(Of String) From {ALLOWED_USER_HOOR, ALLOWED_USER_USR, ALLOWED_USER_BOSE}
                If Not allowedUsers.Contains(userName) Then
                    Return Json(New With {
                            .success = False,
                            .message = "Not authorized to access this URL"
                    }, JsonRequestBehavior.AllowGet)
                End If

                Dim refreshed As Boolean = TcodTypeHelper.RefreshCache()
                Dim count As Integer = TcodTypeHelper.GetAllTcodTypes().Count
                Return Json(New With {
                    .success = refreshed,
                    .count = count,
                    .message = If(refreshed, $"Reference data cache refreshed ({count} items loaded).", "Reference data cache refreshed failed. see server logs.")
                }, JsonRequestBehavior.AllowGet)
            Catch ex As Exception
                Console.WriteLine($"Error in RefreshReferenceData: {ex.Message}")
                Return Json(New With {.success = False, .message = ex.Message}, JsonRequestBehavior.AllowGet)
            End Try
        End Function

