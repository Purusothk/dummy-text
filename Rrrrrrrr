        }
    } else if (currentTab === 'follow-up') {
        clearInlineErrors('.followup-card');
        if (!result.isValid) {
            applyInlineErrors(result.fieldErrors)
        }
    } 
    return result.isValid;
}

function passesRequiredIfRule($el) {
    var rule = $el.data('required-if');
    if (!rule) return true;

    var parts = rule.split('=');
    if (parts.length !== 2) return true;

    var dependentField = parts[0];
    var expectedValue = parts[1];
    var index = $el.data('index');
    var dependentId = index ? '#' + dependentField + index : '#' + dependentField;

    var $dependent = $(dependentId);
    if ($dependent.length === 0) return true;

    return $dependent.val() == expectedValue;
}



