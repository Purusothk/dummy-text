        clearSpecificFieldErrors(this);
        $input.removeAttr('data-invalid-actor').removeClass('invalid-actor-id');
        // Clear inline styles that were added for invalid state.
        $input.css({
            'border-color': '',
            'border-width': '',
            'background-color': '',
            'box-shadow': ''

        });
    });

    // Track ActorId changes for other actors
    // Preserve fetch functionality while adding change tracking
    $(document).off('change', '.other-actor-details input[id$="Field1"]').on('change', '.other-actor-details input[id$="Field1"]', function () {
        var actorId = $(this).val();
        var fieldId = $(this).attr('id'); // eg: actor1Field1
