function saveDataBeforeSwitch(currentTabId, targetTabId) {

    switch (currentTabId) {
        case 'admin':
            saveAdminDataToServer(
                false,
                function () {
                    completeTabSwitch(targetTabId);
                },
                true
            );
            break;
        case 'actors':
            saveActorDataToServer(
                false,
                function () {
                    completeTabSwitch(targetTabId);
                },
                true
            );
            break;
        case 'project-credits':
            AnalysisScreen.saveProjectCreditsDataToServer(
                false,
                function () {
                    completeTabSwitch(targetTabId);
                },
                true
            );
            break;
        case 'project-asset':
            saveAssetTab(
                false,
                function () {
                    completeTabSwitch(targetTabId);
                },
                true
            );
            break;
        case 'collaterals':
            CollateralSave.save(
                false,
                function () {
                    completeTabSwitch(targetTabId);
                },
                true
            );
            $('#followupSaveBtn').click();
            setTimeout(function () {
                loadTabContent(targetTabId);
            }, 400);
            break;
        case 'guidelines':
            saveGuidelinesTab(
                false,
                function () {
                    completeTabSwitch(targetTabId);
                },
                true
            );
            break;
        case 'guidance':
            saveGuidanceTab(
                false,
                function () {
                    completeTabSwitch(targetTabId);
                },
                true
            );
            break;
        case 'breakeven':
            Save_RE_BREV(
                false,
                function () {
                    completeTabSwitch(targetTabId);
                },
                true
            );
            break;
        default:
            completeTabSwitch(targetTabId);
            break;
    }
}

// function to load tab content from server
function loadTabContent(tabId) {
    // Set active tab
    setActiveTab(tabId);

    // show loading indicator 
    $('#tabContent').html('<div class="text-center"><i class="fa fa-spinner fa-spin"></i>Loading...</div>');

    // Get parameters from viewbag (set by server from session)
    var projectId = window.projectId || null;
    var projectStatusId = window.projectStatusId || null;
    var projectFlowId = window.projectFlowId || null;

    // prepare data object
    var requestData = { tabName: tabId };

    // load content from server

    $.ajax({
        url: '/Analysis/GetTabContent',
        type: 'GET',
        data: requestData,
        success: function (response) {
            // create content container
            var contentId = 'analyze-content-' + tabId;
            // create content container
            var $content = $('<div>', {
                id: contentId,
                class: 'analyze-tab-content'
            });

            // set content
            $content.html(response)

            // Add to DOM
            $('#tabContent').html($content);

            // Highlight CRE-expert mandatory field labels in red (only when the
            // logged-in user is the CRE expert). Runs for every tab; the
            // function no-ops when the tab has no configured fields.
            applyCreExpertMandatoryHighlight(tabId);

            // Initialize tab specific functionality AFTER content is loaded
            // Good place because DOM elements must exists before initialization
            if (tabId === 'admin') {
                // form already has server data from view rendering
                // initializeAdminTabEvents() setup event handlers and form functionality.
                setTimeout(function () {
                    initializeAdminTabEvents();
                }, 100);
            } else if (tabId === 'actors') {
                // form already has server data from view rendering
                // initializeActorTabEvents() setup event handlers and form functionality.
                setTimeout(function () {
                    initializeActorTabEvents();
                }, 100);
            } else if (tabId === 'project-credits') {
                //Initialize Project Credits Tab functionality
                setTimeout(function () {
                    initializeProjectCreditsTab();
                }, 100);
            } else if (tabId === 'collaterals') {
                setTimeout(function () {
                    initializeCollateralTab();
                }, 100);
            } else if (tabId === 'follow-up') {
                settimeout(function () {
                    initializefollowuptab();
                }, 100);
            }
        },
        error: function (xhr, status, error) {
            $('#tabContent').html('<div class="alert alert-danger">Error loading tab content: ' + error + '</div>');
        }
    });

}

// function to initialize admin table functionality
function initializeAdminTabEvents() {
    //Remove any existing event handlers to prevent duplicates
    $(document).off('change', '#projectReferenceType');
    $(document).off('input blur', '#fileReferenceValue');

    // Add change event handler for project reference type drop down
    $(document).on('change', '#projectReferenceType', function () {
        clearSpecificFieldErrors(this);
        updateFileReferenceValue();
    });

    // Real-time format validation as user types
    $(document).on('input', '#fileReferenceValue', function () {
        validateFileReferenceFormat(true);
    });

    $(document).on('blur', '#fileReferenceValue', function () {
        validateFileReferenceFormat(false);
    });

    $(document).off('change', '#commercialReProjId').on('click', '#commercialReProjId', function () {
        clearSpecificFieldErrors(this);

        var val = $(this).val();

        if (val === '4') {
            if (!$(this).data('socialHousingShown')) {
                $(this).data('socialHousingShown', true);
                $('#socialHousingWarningModal').modal('show')
            }
        } else {
            $(this).removeData('socialHousingShown');
        }
    });

    $(document).off('hidden.bs.modal', '#socialHousingWarningModal').on('hidden.bs.modal', '#socialHousingWarningModal', function () {
        if ($('.modal:visible').length === 0) {
            $('body').removeClass('modal-open');
            $('.modal-backdrop').remove();
        }
    });

    $(document).off('change', '#reTypeId').on('click', '#reTypeId', function () {
        clearSpecificFieldErrors(this);
    });

    $(document).off('change', '#goalId').on('click', '#goalId', function () {
        clearSpecificFieldErrors(this);
    });

    // store the original value for restoration
    storeOriginalValues();

    // Initilize file reference field state based on current reference type
    updateFileReferenceValue()

    
    // make data as clean since it is loaded from server.
    markDataAsClean()

    // apply review changes while loading the tab
    applyReviewMode();

    //apply user role management for admin tab on loading
    applyAdminTabAccess();

    // Highlight CRE-expert mandatory field labels in red on the admin tab
    applyCreExpertMandatoryHighlight('admin');

}

