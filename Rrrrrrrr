    Private Sub btnEmailAddresses_Click(sender As Object, e As EventArgs) Handles btnEmailAddressesa.Click

        Dim strMailOutput As String
        Dim strDate As String = dtpMail.Value.ToString("yyyyMMdd")

        strMailOutput = objParams.GetParam("EXPORT_PATH_MAIL")

        If Not Directory.Exists(strMailOutput & strDate) Then
            Directory.CreateDirectory(strMailOutput & strDate)
        End If

        Dim di As New DirectoryInfo(strMailOutput)
        Dim fiArr As FileInfo() = di.GetFiles()
        Dim fri As FileInfo

        If fiArr.Count = 0 Then

            MsgBox("No files found in " & strMailOutput, vbExclamation, "Mail")

        Else

            For Each fri In fiArr

                If Path.GetExtension(fri.Name).ToLower = ".pdf" Then
                    If SendByMail(fri.Name) = "OK" Then
                        File.Move(strMailOutput & fri.Name, strMailOutput & strDate & "\" & fri.Name)
                        If File.Exists(strMailOutput & Path.GetFileNameWithoutExtension(fri.Name) & "_OverviewAccounts.csv") Then
                            File.Move(strMailOutput & Path.GetFileNameWithoutExtension(fri.Name) & "_OverviewAccounts.csv", strMailOutput & strDate & "\" & Path.GetFileNameWithoutExtension(fri.Name) & "_OverviewAccounts.csv")
                        End If
                    End If
                End If

            Next

            MsgBox("Mails sent", vbInformation)

        End If

    End Sub

    Private Function SendByMail(strFileName As String) As String

        Dim strDossNr As String
        Dim strLanguage As String
        Dim strSubject As String
        Dim strTemplate As String
        Dim strBodyText As String
        Dim strSql As String
        Dim strStatus As String
        Dim strTO As String
        Dim strCC As String
        Dim odf As New OracleDataFunctions
        Dim FilesToAttach As New List(Of String)

        strDossNr = strFileName.Split("_")(1) & "/" & strFileName.Split("_")(2) & "/" & strFileName.Split("_")(3)
        strLanguage = strFileName.Split("_")(5).Split(".")(0)

        strSql = "SELECT DOSSIER_INFOS, FAXMAIL, COPYMAIL, VOREF FROM QRFI.TAX_GEN WHERE DOSSIER_INFOS = '" & strDossNr & "'"
        ds.ImportFromOracle("MAIL", strSql)

        If ds.Tables("MAIL").Rows.Count > 0 Then

            strTO = ds.Tables("MAIL").Rows(0).Item("FAXMAIL").ToString()
            strCC = ""  'ds.Tables("MAIL").Rows(0).Item("COPYMAIL").ToString() ' Gert mail of 10/02/2025- can be removed 
            strSubject = strDossNr & " - " & ds.Tables("MAIL").Rows(0).Item("VOREF").ToString()

            strTemplate = objParams.GetParam("TEMPLATE_PATH") & "mailing.html"

            strBodyText = File.ReadAllText(strTemplate)
            strBodyText = strBodyText.Replace("%DOSSIER_INFOS%", strDossNr)
            strBodyText = strBodyText.Replace("%VOREF%", ds.Tables("MAIL").Rows(0).Item("VOREF").ToString())

            FilesToAttach.Add(objParams.GetParam("EXPORT_PATH_MAIL") & strFileName)
            If File.Exists(objParams.GetParam("EXPORT_PATH_MAIL") & Path.GetFileNameWithoutExtension(strFileName) & "_OverviewAccounts.csv") Then
                FilesToAttach.Add(objParams.GetParam("EXPORT_PATH_MAIL") & Path.GetFileNameWithoutExtension(strFileName) & "_OverviewAccounts.csv")
            End If

            If objMailing.SendMail(objParams.GetParam("FROM_MAIL"), strTO, strCC, "", strSubject, strBodyText, FilesToAttach) = "" Then
                strStatus = "OK"
                strSql = "UPDATE QRFI.TAX_GEN SET DA_SEND_MAIL = SYSDATE WHERE DOSSIER_INFOS = '" & strDossNr & "'"
                odf.ExecuteCommand(strSql)
            Else
                strStatus = "ERR"
                MsgBox("Error while sending mail", vbInformation, "Info")
            End If

            Return strStatus

        Else
            Return "ERR"
        End If

    End Function

