registerTabValidator('collaterals', function () {
    var isValid = true;
    var messages = [];
    var fieldErrors = [];

    $('[data-required="true"]').each(function () {
        var $el = $(this);

        if (!$el.is(':visible')) {
            return;
        }

        if ($el.is(':disabled')) {
            return;
        }
        //skipping tbds
        if ((window.userRole == "CRE EXPERT" || window.userRole == "Super User") && ($el.attr("data-tbd") === "true" || $el.data('tbd') === "true")) {
            return;
        }

        if (!passesRequiredIfRule($el)) {
            return;
        }

        var value = ($el.val() || '').toString().trim();

        if (value === '') {
            isValid = false;
            var label = $el.data('label') || 'This field';
            var index = $el.data('index');
            var message = index
                ? label + ' (Collateral ' + index + ') is required'
                : label + ' is required';

            messages.push(message);
            fieldErrors.push({
                selector: '#' + $el.attr('id'),
                message: message
            });
        }
    });

    return {
        isValid: isValid,
        messages: messages,
        fieldErrors: fieldErrors
    };
});

