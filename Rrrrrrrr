function hasActorTabChanges() {
    if (actorChangeTracker.mainDebtorChanged) {
        return true;
    }

    if (actorChangeTracker.sponsorChanged) {
        return true;
    }

    // check other actor change

    for (var actorTypeId in actorChangeTracker.otherActorsChanged) {
        if (actorChangeTracker.otherActorsChanged.hasOwnProperty(actorTypeId)) {
            var actorChange = actorChangeTracker.otherActorsChanged[actorTypeId];
