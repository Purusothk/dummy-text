        statusId = parseInt(sessionStorage.getItem('AnalysisProjectStatusId'));
    }
    //statusId = 9;
    if (statusId !== 9) {
        return;
    }

    var currentTabId = getCurrentActiveTab();

    if (currentTabId === 'admin') {
        
        $('#commercialReProjId').prop('disabled', true).addClass('readonly-field');
        $('#goalId').prop('disabled', true).addClass('readonly-field');
        $('#reTypeId').prop('disabled', true).addClass('readonly-field');


    } else if (currentTabId === 'actors') {
