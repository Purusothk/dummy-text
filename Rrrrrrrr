function attemptTabSwitch(targetTabId) {

    var currentTabId = getCurrentActiveTab();

    var tabOrder = getTabOrder();
    var currentIndex = tabOrder.indexOf(currentTabId);
    var targetIndex = tabOrder.indexOf(targetTabId);

    // safecheck
    if (currentIndex === -1 || targetIndex === -1) {
        return;
    }

    // allow only backward navigation
    if (targetIndex > currentIndex) {
        //var isTargetDisabled = $('.analyze-tab[data-tab="' + targetTabId + '"]').hasClass('disabled-tab');
        //if (isTargetDisabled) {
        //    return;
        //}
        return;
    }

    //if (currentTabId == 'guidelines' || currentTabId == 'guidance' || currentTabId == 'project-asset' || currentTabId == 'breakeven') {
    //    return;
    //}

    // No-op if user clicked that already active tab
    if ((targetTabId || '') === (currentTabId || '')) {
        return;
    }

    // Validate current tab before leaving it
    //var result = collectValidationErrors(currentTabId);
    //if (!result.isValid) {
    //    showErrorMessage('Validation Failed', result.messages.join('<br>'));
    //    scrollTopShowErrorMessage();
    //    return;
    //}

    // check if they are unsaved changes that need to saved before switching tabs
    var hasChanges = false;

    if (currentTabId === 'admin') {
        hasChanges = isDataDirty;
    } else if (currentTabId === 'actors') {
        hasChanges = hasActorTabChanges();
    } else if (currentTabId === 'project-credits') {
        hasChanges = AnalysisScreen.isProjectCreditsDataDirty;
    } else if (currentTabId === 'project-asset') {
        hasChanges = isDataDirty;
    } else if (currentTabId === 'collaterals') {
        hasChanges = isDataDirty;
    } else if (currentTabId === 'guidelines') {
        hasChanges = isDataDirty;
    } else if (currentTabId === 'guidance') {
        hasChanges = isDataDirty;
    } else if (currentTabId === 'breakeven') {
        hasChanges = isDataDirty;
    } else {
        // for other tabs use isDataDirty as fallback
        hasChanges = isDataDirty
    }
    if (hasChanges) {
        saveDataBeforeSwitch(currentTabId, targetTabId);
    } else {
        // No changes proceed directly to load the new tab
        completeTabSwitch(targetTabId);
    }

}

