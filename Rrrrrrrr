        $('#sponsorExperienceKnowHow').prop('disabled', true);

        // Other actors card: Yes/No selection and Actor id fields must be unchangeable
        $('.other-actor-details input[id$="Field1"]').prop('readonly', true);
        $('.other-actor-select').prop('disabled', true);
    } else {
        // nothing to do
    }
    
}

