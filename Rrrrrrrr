                Dim finalProjectId As Integer
                Dim finalProjectStatusId As Integer?
                Dim finalProjectFlowId As Integer?

                If projectId.HasValue AndAlso projectId.Value > 0 Then
                    finalProjectId = projectId.Value
                    finalProjectStatusId = projectStatusId
                    finalProjectFlowId = projectFlowId
                ElseIf Session("AnalysisProjectId") IsNot Nothing Then
                    finalProjectId = CInt(Session("AnalysisProjectId"))
                    If Session("AnalysisProjectStatusId") IsNot Nothing Then
