// ============================================================================
// File Reference Format Config
// Maps selected option TEXT (lowercase) to validation rules.
// Derived from the generate functions: generateKrokReference,
// generateMiddlReference, generateCreditReference.
// ============================================================================
var FILE_REF_FORMAT_CONFIG = [
    {
        // KROK ref: B/NNNNNNN/N  (e.g. B/0012345/7)
        match: function (text) { return text.includes('krok'); },
        regex: /^B\/\d{7}\/\d$/,
        hint: 'B/NNNNNNN/N',
        example: 'e.g. B/0012345/7',
        placeholder: 'Format: B/NNNNNNN/N'
    },
    {
        // Middl ref: MIDDL26/MM/YYOXXXXXX  (e.g. MIDDL26/02/26O001234)
        match: function (text) { return text.includes('midd'); },
        regex: /^MIDDL\d{2}\/\d{2}\/\d{2}O\d{6}$/,
        hint: 'MIDDL26/MM/YYOXXXXXX',
        example: 'e.g. MIDDL26/02/26O001234',
        placeholder: 'Format: MIDDLXX/MM/YYOXXXXXX'
    },
    {
        // Credit ref: NNN-NNNNNNN-NN  (e.g. 123-4567890-12)
        match: function (text) { return text.includes('credit'); },
        regex: /^\d{3}-\d{7}-\d{2}$/,
        hint: 'NNN-NNNNNNN-NN',
        example: 'e.g. 123-4567890-12',
        placeholder: 'Format: NNN-NNNNNNN-NN'
    }
];

/**
* Returns the format config for the currently selected reference type,
* or null if no specific format is required (e.g. "Other").
*/
function getSelectedRefFormatConfig() {
    var selectedText = $('#projectReferenceType option:selected').text().toLowerCase();
    for (var i = 0; i < FILE_REF_FORMAT_CONFIG.length; i++) {
        if (FILE_REF_FORMAT_CONFIG[i].match(selectedText)) {
            return FILE_REF_FORMAT_CONFIG[i];
        }
    }
    return null;
}



// function to update file reference value based on prject referencetype 
function updateFileReferenceValue() {
    var referenceType = $('#projectReferenceType').val();
    var originalProjectReferenceType = $('#projectReferenceType').data('original-value');
    var originalFileRefValue = $('#fileReferenceValue').data('original-value');

    var config = getSelectedRefFormatConfig();

    // Determine placeholder and tooltip from format config
    var placeholder = config ? config.placeholder + '  (' + config.example + ')' : 'Enter reference value...';
    var tooltip = config ? 'Expected format: ' + config.hint + '  ' + config.example : '';


    if (referenceType === originalProjectReferenceType) {
        $('#fileReferenceValue').val(originalFileRefValue);
        // Keep field editable if a reference type is selected
        if (referenceType && referenceType.trim() !== '') {
            $('#fileReferenceValue').attr('placeholder', placeholder);
            if (tooltip) { $('#fileReferenceValue').attr('title', tooltip); } else { $('#fileReferenceValue').removeAttr('title'); }
        } else {
            $('#fileReferenceValue').removeAttr('placeholder').removeAttr('title');
        }
        // dont mark as dirty when restore the original values
        markDataAsClean();

        return;
    }

    // For all reference types, make the field editable and clear the value
    if (referenceType && referenceType.trim() !== '') {
        $('#fileReferenceValue').val('');
        $('#fileReferenceValue').attr('placeholder', placeholder);
        if (tooltip) { $('#fileReferenceValue').attr('title', tooltip); } else { $('#fileReferenceValue').removeAttr('title'); }
        $('#fileReferenceValue-hint').text(hintText);
        // show format hint below the field.
        var hintText = config ? config.hint + ' (' + config.example + ')' : '';
    } else {
        // No Reference type selected, clear and make readonly
        $('#fileReferenceValue').val('');
        $('#fileReferenceValue').removeAttr('placeholder').removeAttr('title');

        // Clear the format hint
        $('#fileReferenceValue-hint').text('');
    }
}


/**
* Validates the current file reference value against the format for the
* selected reference type.
* @param {boolean} isRealTime - true when called on input (real-time), false on save.
* @returns {boolean} true if valid (or no format required).
*/
function validateFileReferenceFormat(isRealTime) {
    var config = getSelectedRefFormatConfig();
    if (!config) {
        // No specific format required (e.g. "Other") always valid
        clearFileReferenceFormatError();
        return true;
    }

    var value = $('#fileReferenceValue').val();
    if (!value || value.trim() === '') {
        // Empty is handled by the required check in the tab validator
        clearFileReferenceFormatError();
        return true;
    }

    if (config.regex.test(value)) {
        clearFileReferenceFormatError();
        return true;
    }

    // Invalid format show field-level error
    var msg = 'Invalid format. Expected: ' + config.hint + '  (' + config.example + ')';
    setFileReferenceFormatError(msg);
    return false;
}

function setFileReferenceFormatError(message) {
    $('#fileReferenceValue').addClass('field-invalid ref-format-invalid');
    var $err = ensureErrorContainer($('#fileReferenceValue'), 'fileReferenceValue-error');
    if ($err) { $err.text(message).show(); }
}

function clearFileReferenceFormatError() {
    $('#fileReferenceValue').removeClass('field-invalid ref-format-invalid');
    var $err = $('#fileReferenceValue-error');
    if ($err.length) { $err.text('').hide(); }
}



// function to generate credit reference 
function generateCreditReference() {

    var prefix = Math.floor(Math.random() * 1000).toString().padStart(3, '0');
    var middle = Math.floor(Math.random() * 10000000).toString().padStart(7, '0');
    var suffix = Math.floor(Math.random() * 100).toString().padStart(2, '0');

    return prefix + '-' + middle + '-' + suffix;
}
// function to generateMiddReference
function generateMiddReference() {
    // Get current month(2 digit)
    var currentMonth = (new Date().getMonth() + 1).toString().padStart(2, '0');

    // Get current year (two digits)
    var currentYear = new Date().getFullYear().toString().substr(-2);
    // generate random 6-digit number
    var randomNumber = Math.floor(Math.random() * 1000000).toString().padStart(6, '0');

    return 'MIDDL26/' + currentMonth + '/' + currentYear + 'O' + randomNumber;
}


// function to  generateKrokReference
function generateKrokReference() {
    // Generate random 7-digit number
    var randomNumber = Math.floor(Math.random() * 10000000).toString().padStart(7, '0');
    // Generate random single digit
    var randomDigit = Math.floor(Math.random() * 10);

    return 'B/' + randomNumber + '/' + randomDigit;
}

// Function to save admin data to server

function saveAdminDataToServer(saveAndClose, callback, isTabSwitch) {

    isTabSwitch = isTabSwitch || false;

    var adminData = {
        ProjectId: parseInt($('#projectId').val()) || 0,
        ProjectReferenceType: $('#projectReferenceType').val() || '',
        FileReferenceValue: $('#fileReferenceValue').val() || '',
        ProjectStatusFlowId: $('#projectStatusFlowId').val() || '',
        ProjectStatusId: $('#projectStatusId').val() || '',
        ProjectName: $('#projectName').val() || '',
        commercialReProjId: $('#commercialReProjId').val() || null,
        reTypeId: $('#reTypeId').val() || null,
        goalId: $('#goalId').val() || null,
    };

    //console.log("Admin Data: ", adminData);


    $.ajax({
        url: '/Analysis/SaveAdminData',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(adminData),
        success: function (response) {
            if (response.success) {
                showSuccessMessage('Data saved successfully');
                markDataAsClean();

                $('#projectReferenceType').data('original-value', adminData.ProjectReferenceType);
                $('#fileReferenceValue').data('original-value', adminData.FileReferenceValue);
                $('#projectName').data('original-value', adminData.ProjectName);

                $('#commercialReProjId').data('original-value', adminData.CommercialReProjId);
                $('#reTypeId').data('original-value', adminData.ReTypeId);
                $('#goalId').data('original-value', adminData.GoalId);

                var projectStatusId = $('#projectStatusId').val() || '';

                var creProjectId = $('#commercialReProjId').val() || '';
                var creGoalId = $('#goalId').val() || '';

                window.creProjectId = parseInt($('#commercialReProjId').val()) || 0;
                sessionStorage.setItem('AnalysisCreProjectId', creProjectId);
                sessionStorage.setItem('AnalysisGoalId', creGoalId);

                if (isTabSwitch) {
                    if (typeof callback === 'function') {
                        callback();
                    }
                }else if (saveAndClose) {
                    markTabAsSaved('admin', true);
                    // Return to tasklist after shot delay
                    setTimeout(function () {
                        // Return to tasklist after short delay
                        returnToTaskList();
                    }, 1000);
                } else {
                    // Navigate to next tab
                    markTabAsSaved('admin');
                    navigateToNextTab();
                }
            } else {
                console.error('Error saving admin data: ', response.message);
                showErrorMessage('Save Failed', response.message || 'Failed to save data');
                markDataAsDirty()
            }
        },
        error: function (xhr, status, error) {
            // error code
            console.error('Error saving admin data: ', error);
            showErrorMessage('Save Error', 'Failed to save data', +error);
        }
    });
}

function collectActorData() {
    // Helper function to safely parse project parameters
    function parseProjectParm(value) {
        if (value === null || value === undefined || value === "null" || value === "") {
            return null; // return null instead of 0 to distinguish form actual 0 value
        }

        // if it is already a number, return it (including 0)
        if (typeof value === 'number') {
            return isNaN(value) ? null : value;
        }

        var parsed = parseInt(value);
        return isNaN(parsed) ? null : parsed;
    }

    var projectId = parseProjectParm(window.projectId);
    if (projectId === null) {
        projectId = parseInt(sessionStorage.getItem('AnalysisProjectId'));
    }

    projectId = projectId !== null ? projectId : 0;

    var projectStatusId = parseProjectParm(window.projectStatusId);
    if (projectStatusId === null) {
        projectStatusId = parseInt(sessionStorage.getItem('AnalysisProjectStatusId'));
    }

    projectStatusId = projectStatusId !== null ? projectStatusId : 0;

    var projectFlowId = parseProjectParm(window.projectFlowId);
    if (projectFlowId === null) {
        projectFlowId = parseInt(sessionStorage.getItem('AnalysisProjectFlowId'));
    }

    projectFlowId = projectFlowId !== null ? projectFlowId : 0;

    // Collect main debtor data mainDebtorBelfiusClient
    var mainDebtorBelfiusClient = parseInt($('#mainDebtorBelfiusClient').val()) || 0;
    var sponsorSelection = parseInt($('#sponsorSelection').val()) || 0;

    // Get operation type for Main Debtor
    var mainDebtorOperation = actorChangeTracker.mainDebtorOperation;

    var mainDebtor = {
        ProjectId: projectId,
        projectStatusId: projectStatusId,
        ProjectStatusFlowId: projectFlowId,
        ActorId: String($('#mainDebtorActorId').val() || ''), // varchar
        CI: String($('#mainDebtorCI').val() || ''),  // varchar
        ActorName: String($('#mainDebtorActorName').val() || ''),
        Rating1: parseInt($('#mainDebtorRating1').val()) || null,
        RatingDate: $('#mainDebtorRatingDate').val() || '',
        Watchlist: parseInt($('#mainDebtorWatchlist').val()) || 0,
        ExistingExposure: (function () {
            var val = $('#mainDebtorExistingExposure').val();
            return val && val !== '' ? parseFloat(val) : null;
        })(),
        LMRT: (function () {
            var val = $('#mainDebtorLMTR').val();
            return val && val !== '' ? parseFloat(val) : null;
        })(),
        CommercialRegion: parseInt($('#mainDebtorCommercialRegion').val()) || null,
        BusinessLine: parseInt($('#mainDebtorBusinessLine').val()) || null,
        CommercialSegment: String($('#mainDebtorCommercialSegment').val() || ''),
        BelfiusClient: parseInt($('#mainDebtorBelfiusClient').val()),
        PrivateWealthProfile: parseInt($('#mainDebtorPrivateWealthProfile').val()) || null,
        HasSponsor: parseInt($('#sponsorSelection').val()) || null, //convertTcodToDbValue(sponsorSelection) || null,
        Operation: mainDebtorOperation,
        IsDataFromReTable: (function () {
            var flagValue = ($('#mainDebtorIsDataFromReTable').val() || '').toString().toLowerCase().trim();
            return flagValue === 'true' || flagValue === 'yes';
        })()
    }

    // collect sponsor data (only if sponsor is selected as Yes)
    var sponsor = null;
    var sponsorOperation = actorChangeTracker.sponsorOperation;

    if (isTcodYes(sponsorSelection) || sponsorOperation === 'DELETE') {
        var sponsorBelfiusClientTcod = parseInt($('#sponsorBelfiusClient').val()) || 0;

        var isBelfiusClientNo = !isTcodYes(sponsorBelfiusClientTcod) && !isDbYes(sponsorBelfiusClientTcod);

        sponsor = {
            ProjectId: projectId,
            projectStatusId: projectStatusId,
            ProjectStatusFlowId: projectFlowId,
            BelfiusClient: parseInt($('#sponsorBelfiusClient').val()),
            ActorId: String($('#sponsorActorId').val() || ''), // varchar
            CI: String($('#sponsorCI').val() || ''), // varchar
            ActorName: String($('#sponsorActorName').val() || ''),
            Rating1: parseInt($('#sponsorRating1').val()) || null,
            RatingDate: $('#sponsorRatingDate').val(),
            RatingDateDisplayFormat: $('#sponsorRatingDateDisplyText').val(),
            PrivateWealthProfile: parseInt($('#sponsorPrivateWealthProfile').val()) || 0,
            IsValidActorId: parseInt($('#isSponsorValidActorId').val()) || 0,
            
            // if Belfius clinet is No - show/editable only financial capacity
            // so it is hidden (and not saved) when belfius clinet is Yes.
            // Experiance know-how is show/editable regardless of belfius client.

            FinancialCapacity: !isBelfiusClientNo ? null : (function () {
                var val = $('#sponsorFinancialCapacity').val();
                return val && val !== '' ? parseInt(val) : null;
            })(),
            ExperienceKnowHow: (function () {
                var val = $('#sponsorExperienceKnowHow').val();
                return val && val !== '' ? parseInt(val) : null;
            })(),
            //WillingnessToSupportProject: $('#sponsorWillingnessToSupport').val() || null,
            SponsorQuality: parseInt($('#sponsorQuality').val()) || null,
            Operation: sponsorOperation // Operation type Insert/Update/Delete or null
        };
    }

    // collect Other Actors data (dynamic field IDs)
    // Include all actors (selected and unselected) with operation type for backend processing
    var otherActors = [];
    $('.other-actor-select').each(function () {
        var fieldId = $(this).attr('id');

        // Extract actor type id from field Id (e.g, actor1 -> 1)
        var actorTypeId = parseInt(fieldId.replace('actor', ''));
        if (isNaN(actorTypeId)) {
            // could not extract actor type id from field id
            return; //skip this actor
        }

        var rawValue = $(this).val();
        if (rawValue === null || rawValue === undefined) {
            rawValue = '';
        }

        // still on "Select": unset means No row is answered. Nothing to send
        // already handle this case at validation
        if (rawValue === '') {
            return;
        }

        var value = parseInt($(this).val());
        // Get change tracking information for this actor
        var changeInfo = actorChangeTracker.otherActorsChanged[actorTypeId];
        var operation = changeInfo ? changeInfo.operation : null;
        
        var hadRowInitially = changeInfo ? changeInfo.hadRowInitially : false;

        // Fallback when no change event ever fired for this row
        if (!operation && !hadRowInitially) {
            operation = 'INSERT';
        }

        if (!isTcodYes(value)) {
            // No: persist a row with sw =No
            var otherActor = {
                ProjectId: projectId,
                projectStatusId: projectStatusId,
                ProjectStatusFlowId: projectFlowId,
                ActorTypeId: actorTypeId,
                ActorId: null, // For No insert/update default value
                ActorName: null, // For No insert/update default value
                Quality: null, // For No insert/update default value
                IsValidActorId: null,
                ActorTypeSw: TCOD_NO,
                Operation: operation
            };
            otherActors.push(otherActor);
            return;
        }

        // Yes: collect the details
        var field1Id = fieldId + 'Field1'; // Actor Id (actor1Field1)
        var field2Id = fieldId + 'Field2'; // Actor Name (readonly)
        var field2ManualId = field2Id + 'Manual'; // Actor Name (Manual)
        var qualitySelectId = fieldId + 'Quality'; // Quality (dropdown)
        var qualityInputId = qualitySelectId + 'Input'; // Quality (input readonly)
        var qualityHiddenId = qualitySelectId + 'Hidden'; // Quality (input readonly)
        var qualityHiddenValue = $('#' + qualityHiddenId).val();
        var isValidHiddenId = fieldId + 'IsValidActorId';

        // Get Actor ID
        var actorId = $('#' + field1Id).val() || '';

        if (!actorId || actorId.trim() === '') {
            // validator blocks this; nothig sensible to persist.
            return;
        }
        var actorName = '';

        if ($('#' + field2Id).is(':visible') && $('#' + field2Id).val()) {
            actorName = $('#' + field2Id).val();
        } else if ($('#' + field2ManualId).is(':visible') && $('#' + field2ManualId).val()) {
            actorName = $('#' + field2ManualId).val();
        }

        var quality = null;

        if (
            $('#' + qualitySelectId).is(':visible') &&
            $('#' + qualitySelectId).val()
        ) {
            quality = parseInt($('#' + qualitySelectId).val());
        } else if (qualityHiddenValue) {
            quality = parseInt(qualityHiddenValue);
        }

        var isValidHiddenValue = $('#' + isValidHiddenId).val();
        var isValidActorIdToSave = null;
        if (isValidHiddenValue === '1' || isValidHiddenValue === '0') {
            isValidActorIdToSave = parseInt(isValidHiddenValue);
        }

        var otherAactor = {
            ProjectId: projectId,
            ProjectStatusId: projectStatusId,
            ProjectStatusFlowId: projectFlowId,
            ActorId: String(actorId.trim()), // varchar
            ActorTypeId: actorTypeId,
            ActorName: String(actorName.trim() || ''), // for display only
            Quality: quality,
            IsValidActorId: isValidActorIdToSave,
            ActorTypeSw: TCOD_YES,
            Operation: operation // operation type: insert/update or null
        };
        otherActors.push(otherAactor);
    });


    // Review mode: always force UPDATE for all existing entities. 
    if (projectStatusId === 9) {
        mainDebtor.Operation = 'UPDATE';

        if (sponsor && sponsor.Operation  !== 'DELETE') {
            sponsor.Operation = 'UPDATE'
        }

        otherActors.forEach(function (actor) {
            actor.Operation = 'UPDATE';
        });
    }

    // Build the complete actor data object
    var actorData = {
        ProjectId: projectId,
        ProjectStatusId: projectStatusId,
        ProjectFlowId: projectFlowId,
        MainDebtor: mainDebtor,
        Sponsor: sponsor,
        OtherActors: otherActors
    };

    //console.log('Collected actor data: ', actorData);
    return actorData;
}


function saveActorDataToServer(saveAndClose, callback, isTabSwitch) {

    isTabSwitch = isTabSwitch || false;

    // Log change detection status with operation types
    var otherActorStatus = {};
    for (var actorTypeId in actorChangeTracker.otherActorsChanged) {
        var changeInfo = actorChangeTracker.otherActorsChanged[actorTypeId];
        otherActorStatus[actorTypeId] = {
            isChanged: changeInfo.isChanged,
            operation: changeInfo.operation,
            wasInitiallySelected: changeInfo.wasInitiallySelected
        };
    }
    // Collect all actor data from form
    var actorData = collectActorData();

    //console.log("actorData :", actorData);

    //return;
    // Make AJAX call to save actor data

    $.ajax({
        url: '/Analysis/SaveAllActorsData',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(actorData),
        success: function (response) {
            if (response.success) {
                showSuccessMessage('Actor Data Saved Successfully!');
                markDataAsClean();

                // Reset change tracker after successful save
                actorChangeTracker.mainDebtorOperation = null;
                actorChangeTracker.mainDebtorChanged = false;
                actorChangeTracker.sponsorChanged = false;
                actorChangeTracker.sponsorOperation = null;
                actorChangeTracker.otherActorsChanged = {};


                var statusId = window.projectStatusId;

                if (statusId === null || statusId === undefined) {
                    statusId = parseInt(sessionStorage.getItem('AnalysisProjectStatusId'));
                }

                var creProjectId = '0'
                var creGoalId = '0'
                if (sessionStorage.getItem('AnalysisCreProjectId') !== null) {
                    creProjectId = sessionStorage.getItem('AnalysisCreProjectId');
                }

                if (sessionStorage.getItem('AnalysisGoalId') !== null) {
                    creGoalId = sessionStorage.getItem('AnalysisGoalId');
                }

                // Store new original data
                storeOriginalActorData();

                // Update tracking of existing actors after successful save
                //initializeExistingActorsTracking();

                if (isTabSwitch) {
                    if (typeof callback === 'function') {
                        callback();
                    }
                } else if (saveAndClose) {
                    markTabAsSaved('actors', true)
                    // return to tasklist after shot delay
                    setTimeout(function () {
                        returnToTaskList();
                    }, 1000);
                } else {
                    // Navigate to next tab
                    markTabAsSaved('actors')
                    navigateToNextTab();
                }
            } else {
                showWarningMessage('Actor not found', response.message || 'Actor with this Id was not found. please verify the actor id.');
            }
        },
        error: function (xhr, status, error) {
            var errorMessage = 'Failed to save actor data: ' + error;
            showErrorMessage('Save error', errorMessage);
        }
    });

}

