            applyInlineErrors(result.fieldErrors)
        }
    } else if (currentTab === 'actors') {
        clearInlineErrors('#actorForm');
        if (!result.isValid) {
            applyInlineErrors(result.fieldErrors)
        }
    } else if (currentTab === 'project-credits') {
        clearInlineErrors('#project-credits-tab');
        if (!result.isValid) {
            applyInlineErrors(result.fieldErrors)
        }
    } else if (currentTab === 'collaterals') {
        clearInlineErrors('#collateralForm');
        if (!result.isValid) {
