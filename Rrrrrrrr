function clearSpecificFieldErrors(fieldSelector) {
    var $field = $(fieldSelector);

    if (!$field.length) {
        return;
    }

    $field.removeClass('field-invalid');
    var id = $field.attr('id');
    if (id) {
        $('#' + id + '-error').text('').hide();
    }

    var $next = $field.next();
    while ($next.length && $next.hasClass('.field-error-message')) {
        var $msg = $next;
        $next = $next.next();
        if (id && $msg.attr('id') === id + '-error') {
            $msg.text('').hide();
        } else {
            $msg.remove();
        }
    }
}

function clearInlineErrors(scopeSelector) {
    var $scope = scopeSelector ? $(scopeSelector) : $(document);
    $scope.find('.field-invalid').removeClass('field-invalid');
    $scope.find('.field-error-message').each(function () {
        $(this).text('').hide();
    });
}

function ensureErrorContainer($input, preferredId) {
    if (!$input || $input.length === 0) return null;
    if (preferredId) {
        var $preferred = $('#' + preferredId);
        if ($preferred.length > 0) return $preferred;
    }

    var inputId = $input.attr('id');
    if (inputId) {
        var $byId = $('#' + inputId + '-error');
        if ($byId.length > 0) return $byId;
    }

    var $container = $('<div class="field-error-message" role="alert"></div>').hide();

    if (inputId) {
        $container.attr('id', inputId + '-error');
    }
    $input.after($container);
    return $container;

}

function setFieldError(inputSelector, message, options) {
    var $input = $(inputSelector);
    if ($input.length === 0) return;
    $input.addClass('field-invalid');

    var preferredErrorId = options && options.errorContainerId ? options.errorContainerId : null;
    var $container = ensureErrorContainer($input, preferredErrorId);
    if ($container) {
        $container.text(message).show();
    }
}

function applyInlineErrors(fieldErrors) {
    if (!fieldErrors || fieldErrors.length === 0) return;
    fieldErrors.forEach(function (err) {
        if (!err || !err.selector) return;
        setFieldError(err.selector, err.message || 'Please enter value.', { errorContainerId: err.errorContainerId });
    });
}
/**
 * Reusable tab validation registry
 * Add new tabs by registering a validation that returns {isValid, message, fieldErrors}
 * */
var tabValidators = {};

function registerTabValidator(tabId, validatorFn) {
    tabValidators[tabId] = validatorFn
}

/**
 * Collect validation errors for a given tab without side effects
 * returns:
 * - isValid: boolean
 * - message: string[] (for screen level alerts)
 * - fieldErrors: {selector, message, errorContainerId? }[] (for inline validation)
 * */

function collectValidationErrors(tabId) {
    var validator = tabValidators[tabId];
    if (typeof validator !== 'function') {
        return { isValid: true, message: [], fieldErrors: [] };
    }
    return validator();
}

/**
 *  validators (register here)
 * */
registerTabValidator('admin', function () {
    var isValid = true;
    var messages = [];
    var fieldErrors = [];

    if ($('#projectReferenceType').length > 0) {
        var projectRefType = $('#projectReferenceType').val();
        if (!projectRefType || projectRefType.trim() === '') {
            messages.push('Project Reference type is required');
            fieldErrors.push({ selector: '#projectReferenceType', message: 'Please select reference type.' });
            isValid = false;
        } else {
            // Validate file reference value format for the selected type
            var config = getSelectedRefFormatConfig();
            if (config) {
                var fileRefVal = $('#fileReferenceValue').val();
                if (!fileRefVal || fileRefVal.trim() === '') {
                    messages.push('File Reference Value is required for the selected reference type.');
                    fieldErrors.push({
                        selector: '#fileReferenceValue',
                        message: 'Please enter file reference value.',
                        errorContainerId: 'fileReferenceValue-error'
                    });
                    isValid = false;
                } else if (!config.regex.test(fileRefVal)) {
                    var formatMsg = 'File Reference Value has an invalid format. Expected: ' + config.hint + '  (' + config.example + ')';
                    messages.push(formatMsg);
                    fieldErrors.push({
                        selector: '#fileReferenceValue',
                        message: 'Invalid format. Expected: ' + config.hint + '  (' + config.example + ')',
                        errorContainerId: 'fileReferenceValue-error'
                    });
                    isValid = false;
                }
            } else {
                var fileRefVal = $('#fileReferenceValue').val();
                if (!fileRefVal || fileRefVal.trim() === '') {
                    messages.push('File Reference Value is required for the selected reference type.');
                    fieldErrors.push({
                        selector: '#fileReferenceValue',
                        message: 'Please enter file reference value.',
                        errorContainerId: 'fileReferenceValue-error'
                    });
                    isValid = false;
                }
            }
        }
    }

    if ($('#projectName').length > 0) {
        var projectNameValue = $('#projectName').val();
        if (!projectNameValue || projectNameValue.trim() === '') {
            messages.push('Project name is required');
            fieldErrors.push({ selector: '#projectName', message: 'Please enter the project name.' });
