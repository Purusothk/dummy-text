                    Else
                        finalProjectStatusId = Nothing
                    End If
                    If Session("AnalysisProjectFlowId") IsNot Nothing Then
                        finalProjectFlowId = CInt(Session("AnalysisProjectFlowId"))
                    Else
                        finalProjectFlowId = Nothing
                    End If
                Else
                    _logger.Warning("KRWGSearch - Project context not found in params or session | User: {User}", userName)
                    Throw New ApplicationException("Project context not found")
                End If

                ' -------- Service Call (DI only) --------
                Dim paged = _collateralTabService.GetKrwgData(postcode, streetname,
                                                                finalProjectId,
                                                                finalProjectStatusId,
                                                                finalProjectFlowId,
                                                                pageNumber
                                                            )
