    Dim Cur_UserID As String = HttpContext.Current.User.Identity.Name.ToUpper().Replace("BELWIRED\", "") 'Fetching Current environment username

    Public Function GetActorData(projectId As Integer, actorId As String, Optional projectStatusId As Integer? = Nothing, Optional projectFlowId As Integer? = Nothing) As (ACTORNAME As String, RATING As String) Implements IProjectCreditsTabRepository.GetActorData
        Dim sw = Stopwatch.StartNew()
        _logger.Information("GetActorData - SP call started | Username: {Username}", Cur_UserID)
        ' Building the SQL condition
        Dim conditions As New List(Of String)
        conditions.Add("RE_PROJ_ID = " & projectId)

        If projectStatusId.HasValue Then
            conditions.Add("RE_proj_status_id = " & projectStatusId)
        End If

        If projectFlowId.HasValue Then
            conditions.Add("Re_proj_status_flow_id = " & projectFlowId)
        End If

        conditions.Add("re_actr_actor_id = '" & actorId & "'")

        ' Joining conditions
        Dim sqlCondition As String = "WHERE " & String.Join(" AND ", conditions)

        Dim ACTORNAME As String = String.Empty
        Dim RATING As String = String.Empty
        Using conn As OracleConnection = _dbContext.CreateConnection()
            conn.Open()

            Using cmd As New OracleCommand()
                cmd.Connection = conn
                cmd.CommandText = "QRER.PKG_SCREEN_ACTOR.SP_Get_ACTR_JSON"
                cmd.CommandType = CommandType.StoredProcedure
                'Input Parameters
                cmd.Parameters.Add("P_Formname", OracleDbType.Varchar2).Value = "ProjectCredits"
                cmd.Parameters.Add("P_username", OracleDbType.Varchar2).Value = Cur_UserID
                cmd.Parameters.Add("P_qry_ID", OracleDbType.Int32).Value = 3
                cmd.Parameters.Add("P_condition", OracleDbType.Varchar2).Value = sqlCondition
                'Output parameters
                Dim outparam As New OracleParameter("p_json_re_actr_out", OracleDbType.Clob)
                outparam.Direction = ParameterDirection.Output
                cmd.Parameters.Add(outparam)
                cmd.ExecuteNonQuery()
                Console.WriteLine(outparam.Value)
                ' Processing the output
                If outparam.Value IsNot Nothing AndAlso Not Convert.IsDBNull(outparam.Value) Then
                    Try
                        Dim jsonString As String

                        If TypeOf outparam.Value Is OracleClob Then
                            Dim clob As OracleClob = DirectCast(outparam.Value, OracleClob)
                            jsonString = clob.Value
                        Else
                            jsonString = outparam.Value.ToString()
                        End If

                        If Not String.IsNullOrEmpty(jsonString) Then
                            Dim actorList As List(Of ActorViewModel) = JsonConvert.DeserializeObject(Of List(Of ActorViewModel))(jsonString)

                            If actorList IsNot Nothing AndAlso actorList.Count > 0 Then
                                Dim actorData As ActorViewModel = actorList(0)
                                ACTORNAME = actorData.ActorName
                                RATING = actorData.QualityId
                            End If
                        End If
                    Catch ex As Exception
                        Console.WriteLine("Error processing output: " & ex.Message)
                    End Try
                End If
            End Using
        End Using
        _logger.Information("GetActorData - SP executed | User: {User} | ElapsedMs: {ElapsedMs}ms", Cur_UserID, sw.ElapsedMilliseconds)
        Return (ACTORNAME, RATING)
    End Function

