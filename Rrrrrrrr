                    .Data = New With {.success = False, .message = ex.Message},
                    .JsonRequestBehavior = JsonRequestBehavior.AllowGet
                }
            Catch ex As Exception
                sw.Stop()
                ' Unknown error  
                _logger.Error(ex, "KRWGSearch - Unhandled exception | User: {User} | Postcode: {Postcode} | Street: {Street} | ProjectId: {ProjectId} | StatusId: {StatusId} | FlowId: {FlowId} | ElapsedMs: {ElapsedMs}ms",
                    userName, postcode, streetname, projectId, projectStatusId, projectFlowId, sw.ElapsedMilliseconds)
                Return New JsonResult With {
                    .Data = New With {.success = False, .message = ex.Message},
                    .JsonRequestBehavior = JsonRequestBehavior.AllowGet
                }

            End Try
