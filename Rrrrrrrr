 Dim reportPath As String = Server.MapPath("~/Reports/Report1.rdlc")

If Not System.IO.File.Exists(reportPath) Then
    Return Content("RDLC file not found at: " & reportPath)
End If

Dim lastModified = System.IO.File.GetLastWriteTime(reportPath)
Return Content("Using file: " & reportPath & " | Last modified: " & lastModified.ToString())