        End If

        strStatus = objMail.SendMail("noreply@belfius.be", objParams.GetParam("INFOS_MAILBOX"), "", "", strDossier & "IF " & strActorNr, "", FilesToAttach)

        If strStatus = "" Then
            strSql = "UPDATE QRFI.TAX_GEN SET STATUS_MAILBOX = 'OK', MAILBOX = '" & objParams.GetParam("INFOS_MAILBOX") & "' WHERE DOSSIER_INFOS = '" & strDossier & "' AND (STATUS_MAILBOX IS NULL OR STATUS_MAILBOX = 'OK')"
            odf.ExecuteCommand(strSql)
        Else
            strSql = "UPDATE QRFI.TAX_GEN SET STATUS_MAILBOX = 'ERR', MAILBOX = '" & objParams.GetParam("INFOS_MAILBOX") & "' WHERE DOSSIER_INFOS = '" & strDossier & "'"
            odf.ExecuteCommand(strSql)
        End If

        Return strStatus

    End Function

