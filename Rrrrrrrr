// ===========================================
// Global Constants for Yes/No values.
// ===========================================
// Note: These constants support both currect (1/0) and legacy (-1/0) database values
// for backward compatibility. Update these if database schema changes.

var DB_YES_VALUES = Object.freeze([1, -1]); // values that represent "Yes" in database
var DB_NO_VALUES = Object.freeze([0]) // values that represent "No" in database
var DB_YES_PRIMARY = 1; // Primary Yes value (current standard)
var DB_NO_PRIMARY = 0; // Primary No value (current standard)
var DB_YES_LEGACY = -1; // Legacy Yes value (for backward compatibility)


// TCOD Yes/No constants
// There are used in dropdown selections
var TCOD_YES = 1;
var TCOD_NO = 0;

// handle both 1 and -1
function isDbYes(value) {
    if (value === null || value === undefined || value === '') {
        return false;
    }

    var numValue = parseInt(value);
    return DB_YES_VALUES.indexOf(numValue) !== -1;
}


function isDbNo(value) {
    if (value === null || value === undefined || value === '') {
        return true;
    }
    var numValue = parseInt(value);
    return DB_NO_VALUES.indexOf(numValue) !== -1;
}


function isTcodYes(value) {
    if (value === null || value === undefined || value === '') {
        return false;
    }

    var numValue = parseInt(value);
    return numValue === TCOD_YES;
}

function isTcodNo(value) {
    if (value === null || value === undefined || value === '') {
        return true; // Default to No if empty
    }
    var numValue = parseInt(value);
    return numValue === TCOD_NO;
}

// conver TCOD Yes/No value (1/0) to database value (1/0)
// use primayr DB_YES_PRIMARY (1) for Yes to maintain current standard
function convertTcodToDbValue(tcodValue) {
    var value = parseInt(tcodValue);
    if (isNaN(value)) {
        value = TCOD_NO;
    }
    return isTcodYes(value) ? DB_YES_PRIMARY : DB_NO_PRIMARY;
}



// conver database Yes/No value(1/-1 / 0) to TCOD value(1 / 0)
// support both 1 and -1 as Yes values for backwork compatability
function convertDbToTcodValue(dbValue) {
    if (isDbYes(dbValue)) {
        return TCOD_YES;
    }
    return TCOD_NO;
}

var tabState = {
    savedTabs: {}, // { admin: true, actors; true}
    tabOrder: [] // dynamic order
}

function markTabAsSaved(tabId, isSaveAndClose = false) {
    tabState.savedTabs[tabId] = true;

    var tab = $('.analyze-tab[data-tab="' + tabId + '"]');
    tab.addClass('saved');

    // persist state
    //sessionStorage.setItem('AnalysisSavedTabs_' + window.projectId, JSON.stringify(tabState.savedTabs));

    // unlock next tab ONLY if normal save
    if (!isSaveAndClose) {
        unlockNextTab(tabId);
    }

    saveLastAccessTab(tabId, isSaveAndClose);
}

function unlockNextTab(currentTabId) {
    var tabOrder = getTabOrder();
    var currentIndex = tabOrder.indexOf(currentTabId);
    var nextTab = tabOrder[currentIndex + 1];

    if (nextTab) {
        $('.analyze-tab[data-tab="' + nextTab + '"]').removeClass('disabled-tab');
    }
}

function getTabOrder() {
    var projStatus = window.projectStatusId || 0;
    var creProject = window.creProjectId || 0;
    // tabs 'construction', 'sales', 'pledged-account' moved to another screen
    // Define Tab order
    if (projStatus == 9 || projStatus == 10) {
        // Revaluation
        return ['admin', 'actors', 'project-credits', 'project-asset', 'collaterals', 'guidelines', 'guidance'];
    }
    else {
        switch (creProject) {
            case 1:
                // 1 = Yield property
                return ['admin', 'actors', 'project-credits', 'project-asset', 'collaterals', 'guidelines', 'guidance'];
            case 2:
            case 3:
                // 2 = Property promotion
                // 3 = Development
                return ['admin', 'actors', 'project-credits', 'project-asset', 'collaterals', 'guidelines', 'guidance', 'breakeven'];
            case 5:
                // 5 = Own use building
                return ['admin', 'actors', 'project-asset', 'guidelines'];
            default:
                return ['admin'];
        }
    }
}

function saveLastAccessTab(tabId, isSaveAndClose) {

    if (window.analysisMode === 'revaluation') {
        return;
    }

    var tabOrder = getTabOrder();
    var currentIndex = tabOrder.indexOf(tabId);

    if (currentIndex === -1) {
        return;
    }

    var nextTabName = isSaveAndClose ? tabId : tabOrder[currentIndex + 1] || tabId;

    // Convert to DB ID using mapping
    var tabIdToSave = getTabIdFromName(nextTabName);

    var model = [{
        RE_PROJ_ID: window.projectId,
        RE_PROJ_STATUS_ID: window.projectStatusId,
        RE_PROJ_STATUS_FLOW_ID: window.projectFlowId,
        RE_PROJ_TAB_ID: tabIdToSave
    }];

    $.ajax({
        url: '/Analysis/SaveAnalysisLastTab',
        type: 'POST',
        data: {
            jsonInput: JSON.stringify(model),
            projectTabId: tabIdToSave,
            projectStatusId: window.projectStatusId,
            creProjectId: window.creProjectId
        },
        success: function (res) {
            if (res && res.success) {
                window.projectTabId = tabIdToSave;
            } else {
                showErrorMessage('Tab save failed', 'Last Access tab save failed.');
                scrollTopShowErrorMessage();
            }
        },
        error: function () {
            showErrorMessage('Tab save failed', 'Last Access tab save failed.');
            scrollTopShowErrorMessage();
        }
    });
}

function restoreTabsUpTo(openTab) {
    var tabOrder = getTabOrder();
    var openIndex = tabOrder.indexOf(openTab);

    if (openIndex === -1) {
        openIndex = 0;
        openTab = 'admin';
    }

    $('.analyze-tab').addClass('disabled-tab');

    for (var i = 0; i <= openIndex; i++) {
        var tabId = tabOrder[i];

        $('.analyze-tab[data-tab="' + tabId + '"]').removeClass('disabled-tab');

        if (i < openIndex) {
            $('.analyze-tab[data-tab="' + tabId + '"]').addClass('saved');
            tabState.savedTabs[tabId] = true;
        }
    }
}

function getSafeResumeTab(tabId) {
    var requestedTab = getTabNameFromId(tabId);
    var tabOrder = getTabOrder();

    if (tabOrder.indexOf(requestedTab) !== -1) {
        return requestedTab;
    }

    return 'admin';
}

function getTabIdFromName(tabName) {
    var map = {
        'admin': 1,
        'actors': 2,
        'project-credits': 3,
        'project-asset': 4,
        'collaterals': 5,
        'guidelines': 6,
        'guidance': 7,
        'breakeven': 8
    }

    return map[tabName] || 1;
}

function getTabNameFromId(tabId) {
    var map = {
        1: 'admin',
        2: 'actors',
        3: 'project-credits',
        4: 'project-asset',
        5: 'collaterals',
        6: 'guidelines',
        7: 'guidance',
        8: 'breakeven'
    };

    return map[tabId] || 'admin';
}

