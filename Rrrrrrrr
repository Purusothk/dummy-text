            $('#' + nameReadonlyId).closest('div').hide();
            $('#' + nameReadonlyId).val('');
            $('#' + nameManualId).closest('div').show();
            $('#' + nameManualId).prop('readonly', false).val('');
            $('#' + qualityInputId).closest('div').hide();
            $('#' + qualityInputId).val('');

            var qualityHiddenId = qualitySelectId + 'Hidden';
            $('#' + qualityHiddenId).val('');

            $('#' + qualitySelectId).closest('div').show();
            $('#' + qualitySelectId).val('');

            // Hyphen is "No applicable" - clear validity so it persists as Null
            $('#' + isValidHiddenId).val('');
        } else if (actorId && actorId.trim() !== '' && actorId !== '-') {
            // Valid Actor Id - fetch details
            fetchOtherActorDetails(actorId, fieldId);
        }

        // Track changes for save optimization
        if (!isNaN(actorTypeId)) {
            // small delay to allow UI to update before checking
            setTimeout(function () {
                checkOtherActorChanges(actorTypeId);
            }, 100);
        }
    });

    // Track ActorName and Quality changes when actorid = "-"
    $(document).off('change', '.other-actor-details input[id$="Manual"], .other-actor-details select[id$="Quality"]').on('change', '.other-actor-details input[id$="Manual"], .other-actor-details select[id$="Quality"]', function () {
        var fieldId = $(this).attr('id');
        var actorTypeId = null;
        clearSpecificFieldErrors(this);
        // extract actorTypeId from filed id
        if (fieldId.indexOf('actor') !== -1) {
            var match = fieldId.match(/actor(\d+)/);
            if (match) {
                actorTypeId = parseInt(match[1]);
            }
        }

        if (!isNaN(actorTypeId) && actorTypeId > 0) {
            checkOtherActorChanges(actorTypeId);
        }
    });
}

// Function to check Main Debtor changes and determine operation type
function checkMainDebtorChanges() {
    var original = actorChangeTracker.originalData.mainDebtor;
    var current = {
        belfiusClient: $('#mainDebtorBelfiusClient').val(),
        hasSponsor: $('#sponsorSelection').val()
    };

    var originalHasSponsor = isTcodYes(original.hasSponsor) || isDbYes(original.hasSponsor);
    var currentHasSponsor = isTcodYes(current.hasSponsor) || isDbYes(current.hasSponsor);

    var dataChanged = (
        original.belfiusClient !== current.belfiusClient ||
        original.hasSponsor !== current.hasSponsor
    );

    // Determine operation type
    var operation = null;
    var isChanged = false;

    if (dataChanged) {
        // Main debtor changes always UPDATE
        operation = 'UPDATE'
        isChanged = true;

        // if HasSponsor changed from Yes to No, also mark sponsor for DELETE
        if (actorChangeTracker.originalData.sponsor.wasInitiallySelected && !currentHasSponsor) {
            actorChangeTracker.sponsorOperation = 'DELETE';
            actorChangeTracker.sponsorChanged = true;
        }
    }
    actorChangeTracker.mainDebtorChanged = isChanged;
    actorChangeTracker.mainDebtorOperation = operation;



    if (isChanged) {
        markDataAsDirty();
    }

    //console.log("MD: original data: ", actorChangeTracker.originalData.mainDebtor);
    //console.log("MD: current data: ", current);
}

// Function to check the sponsor changes and determin the operation type (Insert/Update/Delete)
function checkSponsorChanges() {
    var original = actorChangeTracker.originalData.sponsor;

    var currentSponsorSelection = $('#sponsorSelection').val() || '0';
    var sponsorYes = isTcodYes(currentSponsorSelection) || isDbYes(currentSponsorSelection);

    //var currentIsSelected = isTcodYes(currentSponsorSelection) || isDbYes(currentSponsorSelection);
    //var originalIsSelected = original.wasInitiallySelected || false;

    var current = {
        belfiusClient: $('#sponsorBelfiusClient').val(),
        sponsorFinancialCapacity: $('#sponsorFinancialCapacity').val(),
        sponsorExperienceKnowHow: $('#sponsorExperienceKnowHow').val(),
        sponsorActorId: $('#sponsorActorId').val() || '',
        sponsorActorName: $('#sponsorActorName').val() || '',
    };

    var currentHasActorId = current.sponsorActorId.trim() !== '';
    var originalRecordExisted = original.wasInitiallySelected || false;

    var dataChanged = (
        original.belfiusClient !== current.belfiusClient ||
        original.sponsorActorId !== current.sponsorActorId ||
        original.sponsorActorName !== current.sponsorActorName ||
        original.sponsorFinancialCapacity !== current.sponsorFinancialCapacity ||
        original.sponsorExperienceKnowHow !== current.sponsorExperienceKnowHow
    );


    // Determin operation type based on selection state change
    var operation = null;
    var isChanged = false

    if (!sponsorYes) {
        if (originalRecordExisted) {
            operation = 'DELETE';
            isChanged = true;
        }
    } else if (!currentHasActorId) {
        operation = null;
        isChanged = false;
    } else if (!originalRecordExisted) {
        operation = 'INSERT';
        isChanged = true;
    } else if (dataChanged) {
        operation = 'UPDATE';
        isChanged = true;
    } else {
        operation = null;
        isChanged = false;
    }


    actorChangeTracker.sponsorChanged = isChanged;
    actorChangeTracker.sponsorOperation = operation;

    if (isChanged) {
        markDataAsDirty();
    }

    //console.log("SP: original data: ", actorChangeTracker.originalData.sponsor);
    //console.log("SP: current data: ", current);
}

// Function to check other actor changes and determine operation type (Insert/Update/Delete)
function checkOtherActorChanges(actorTypeId) {
    var fieldId = 'actor' + actorTypeId;
    var field1Id = fieldId + 'Field1';
    var nameManualId = fieldId + 'Field2Manual';
    var qualityId = fieldId + 'Quality';

    var original = actorChangeTracker.originalData.otherActors[actorTypeId];
    if (!original) {
        original = {
            isSelected: '',
            hadRowInitially: false,
            wasInitiallySelected: false,
            actorId: '',
            isValidActorId: '',
            actorName: '',
            quality: ''
        };
    }

    var currentActorId = $('#' + field1Id).val() || '';
    var isHyphen = currentActorId === '-';

    var isValidHiddenId = fieldId + 'IsValidActorId';
    var currentIsValidHidden = $('#' + isValidHiddenId).val() || '';
    var isInvalidActor = currentIsValidHidden === '0';
    var manulEntry = isHyphen || isInvalidActor;

    var currentValue = $('#' + fieldId).val(); // actor1
    if (currentValue === null || currentValue === undefined) {
        currentValue = '';
    }
    var hasCurrentValue = currentValue !== '';
    var currentIsYes = isTcodYes(currentValue);

    var hadRow = original.hadRowInitially || false;
    var wasYes = original.wasInitiallySelected || false;

    var current = {
        isSelected: currentValue,
        actorId: currentActorId,
        isValidActorId: currentIsValidHidden,
        actorName: manulEntry ? ($('#' + nameManualId).val() || '') : '',
        quality: manulEntry ? ($('#' + qualityId).val() || '') : ''
    };

    // Determine if data has changed
    var dataChanged = (
        original.actorId !== current.actorId ||
        (original.isValidActorId || '') !== (current.isValidActorId || '') ||
        (manulEntry && (original.actorName !== current.actorName || original.quality !== current.quality))
    );

    // Determine operation type based on selection state changes
    var operation = null;
    var isChanged = false;

    if (!hasCurrentValue) {
        operation = 'INSERT';
        isChanged = false;
    } else if (!hadRow) {
        // was selected, now not selected -> Delete
        operation = 'INSERT';
        isChanged = true;
    } else if (wasYes !== currentIsYes) {
        // was selected, still selected, but data changed -> UPDATE
        operation = 'UPDATE';
        isChanged = true;
    } else if (currentIsYes && dataChanged) {
        // was selected, still selected, no data changed -> NO-OP (skip)
        operation = 'UPDATE';
        isChanged = true;
    } else {
        operation = null;
        isChanged = false;
    }

    // Update change tracker
    if (!actorChangeTracker.otherActorsChanged[actorTypeId]) {
        actorChangeTracker.otherActorsChanged[actorTypeId] = {
            isChanged: false,
            operation: null,
            hadRowInitially: hadRow,
            wasInitiallySelected: wasYes
        };
    }

    actorChangeTracker.otherActorsChanged[actorTypeId].isChanged = isChanged;
    actorChangeTracker.otherActorsChanged[actorTypeId].operation = operation;

    if (isChanged) {
        markDataAsDirty();
    }

    //console.log("OA: original data: ", actorChangeTracker.originalData.otherActors[actorTypeId]);
    //console.log("OA: current data: ", current);
}

