Public Class frmViewLog

    Private Sub frmViewLog_Load(sender As Object, e As EventArgs) Handles MyBase.Load
        ViewLog(dtpLog.Value)
    End Sub

    Private Sub btnShow_Click(sender As Object, e As EventArgs) Handles btnShow.Click
        ViewLog(dtpLog.Value)
    End Sub

    Private Sub ViewLog(daDate As Date)

        Dim strSql As String
        Dim ds As New EucDataSet

        strSql = "SELECT * FROM QRFI.TAX_GEN WHERE TRUNC(DA_SEND) = TO_DATE('" & daDate.ToString("dd/MM/yyyy") & "', 'dd/mm/yyyy') ORDER BY DA_SEND"
        ds.ImportFromOracle("TAX_GEN", strSql)

        grdLog.DataSource = ds.Tables("TAX_GEN")

    End Sub

End Class


Public Class frmRequest

    Private Sub frmRequest_Load(sender As Object, e As EventArgs) Handles MyBase.Load
        LoadRequests()
    End Sub

    Private Sub LoadRequests()

        Dim strSql As String
        Dim ds As New EucDataSet

        strSql = "SELECT DOSSIER_INFOS FROM QRFI.TAX_RESEND_DOSS ORDER BY DOSSIER_INFOS"
        ds.ImportFromOracle("INFOS", strSql)

        lstDossNr.Items.Clear()

        For Each drRow As DataRow In ds.Tables("INFOS").Rows
            lstDossNr.Items.Add(drRow("DOSSIER_INFOS").ToString())
        Next

    End Sub

    Private Sub btnAdd_Click(sender As Object, e As EventArgs) Handles btnAdd.Click

        Dim strSql As String
        Dim odf As New OracleDataFunctions

        strSql = "INSERT INTO QRFI.TAX_RESEND_DOSS (DOSSIER_INFOS) VALUES ('" & txtDossNr.Text.Replace("'", "''").ToUpper() & "')"
        odf.ExecuteCommand(strSql)

        LoadRequests()

    End Sub

    Private Sub lstDossNr_KeyUp(sender As Object, e As KeyEventArgs) Handles lstDossNr.KeyUp

        If lstDossNr.SelectedItems.Count = 1 Then
            If e.KeyCode = 46 Or e.KeyCode = 8 Then '46 = the DEL key / 8 = the BACKSPACE key

                Dim odf As New OracleDataFunctions
                odf.ExecuteCommand("DELETE FROM QRFI.TAX_RESEND_DOSS WHERE DOSSIER_INFOS = '" & lstDossNr.SelectedItem.ToString() & "'")

                LoadRequests()

            End If
        End If

    End Sub

End Class


