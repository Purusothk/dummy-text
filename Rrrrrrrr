        var nameReadonlyId = baseId + 'Field2'; // eg: actor1Field2
        var nameManualId = nameReadonlyId + 'Manual'; // eg: actor1Field2Manual
        var qualitySelectId = baseId + 'Quality'; // actor1Quality
        var qualityInputId = qualitySelectId + 'Input'; // actor1QualityInput
        var actorTypeId = parseInt(baseId.replace('actor', '')); // eg: 1

