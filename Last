                                function calculateYieldInfo() {

                                    var txtProjRental = document.getElementById("txtProjRental").value;
                                    var txtProjCredit = document.getElementById("txtProjCredit").value;
                                    var txtExRental = document.getElementById("txtExRental").value;
                                    var txtExCredit = document.getElementById("txtExCredit").value;
                                    var txtEBITDA = document.getElementById("txtEBITDA").value;

                                    txtProjRental = txtProjRental.replace(/\./g, ''); // Replace all dots with nothing
                                    txtProjRental = txtProjRental.replace(/\,/g, '.'); // Replace all commas with dots

                                    txtProjCredit = txtProjCredit.replace(/\./g, ''); // Replace all dots with nothing
                                    txtProjCredit = txtProjCredit.replace(/\,/g, '.'); // Replace all commas with dots

                                    txtExRental = txtExRental.replace(/\./g, ''); // Replace all dots with nothing
                                    txtExRental = txtExRental.replace(/\,/g, '.'); // Replace all commas with dots

                                    txtExCredit = txtExCredit.replace(/\./g, ''); // Replace all dots with nothing
                                    txtExCredit = txtExCredit.replace(/\,/g, '.'); // Replace all commas with dots

                                    txtEBITDA = txtEBITDA.replace(/\./g, ''); // Replace all dots with nothing
                                    txtEBITDA = txtEBITDA.replace(/\,/g, '.'); // Replace all commas with dots

                                    if (parseFloat(txtExCredit) === 0) {
                                        result_ex = 0;
                                    } else {
                                        result_ex = (parseFloat(txtExRental) / parseFloat(txtExCredit)) * 100;
                                    }
                                    document.getElementById("txtExDSCR").value = parseFloat(result_ex).toFixed(2).replace('.', ',') + " %"

                                    txtTotalRental = parseFloat(txtProjRental) + parseFloat(txtExRental)
                                    document.getElementById("txtTotalRental").value = parseFloat(txtTotalRental)

                                    txtTotalCredit = parseFloat(txtProjCredit) + parseFloat(txtExCredit)
                                    document.getElementById("txtTotalCredit").value = parseFloat(txtTotalCredit)

                                    if (parseFloat(txtTotalCredit) === 0) {
                                        result_total = 0;
                                    } else {
                                        result_total = (parseFloat(txtTotalRental) / parseFloat(txtTotalCredit)) * 100;
                                    }
                                    document.getElementById("txtTotalDSCR").value = parseFloat(result_total).toFixed(2).replace('.', ',') + " %"

                                    txtTotalEBITDA = Math.round(parseFloat(txtEBITDA) + parseFloat(txtTotalRental) - parseFloat(txtTotalCredit));
                                    document.getElementById("txtTotalEBITDA").value = txtTotalEBITDA;
                                }
