        Private Sub LoadProfiles()
            Dim actualRole As String = Convert.ToString(Session("UserRole")).Trim().ToUpper()
            Dim profiles As New List(Of String)

            Select Case actualRole
                Case "SUPER USER"
                    profiles.Add("Super User")
                    profiles.Add("CLS A&D")
                    profiles.Add("CLS C&S")
                    profiles.Add("CRE Expert")
                Case "ANALYST"
                    profiles.Add("CLS A&D")
                Case "LOAN OFFICER"
                    profiles.Add("CLS C&S")
                Case "CRE EXPERT"
                    profiles.Add("CRE Expert")
            End Select

            ViewBag.Profiles = profiles

            If Session("SelectedProfile") Is Nothing Then
                Select Case actualRole
                    Case "SUPER USER"
                        Session("SelectedProfile") = "Super User"
                    Case "ANALYST"
                        Session("SelectedProfile") = "CLS A&D"
                    Case "LOAN OFFICER"
                        Session("SelectedProfile") = "CLS C&S"
                    Case "CRE EXPERT"
                        Session("SelectedProfile") = "CRE Expert"
                End Select
            End If

            ViewBag.SelectedProfile = Convert.ToString(Session("SelectedProfile"))
            ViewBag.CanChangeProfile = (actualRole = "SUPER USER")
