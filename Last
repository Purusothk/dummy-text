Public Function GetAdminPdfFields(adminData As AdminTabViewModel) As List(Of AnalysisPdfFieldModel) Implements IAdminTabService.GetAdminPdfFields

    Dim rows As New List(Of AnalysisPdfFieldModel)()
    Dim order As Integer = 0
    Const tab As String = "Admin"

    ' ProjectReferenceType is a String code, resolve to display text manually
    Dim referenceTypeText As String = ""
    If adminData.ReferenceTypeOptions IsNot Nothing AndAlso Not String.IsNullOrEmpty(adminData.ProjectReferenceType) Then
        Dim match = adminData.ReferenceTypeOptions.FirstOrDefault(Function(x) x.TcodId.ToString() = adminData.ProjectReferenceType)
        If match IsNot Nothing Then referenceTypeText = match.TcodDescName
    End If

    Dim creProjectText As String = TcodTypeHelper.GetDisplayText(adminData.CommercialReProjId, adminData.CreProjectOptions)
    Dim creTypeText As String = TcodTypeHelper.GetDisplayText(adminData.ReTypeId, adminData.CreTypeOptions)
    Dim goalText As String = TcodTypeHelper.GetDisplayText(adminData.GoalId, adminData.ProjectGoalOptions)

    ' ---- Project Details ----
    Dim sec As String = "Project Details"
    rows.Add(New AnalysisPdfFieldModel(tab, sec, "Project ID", adminData.ProjectId.ToString(), order)) : order += 1
    rows.Add(New AnalysisPdfFieldModel(tab, sec, "Project Reference Type", referenceTypeText, order)) : order += 1
    rows.Add(New AnalysisPdfFieldModel(tab, sec, "Project Status", adminData.ProjectStatusIdDisplyText, order)) : order += 1
    rows.Add(New AnalysisPdfFieldModel(tab, sec, "Project Name", adminData.ProjectName, order)) : order += 1
    rows.Add(New AnalysisPdfFieldModel(tab, sec, "File Ref Value", adminData.FileReferenceValue, order)) : order += 1
    rows.Add(New AnalysisPdfFieldModel(tab, sec, "Status Date", If(adminData.StatusDate.HasValue, adminData.StatusDate.Value.ToString("dd-MM-yyyy"), ""), order)) : order += 1

    ' ---- User Details ----
    sec = "User Details"
    rows.Add(New AnalysisPdfFieldModel(tab, sec, "User Initiator", adminData.UserCreator, order)) : order += 1
    rows.Add(New AnalysisPdfFieldModel(tab, sec, "Initiate Date", If(adminData.CreationDate.HasValue, adminData.CreationDate.Value.ToString("dd-MM-yyyy"), ""), order)) : order += 1
    rows.Add(New AnalysisPdfFieldModel(tab, sec, "Last User", adminData.LastUser, order)) : order += 1
    rows.Add(New AnalysisPdfFieldModel(tab, sec, "Last Update Date", If(adminData.LastUpdateDate.HasValue, adminData.LastUpdateDate.Value.ToString("dd-MM-yyyy"), ""), order)) : order += 1

    ' ---- CRE Details ----
    sec = "CRE Details"
    rows.Add(New AnalysisPdfFieldModel(tab, sec, "CRE Project", creProjectText, order)) : order += 1
    rows.Add(New AnalysisPdfFieldModel(tab, sec, "CRE Type", creTypeText, order)) : order += 1
    rows.Add(New AnalysisPdfFieldModel(tab, sec, "Project Goal", goalText, order)) : order += 1

    ' ---- Bank Details (only if ReProjAgErID has a value, same rule as the view) ----
    If adminData.ReProjAgErID.HasValue Then
        sec = "Bank Details"
        rows.Add(New AnalysisPdfFieldModel(tab, sec, "Receiving Date", If(adminData.ReceivingDate.HasValue, adminData.ReceivingDate.Value.ToString("dd-MM-yyyy"), ""), order)) : order += 1
        rows.Add(New AnalysisPdfFieldModel(tab, sec, "User Banker", adminData.UserBanker, order)) : order += 1
        rows.Add(New AnalysisPdfFieldModel(tab, sec, "CI Banker", adminData.CiBanker, order)) : order += 1
        rows.Add(New AnalysisPdfFieldModel(tab, sec, "Region Banker", adminData.RegionBanker, order)) : order += 1
        rows.Add(New AnalysisPdfFieldModel(tab, sec, "CDC Central Rep ID", adminData.CdcCentralRepId, order)) : order += 1

        ' ---- CRE Advisor (same condition) ----
        sec = "CRE Advisor"
        rows.Add(New AnalysisPdfFieldModel(tab, sec, "Distribution Advice", adminData.DistributionAdviceDisplayText, order)) : order += 1
        rows.Add(New AnalysisPdfFieldModel(tab, sec, "Distribution Conditions", adminData.DistributionCondition, order)) : order += 1
    End If

    Return rows

End Function