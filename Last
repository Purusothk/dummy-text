    'if number of account is above 600, some attests might be wrong. Contact Eloi to adapt the daily job.
    Private Function checkNumberOfAccountsAbove600() As Boolean
        Dim intDay As Integer = 0
        Dim intNbAccounts As Integer
        Dim strSql As String
        Dim ds As New EucDataSet

        If DateTime.Now.DayOfWeek = DayOfWeek.Monday Then
            intDay = 3
        Else
            intDay = 1
        End If

        strSql = "select  count (account1) as nb_compt
                    , gen.da_batch
                    from qrfi.tax_gen gen
                    , qrfi.tax_accounts acc
                    where gen.dossier_infos = acc.dossier_infos
                    and gen.da_batch = TRUNC(sysdate) - " & intDay &
                    " and Acc.p058 in ('01','02','03','06','07','08','25','26','28')
                    group by gen.da_batch"

        ds.ImportFromOracle("COUNT", strSql)
        If ds.Tables("COUNT").Rows.Count > 0 Then intNbAccounts = ds.Tables("COUNT").Rows(0).Item("nb_compt").ToString

        If intNbAccounts > 600 Then
            checkNumberOfAccountsAbove600 = True
        Else
            checkNumberOfAccountsAbove600 = False
        End If

    End Function



