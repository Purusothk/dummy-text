Imports Serilog

Public Class PdfController
    Inherits Controller

    Private ReadOnly _constructionFollowUpService As IConstructionFollowUpService
    Private ReadOnly _pdfService As IPdfReportService
    Private ReadOnly _analysisPdfService As IAnalysisPdfService
    Private ReadOnly _logger As ILogger

    Private Shared ReadOnly RdlcPaths As New Dictionary(Of String, String) From {
        {"Expected_FR", "~/Reports/ConstructionFollowUp_Expected_FR.rdlc"},
        {"Expected_NL", "~/Reports/ConstructionFollowUp_Expected_NL.rdlc"},
        {"Committed_FR", "~/Reports/ConstructionFollowUp_Committed_FR.rdlc"},
        {"Committed_NL", "~/Reports/ConstructionFollowUp_Committed_NL.rdlc"}
    }

    Public Sub New(constructionFollowUpService As IConstructionFollowUpService,
                   pdfService As IPdfReportService,
                   analysisPdfService As IAnalysisPdfService)
        _constructionFollowUpService = constructionFollowUpService
        _pdfService = pdfService
        _analysisPdfService = analysisPdfService
        _logger = Log.ForContext(Of PdfController)()
    End Sub

    ' ------------------------------------------------------------------
    ' Construction Follow-Up PDF (Yash's - unchanged)
    ' ------------------------------------------------------------------
    <HttpGet>
    Public Function ConstructionFollowUpPdf(
        projectId As Integer?,
        stage As String,
        language As String,
        Optional projectStatusId As Integer? = Nothing,
        Optional projectFlowId As Integer? = Nothing
    ) As ActionResult

        If Not projectId.HasValue OrElse projectId.Value <= 0 Then
            _logger.Warning("ConstructionFollowUpPdf - Invalid projectId | ProjectId:{ProjectId}", projectId)
            Return New HttpStatusCodeResult(400, "Invalid project ID.")
        End If

        Dim normalizedStage = If(stage, "").Trim()
        Dim normalizedLang = If(language, "").Trim().ToUpper()

        If normalizedStage <> "Expected" AndAlso normalizedStage <> "Committed" Then
            Return New HttpStatusCodeResult(400, "Stage must be 'Expected' or 'Committed'.")
        End If

        If normalizedLang <> "FR" AndAlso normalizedLang <> "NL" Then
            Return New HttpStatusCodeResult(400, "Language must be 'FR' or 'NL'.")
        End If

        Dim rdlcKey = normalizedStage & "_" & normalizedLang
        Dim rdlcPath As String = Nothing
        If Not RdlcPaths.TryGetValue(rdlcKey, rdlcPath) Then
            Return New HttpStatusCodeResult(500, "Report template not found.")
        End If

        Try
            Dim followUpData = _constructionFollowUpService.GetConstructionFollowUp(projectId, projectStatusId, projectFlowId)

            Dim phases As List(Of ConstructionFollowUpPhase) = Nothing
            If normalizedStage = "Expected" Then
                phases = followUpData.Expected?.FirstOrDefault()?.Expected
            Else
                phases = followUpData.Committed?.FirstOrDefault()?.Committed
            End If

            If phases Is Nothing OrElse Not phases.Any() Then
                _logger.Warning("ConstructionFollowUpPdf - No {Stage} data | ProjectId:{ProjectId}", normalizedStage, projectId.Value)
                Return New HttpStatusCodeResult(404, "No " & normalizedStage & " data found for this project.")
            End If

            Dim dataSources As New Dictionary(Of String, IEnumerable) From {
                {"PhaseData", phases}
            }

            Dim parameters As New Dictionary(Of String, String) From {
                {"prm_ProjectId", projectId.Value.ToString()},
                {"prm_DocumentRef", projectId.Value.ToString()},
                {"prm_GeneratedDate", DateTime.Now.ToString("dd/MM/yyyy")}
            }

            Dim pdfBytes = _pdfService.GeneratePdf(rdlcPath, "CFU_" & rdlcKey, dataSources, parameters)

            Dim fileName = "ConstructionFollowUp_" & normalizedStage & "_" & normalizedLang & "_" & DateTime.Now.ToString("yyyyMMdd") & ".pdf"
            Return File(pdfBytes, "application/pdf", fileName)

        Catch ex As Exception
            Dim refId = Guid.NewGuid().ToString().Substring(0, 8).ToUpper()
            _logger.Error(ex, "ConstructionFollowUpPdf - Error | RefId:{RefId} | ProjectId:{ProjectId} | Stage:{Stage} | Lang:{Lang}",
                          refId, projectId.Value, normalizedStage, normalizedLang)
            Return New HttpStatusCodeResult(500, "Could not generate PDF. Contact IT support with reference: " & refId)
        End Try

    End Function

    ' ------------------------------------------------------------------
    ' Analysis Report PDF (yours - NEW action added to Yash's controller)
    ' ------------------------------------------------------------------
    <HttpGet>
    Public Async Function AnalysisReportPdf() As Task(Of ActionResult)
        Dim sw = Stopwatch.StartNew()

        Try
            If Session("AnalysisProjectId") Is Nothing Then
                _logger.Warning("AnalysisReportPdf - No project in session")
                Return New HttpStatusCodeResult(400, "No project selected.")
            End If

            Dim projectId As Integer = Convert.ToInt32(Session("AnalysisProjectId"))
            Dim projectStatusId As Integer? = If(Session("AnalysisProjectStatusId") IsNot Nothing, Convert.ToInt32(Session("AnalysisProjectStatusId")), CType(Nothing, Integer?))
            Dim projectFlowId As Integer? = If(Session("AnalysisProjectFlowId") IsNot Nothing, Convert.ToInt32(Session("AnalysisProjectFlowId")), CType(Nothing, Integer?))

            If projectId <= 0 Then
                Return New HttpStatusCodeResult(400, "Invalid project ID.")
            End If

            Dim pdfBytes As Byte() = Await _analysisPdfService.GenerateAnalysisReportPdfAsync(projectId, projectStatusId, projectFlowId)

            sw.Stop()
            _logger.Information("AnalysisReportPdf - Completed | ProjectId: {ProjectId} | ElapsedMs: {ElapsedMs}ms", projectId, sw.ElapsedMilliseconds)

            Dim fileName As String = $"Analysis_Project_{projectId}_{DateTime.Now:yyyyMMdd_HHmmss}.pdf"
            Return File(pdfBytes, "application/pdf", fileName)

        Catch ex As Exception
            sw.Stop()
            Dim refId = Guid.NewGuid().ToString().Substring(0, 8).ToUpper()
            _logger.Error(ex, "AnalysisReportPdf - Error | RefId: {RefId}", refId)
            Return New HttpStatusCodeResult(500, $"Could not generate PDF. Contact IT support with reference: {refId}")
        End Try
    End Function

End Class


