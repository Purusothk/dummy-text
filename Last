                                            return StatusChange(7);

                                        });

                                        // Return to tasklist after short delay
                                        setTimeout(function () { returnToTaskList(); }, 1000);
                                    }

                                } else {
                                    console.error('Error saving decision data: ', response.message);
                                    showErrorMessage('Save failed', response.message || 'Failed to save decision data');
                                    markDataAsDirty()
                                }
                            })
                            .catch(error => {
                                console.error('Error saving decision data: ', error);
                                showErrorMessage('Save error', 'Failed to save decision data', +error);
                            });
                    } else {

                        // Validation failed
                        showErrorMessage('Validation failed', messages.join('<br>'));
                        if (focusField != null) {
                            focusField.focus();
                        }
                        event.preventDefault(); // Prevent form submission
                    }
                }
            </script>

            <script>
                function getColorValue(textBoxId) {

                    var element = document.getElementById(textBoxId);
                    if (!element) return "-1"; // Return -1 if element not found

                    var bgColor = element.style.backgroundColor.toLowerCase();

                    if (bgColor === "mediumseagreen") {
                        return "00";
                    } else if (bgColor === "lightgrey" || bgColor === "lightgray") {
                        return "01";
                    } else if (bgColor === "orange") {
                        return "02";
                    } else if (bgColor === "red") {
                        return "03";
                    } else if (bgColor === "black") {
                        return "04";
                    } else {
                        return "-1";
                    }
                }
            </script>

            <script>
                function getTextValue(textBoxId, typeId) {

                    var element = document.getElementById(textBoxId);
                    if (!element) return null; // Return null if element not found

                    if (typeId == 1) {
                        return parseFloat(parseFloat(element.value).toFixed(2));
                    } else {
                        return element.value;
                    }
                }
            </script>

            <script>
                function getSwitchValue(textBoxId) {

                    var element = document.getElementById(textBoxId);
                    if (!element) return -1; // Return -1 if element not found

                    if (element.value == "Yes") {
                        return 1;
                    } else if (element.value == "No") {
                        return 0;
                    } else {
                        return -1;
                    }
                }
