function navigateToAction(actionUrl, projectId, projectStatusId, projectFlowId, mode, projectTabId, creProjectId, openInNewTab) {

    var form = $('<form>', {
        method: 'POST',
        action: actionUrl
    });

    form.append($('<input>', {
        type: 'hidden',
        name: 'projectId',
        value: projectId
    }));

    form.append($('<input>', {
        type: 'hidden',
        name: 'projectStatusId',
        value: projectStatusId
    }));

    form.append($('<input>', {
        type: 'hidden',
        name: 'projectFlowId',
        value: projectFlowId
    }));

    if (projectTabId) {
        form.append($('<input>', {
            type: 'hidden',
            name: 'projectTabId',
            value: projectTabId
        }));
    }

    if (creProjectId) {
        form.append($('<input>', {
            type: 'hidden',
            name: 'creProjectId',
            value: creProjectId
        }));
    }

    if (mode) {
        form.append($('<input>', {
            type: 'hidden',
            name: 'mode',
            value: mode
        }));
    }
    if (openInNewTab) {
        form.attr('target', '_blank');
    }
    $('body').append(form);
    form.submit();
}

function changeStatusAndNavigate(projectId, oldStatusId, oldStatusFlowid, newStatusId, actionUrl, mode, projectTabId, creProjectId) {
    $.ajax({
        url: '/TaskList/ChangeProjectStatus',
        type: 'POST',
        data: {
            projectId: projectId,
            oldStatusId: oldStatusId,
            oldStatusFlowid: oldStatusFlowid,
            newStatusId: newStatusId
        },
        success: function (res) {
            if (res && res.success) {
                var openInNewTab = (mode === 'revaluation');
                navigateToAction(actionUrl, projectId, newStatusId, res.newStatusFlowid, mode, projectTabId, creProjectId, openInNewTab);
            } else {
                showStatusError(res && res.message ? res.message : 'Status change failed. Please contact LAD - ISSPA@belfius.be');
            }
        },
        error: function () {
            showStatusError('Status change failed. Please contact LAD - ISSPA@belfius.be')
        }
    });
}

function showInlineError(inputId, message) {
    const el = $('#' + inputId);
    clearInlineError(inputId);
    el.addClass('is-invalid');
    $('#' + inputId + '-error').html(`<span class="inline-error">${message}</span>`);
}

function clearInlineError(inputId) {
    const el = $('#' + inputId);
    el.removeClass('is-invalid');
    $('#' + inputId + '-error').empty();
}

function showAccessPopup(message, title) {

    if (!$('#accessDeniedModal').length) {

        console.error("Access popup not found");

        return;

    }

    $('#accessDeniedMessage').html(message);

    $('#accessDeniedTitle').html(

        title || 'Access Restricted'

    );

    $('#accessDeniedModal').modal({

        backdrop: 'static',

        keyboard: false

    });

    $('#accessDeniedModal').modal('show');

}


function applyTaskListAccess() {
    const role = (window.tasklistAccess || '')
        .trim()
        .toUpperCase();

    console.log("TaskList Role:", role);

    if (role === "LOAN OFFICER") {
        $('#btnCreateAnalysis')
            .removeAttr('data-toggle')
            .removeAttr('data-target')
            .css({
                'opacity': '0.6',
                'cursor': 'not-allowed'
            });

        $('#btnCreateAnalysis')
            .off('click')
            .on('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                showAccessPopup(
                    "Your profile is 'Loan Officer'. You cannot create a new analysis."
                );
                return false;
            });
    }
}  

function showStatusError(message) {
    $('#statusErrorMessage').text(message);
    $('#statusChangeErrorModal').modal('show');
}




