            Dim lngRows As Long = 0
            Dim oCommand As New OracleCommand

            oCommand.Connection = oConn
            oCommand.CommandType = CommandType.Text
            oCommand.CommandText = SqlCommand
            oConn.Open()
            lngRows = oCommand.ExecuteNonQuery()
            oConn.Close()

            oConn.Dispose()

            Return lngRows
        Catch ex As Exception

