        'POST: TaskList - Loading Data To TaskList through filter functions - search, reset, view all
        <HttpPost>
        Public Function TaskList(SelectProjectId As String, SelectUserId As String, Actor As String, SelectCreProject As String, SelectStatus As String, Optional actionType As String = "search") As ActionResult
            Dim sw = Stopwatch.StartNew()
            If User IsNot Nothing AndAlso User.Identity IsNot Nothing Then
                Cur_UserID = User.Identity.Name.ToUpper().Replace("BELWIRED\", "")
            End If

            _logger.Information("TaskList - Request received | Username: {Username}", Cur_UserID)

            ' USER ROLE FROM SESSION  
            Dim userRole As String = Convert.ToString(Session("EffectiveRole"))
            If String.IsNullOrWhiteSpace(userRole) Then
                TempData("SessionError") = "Session expired. Please go back to portal."
                Return RedirectToAction("Index", "Portal")
            End If
            ViewBag.UserRole = userRole

            LoadProfiles()
            Dim tasks As New List(Of TaskListViewModel)
            If actionType.Equals("viewAll", StringComparison.OrdinalIgnoreCase) Then 'view all button functionality
                Dim dropdownData = _repository.GetDropDownData()
                ViewBag.SelectProjectId = New SelectList(If(dropdownData?.ProjectIds, New List(Of String)()))
                ViewBag.SelectUserId = New SelectList(If(dropdownData?.UserIds, New List(Of String)()))
                ViewBag.SelectCreProject = New SelectList(dropdownData.CreProjects, "Key", "Value")
                ViewBag.SelectStatus = New SelectList(dropdownData.ProjectStatuses, "Key", "Value")
                tasks = _repository.GetTaskLists(Nothing)
                _logger.Information("TaskList - Success | User: {User} | ElapsedMs: {ElapsedMs}ms", Cur_UserID, sw.ElapsedMilliseconds)
                Return View(tasks)
            ElseIf actionType.Equals("reset", StringComparison.OrdinalIgnoreCase) Then 'reset button functionality
                Dim filterParam As New TaskListSearchViewModel
                filterParam.UserId = Cur_UserID
                Dim dropdownData = _repository.GetDropDownData()
                ViewBag.SelectProjectId = New SelectList(If(dropdownData?.ProjectIds, New List(Of String)()))
                ViewBag.SelectUserId = New SelectList(If(dropdownData?.UserIds, New List(Of String)()))
                ViewBag.ActorName = String.Empty
                ViewBag.SelectCreProject = New SelectList(dropdownData.CreProjects, "Key", "Value", Nothing)
                ViewBag.SelectStatus = New SelectList(dropdownData.ProjectStatuses, "Key", "Value", Nothing)
                tasks = _repository.GetTaskLists(filterParam)
                ModelState.Clear()
                _logger.Information("TaskList - Success | User: {User} | ElapsedMs: {ElapsedMs}ms", Cur_UserID, sw.ElapsedMilliseconds)
                Return View(tasks)
            Else 'searchUI  button functionality
                Dim creProjectId As Integer? = Nothing
                If Not String.IsNullOrWhiteSpace(SelectCreProject) Then
                    creProjectId = Convert.ToInt32(SelectCreProject)
                End If
                Dim statusId As Integer? = Nothing
                If Not String.IsNullOrWhiteSpace(SelectStatus) Then
                    statusId = Convert.ToInt32(SelectStatus)
                End If
                Dim filters As New TaskListSearchViewModel With {
                    .ProjectID = If(String.IsNullOrWhiteSpace(SelectProjectId), Nothing, SelectProjectId.Trim()),
                    .UserId = If(String.IsNullOrWhiteSpace(SelectUserId), Nothing, SelectUserId.Trim()),
                    .ActorName = If(String.IsNullOrWhiteSpace(Actor), Nothing, Actor.Trim()),
                    .creProjectId = creProjectId,
                    .statusId = statusId
                }
                Dim dropdownData = _repository.GetDropDownData()
                ViewBag.SelectProjectId = New SelectList(If(dropdownData?.ProjectIds, New List(Of String)()), filters.ProjectID)
                ViewBag.SelectUserId = New SelectList(If(dropdownData?.UserIds, New List(Of String)()), filters.UserId)
                ViewBag.Actor = filters.ActorName
                ViewBag.SelectCreProject = New SelectList(dropdownData.CreProjects, "Key", "Value", creProjectId)
                ViewBag.SelectStatus = New SelectList(dropdownData.ProjectStatuses, "Key", "Value", statusId)
                tasks = _repository.GetTaskLists(filters)
                _logger.Information("TaskList - Success | User: {User} | ElapsedMs: {ElapsedMs}ms", Cur_UserID, sw.ElapsedMilliseconds)
                Return View(tasks)
            End If
