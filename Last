    Private Sub MoveToTargetFolder(strFile As String, strCanac As String, strCountry As String, intNbrOrigPages As Integer)

        Dim strOutput As String = objParams.GetParam("EXPORT_PATH")
        Dim strMailOutput As String = objParams.GetParam("EXPORT_PATH_MAIL")
        Dim strPrintOutput As String = objParams.GetParam("EXPORT_PATH_PRINT")
        Dim strDate As String = Now.ToString("yyyyMMdd")
        Dim strCsvFile As String = strFile.Replace(".pdf", "_OverviewAccounts.csv")
        Dim intNbrPages As Integer
        intNbrPages = Math.Ceiling(intNbrOrigPages / 2)

        'CANAC = 02: E-mail / 04: PAPER
        If strCanac = "02" Then

            If Not Directory.Exists(strMailOutput) Then
                Directory.CreateDirectory(strMailOutput)
            End If

            File.Copy(strOutput & strFile, strMailOutput & "\" & strFile, True)
            If File.Exists(strOutput & strCsvFile) Then
                File.Copy(strOutput & strCsvFile, strMailOutput & "\" & strCsvFile, True)
            End If

        Else

            If strCountry = "BE" Then

                If Not Directory.Exists(strPrintOutput & strDate & "\BINN\" & intNbrPages & "_SHEETS") Then
                    Directory.CreateDirectory(strPrintOutput & strDate & "\BINN\" & intNbrPages & "_SHEETS")
                End If
                File.Copy(strOutput & strFile, strPrintOutput & strDate & "\BINN\" & intNbrPages & "_SHEETS\" & strFile)

            Else

                If Not Directory.Exists(strPrintOutput & strDate & "\BUIT\" & intNbrPages & "_SHEETS") Then
                    Directory.CreateDirectory(strPrintOutput & strDate & "\BUIT\" & intNbrPages & "_SHEETS")
                End If
                File.Copy(strOutput & strFile, strPrintOutput & strDate & "\BUIT\" & intNbrPages & "_SHEETS\" & strFile)

            End If

        End If

    End Sub

