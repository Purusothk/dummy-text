    'Check Actor Id via Stored Proc
    Public Function GetActorDetails(actorId As String) As ActorLookupResult Implements ITaskListRepository.GetActorDetails
        Dim sw = Stopwatch.StartNew()
        _logger.Information("GetActorDetails - SP call started | Username: {Username}", Cur_UserID)
        Dim result As New ActorLookupResult With {
            .Exists = False,
            .ActorName = String.Empty,
            .CI = Nothing}
        Dim My_SQL_Str As String = " WHERE NR_IDACT_217ACTR = '" & actorId & "'"
        Using conn As OracleConnection = _dbContext.CreateConnection()
            conn.Open()

            Using cmd As New OracleCommand()
                cmd.Connection = conn
                cmd.CommandText = "QRER.PKG_SCREEN_TASKLIST.SP_Get_GEI1_I1ACTRA1_JSON"
                cmd.CommandType = CommandType.StoredProcedure
                'Input Parameters
                cmd.Parameters.Add("P_Formname", OracleDbType.Varchar2).Value = "TaskList"
                cmd.Parameters.Add("P_username", OracleDbType.Varchar2).Value = Cur_UserID
                cmd.Parameters.Add("P_qry_ID", OracleDbType.Int32).Value = 1
                cmd.Parameters.Add("P_condition", OracleDbType.Varchar2).Value = My_SQL_Str
                'Output parameters
                Dim outparam As New OracleParameter("p_JSON_GEI1_I1ACTRA1_OUT", OracleDbType.Clob)
                outparam.Direction = ParameterDirection.Output
                cmd.Parameters.Add(outparam)
                cmd.ExecuteNonQuery()
                Dim jsonString As String = String.Empty

                If outparam.Value IsNot Nothing AndAlso Not Convert.IsDBNull(outparam.Value) Then
                    If TypeOf outparam.Value Is OracleClob Then
                        Dim jsonClob As OracleClob = DirectCast(outparam.Value, OracleClob)
                        If Not jsonClob.IsNull Then
                            jsonString = jsonClob.Value
                        End If
                    ElseIf TypeOf outparam.Value Is String Then
                        jsonString = DirectCast(outparam.Value, String)
                    End If
                End If
                If Not String.IsNullOrEmpty(jsonString) Then
                    Dim actors = JsonConvert.DeserializeObject(Of List(Of ActorModel))(jsonString)
                    If actors.Count > 0 Then
                        result.Exists = True
                        Dim firstActor = actors(0)
                        result.ActorName = String.Join(" ", New String() {firstActor.NM_FSTNAME_2177001, firstActor.NM_NAME1_2177001, firstActor.NM_NAME2_2177001}.Where(Function(s) Not String.IsNullOrWhiteSpace(s)))
                    End If
                End If
            End Using
            ' fetch Ci using ActorId
            Using cmd As New OracleCommand()
                cmd.Connection = conn
                cmd.CommandText = "QRER.PKG_SCREEN_TASKLIST.SP_Get_KRRF_RFROLEHD_JSON"
                cmd.CommandType = CommandType.StoredProcedure
                'Input Parameters
                cmd.Parameters.Add("P_Formname", OracleDbType.Varchar2).Value = "TaskList"
                cmd.Parameters.Add("P_username", OracleDbType.Varchar2).Value = Cur_UserID
                cmd.Parameters.Add("P_qry_ID", OracleDbType.Int32).Value = DBNull.Value
                cmd.Parameters.Add("P_condition", OracleDbType.Varchar2).Value = actorId
                'Output parameters
                Dim outparam As New OracleParameter("p_JSON_KRRF_RFROLEHD_OUT", OracleDbType.Clob)
                outparam.Direction = ParameterDirection.Output
                cmd.Parameters.Add(outparam)
                cmd.ExecuteNonQuery()
                'Processing the output
                If outparam.Value IsNot Nothing AndAlso Not Convert.IsDBNull(outparam.Value) Then
                    Try
                        Dim jsonString As String

                        If TypeOf outparam.Value Is OracleClob Then
                            Dim clob As OracleClob = DirectCast(outparam.Value, OracleClob)
                            jsonString = clob.Value
                        Else
                            jsonString = outparam.Value.ToString()
                        End If

                        If Not String.IsNullOrEmpty(jsonString) Then
                            Dim data = JsonConvert.DeserializeObject(Of List(Of Dictionary(Of String, String)))(jsonString)
                            If data IsNot Nothing AndAlso data.Count > 0 AndAlso data(0).ContainsKey("CI") Then
