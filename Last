'TaskList repository - Data fetching for TaskList View
Public Class TaskListRepository
    Implements ITaskListRepository

    Private ReadOnly _dbContext As OracleDbContext
    Private ReadOnly _logger As ILogger

    Public Sub New()
        _dbContext = OracleDbContext.GetInstance()
        _logger = Log.ForContext(Of TaskListRepository)()
    End Sub

    Dim Cur_UserID As String = HttpContext.Current.User.Identity.Name.ToUpper().Replace("BELWIRED\", "")

    'AnalyseId and UserId Dropdown data fetching for TaskList Screen
    Public Function GetDropDownData() As DropDownsViewModel Implements ITaskListRepository.GetDropDownData
        Dim sw = Stopwatch.StartNew()
        _logger.Information("GetDropDownData - SP call started | Username: {Username}", Cur_UserID)
        Dim tasklist As New List(Of TaskListViewModel)()
        Dim tcodlist As New List(Of TcodViewModel)()
        Dim dropDownData As New DropDownsViewModel

        Using conn As OracleConnection = _dbContext.CreateConnection()
            conn.Open()
            'DB call to RE_PROJ Table
            Using cmd As New OracleCommand()
                cmd.Connection = conn
                cmd.CommandText = "QRER.PKG_SCREEN_TASKLIST.SP_Get_RE_PROJ_JSON"
                cmd.CommandType = CommandType.StoredProcedure
                'Input Parameters
                cmd.Parameters.Add("P_Formname", OracleDbType.Varchar2).Value = "TaskList"
                cmd.Parameters.Add("P_username", OracleDbType.Varchar2).Value = Cur_UserID
                cmd.Parameters.Add("P_qry_ID", OracleDbType.Int32).Value = 2
                cmd.Parameters.Add("P_condition", OracleDbType.Varchar2).Value = Nothing
                'Output parameters
                Dim outparam As New OracleParameter("p_json_re_proj_out", OracleDbType.Clob)
                outparam.Direction = ParameterDirection.Output
                cmd.Parameters.Add(outparam)
                cmd.ExecuteNonQuery()
                Dim jsonString As String = String.Empty

                If outparam.Value IsNot Nothing AndAlso Not Convert.IsDBNull(outparam.Value) Then
                    If TypeOf outparam.Value Is OracleClob Then
                        Dim jsonClob As OracleClob = DirectCast(outparam.Value, OracleClob)
                        If Not jsonClob.IsNull Then
                            jsonString = jsonClob.Value
                        End If
                    ElseIf TypeOf outparam.Value Is String Then
                        jsonString = DirectCast(outparam.Value, String)
                    End If
                End If
                If Not String.IsNullOrEmpty(jsonString) Then
                    tasklist = JsonConvert.DeserializeObject(Of List(Of TaskListViewModel))(jsonString)
                    dropDownData.ProjectIds = tasklist.OrderByDescending(Function(x) x.RE_PROJ_ID).Select(Function(x) x.RE_PROJ_ID.ToString()).Distinct().ToList()
                    dropDownData.UserIds = tasklist.Where(Function(x) Not String.IsNullOrEmpty(x.RE_PROJ_STATUS_USER_ID)).Select(Function(x) x.RE_PROJ_STATUS_USER_ID.ToUpper()).Distinct().OrderBy(Function(uid) uid).ToList()
                End If
            End Using

            'DB Call to RE_TCOD table
            Using cmd As New OracleCommand()
                cmd.Connection = conn
                cmd.CommandText = "QRER.Pkg_table_RE_TCOD.SP_Get_RE_TCOD_JSON"
                cmd.CommandType = CommandType.StoredProcedure
                'Input Parameters
                cmd.Parameters.Add("P_Formname", OracleDbType.Varchar2).Value = "TaskList"
                cmd.Parameters.Add("P_username", OracleDbType.Varchar2).Value = Cur_UserID
                cmd.Parameters.Add("P_qry_ID", OracleDbType.Int32).Value = 1
                'Output parameters
                Dim outparam As New OracleParameter("p_json_re_tcod_out", OracleDbType.Clob)
                outparam.Direction = ParameterDirection.Output
                cmd.Parameters.Add(outparam)
                cmd.ExecuteNonQuery()
                Dim jsonString As String = String.Empty

                If outparam.Value IsNot Nothing AndAlso Not Convert.IsDBNull(outparam.Value) Then
                    If TypeOf outparam.Value Is OracleClob Then
                        Dim jsonClob As OracleClob = DirectCast(outparam.Value, OracleClob)
                        If Not jsonClob.IsNull Then
                            jsonString = jsonClob.Value
                        End If
                    ElseIf TypeOf outparam.Value Is String Then
                        jsonString = DirectCast(outparam.Value, String)
                    End If
                End If
                If Not String.IsNullOrEmpty(jsonString) Then
                    tcodlist = JsonConvert.DeserializeObject(Of List(Of TcodViewModel))(jsonString)
                    dropDownData.CreProjects = tcodlist.Where(Function(x) x.RE_TCOD_CAT_NM = "COMMERCIAL RE PROJECT").OrderBy(Function(x) x.RE_TCOD_ID).Select(Function(x) New KeyValuePair(Of Integer, String)(x.RE_TCOD_ID, x.RE_TCOD_DESC_NM)).ToList()
                    dropDownData.ProjectStatuses = tcodlist.Where(Function(x) x.RE_TCOD_CAT_NM = "PROJECT STATUS").OrderBy(Function(x) x.RE_TCOD_ID).Select(Function(x) New KeyValuePair(Of Integer, String)(x.RE_TCOD_ID, x.RE_TCOD_DESC_NM)).ToList()
                End If
            End Using
        End Using
        _logger.Information("GetDropDownData - SP executed | User: {User} | ElapsedMs: {ElapsedMs}ms", Cur_UserID, sw.ElapsedMilliseconds)
        Return dropDownData
    End Function


    'Data fetching for Table data in TaskList Screen
    Public Function GetTaskLists(strSearch As TaskListSearchViewModel) As List(Of TaskListViewModel) Implements ITaskListRepository.GetTaskLists
        Dim sw = Stopwatch.StartNew()
        _logger.Information("GetTaskLists - SP Call started | Username: {Username}", Cur_UserID)
        Dim tasklist As New List(Of TaskListViewModel)()
        Dim My_SQL_Str As String = "WHERE 1=1"
        'Customizing the query conditions based of filter parameters
        If strSearch IsNot Nothing Then
            If strSearch.UserId = "All" Then
                'do nothing
            Else

                If strSearch.UserId <> "" Then
                    My_SQL_Str &= " and lower(P.RE_PROJ_STATUS_USER_ID) = '" & strSearch.UserId & "'"
                End If

                If strSearch.ActorName <> "" Then
                    My_SQL_Str &= " and lower(M.ACTORNAME) like '%" & strSearch.ActorName & "%'"
                End If

                If strSearch.CreProjectId > 0 Then
                    My_SQL_Str &= " and PC.RE_PRCR_COMMERCIAL_RE_PRJ_ID = '" & strSearch.CreProjectId & "'"
                End If

                If strSearch.StatusId >= 0 Then
                    My_SQL_Str &= " and P.RE_PROJ_STATUS_ID = '" & strSearch.StatusId & "'"
                End If

                If strSearch.ProjectID <> "" Then
                    My_SQL_Str &= " and P.RE_PROJ_ID = '" & strSearch.ProjectID & "'"
                End If

            End If

        End If

        'My_SQL_Str &= " order by P.RE_PROJ_ID Desc"

        Using conn As OracleConnection = _dbContext.CreateConnection()
            conn.Open()

            Using cmd As New OracleCommand()
                cmd.Connection = conn
                cmd.CommandText = "QRER.PKG_SCREEN_TASKLIST.SP_Get_RE_PROJ_JSON"
                cmd.CommandType = CommandType.StoredProcedure
                'Input Parameters
                cmd.Parameters.Add("P_Formname", OracleDbType.Varchar2).Value = "TaskList"
                cmd.Parameters.Add("P_username", OracleDbType.Varchar2).Value = Cur_UserID
                cmd.Parameters.Add("P_qry_ID", OracleDbType.Int32).Value = 2
                cmd.Parameters.Add("P_condition", OracleDbType.Varchar2).Value = My_SQL_Str
                'Output parameters
                Dim outparam As New OracleParameter("p_json_re_proj_out", OracleDbType.Clob)
                outparam.Direction = ParameterDirection.Output
                cmd.Parameters.Add(outparam)
                cmd.ExecuteNonQuery()
                'Dim jsonClob As OracleClob = CType(outparam.Value.Value, OracleClob)
                Dim jsonString As String = String.Empty

                If outparam.Value IsNot Nothing AndAlso Not Convert.IsDBNull(outparam.Value) Then
                    If TypeOf outparam.Value Is OracleClob Then
                        Dim jsonClob As OracleClob = DirectCast(outparam.Value, OracleClob)
                        If Not jsonClob.IsNull Then
                            jsonString = jsonClob.Value
                        End If
                    ElseIf TypeOf outparam.Value Is String Then
                        jsonString = DirectCast(outparam.Value, String)
                    End If
                End If
                If Not String.IsNullOrEmpty(jsonString) Then
                    tasklist = JsonConvert.DeserializeObject(Of List(Of TaskListViewModel))(jsonString)
                    tasklist = tasklist.OrderByDescending(Function(x) x.RE_PROJ_ID).ToList() 'Sorting the Data by descending order
                End If
            End Using
        End Using
        _logger.Information("GetTaskLists - SP executed | User: {User} | ElapsedMs: {ElapsedMs}ms", Cur_UserID, sw.ElapsedMilliseconds)
        Return tasklist
    End Function

