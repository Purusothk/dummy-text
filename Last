                        if (input.type === 'text' && input.getAttribute('tag') === 'MyNumber') {

                            let start = input.selectionStart;
                            let end = input.selectionEnd;
                            let value = input.value;
                            let unformattedNumber = value.replace(/\./g, '').replace(/,/g, '.');
                            input.value = unformattedNumber;
                            input.setSelectionRange(start, end);

                        }
                    }
                }

                window.unFormatThisNumber = function (input) {
                    var value = input.value;
                    value = value.replace(/\./g, '');  // Replace all dots with nothing
