        <HttpPost>
        Public Function SetProfile(profile As String) As JsonResult
            Dim userName = If(User.Identity.Name.ToUpper().Replace("BELWIRED\", ""), "Anonymous")
            ' Empty profile
            If String.IsNullOrWhiteSpace(profile) Then
                _logger.Warning("SetProfile - Empty profile received | User: {User}", userName)
                Return Json(New With {.success = False, .message = "Profile cannot be empty"})
            End If

            Dim previousRole = Convert.ToString(Session("EffectiveRole"))
            Dim previousProfile = Convert.ToString(Session("SelectedProfile"))

            Session("SelectedProfile") = profile

            Dim newRole As String = ""
            Select Case profile.Trim().ToUpper()
                Case "CLS A&D"
                    newRole = "ANALYST"
                    Session("EffectiveRole") = newRole
                Case "CLS C&S"
                    newRole = "LOAN OFFICER"
                    Session("EffectiveRole") = newRole
                Case "SUPER USER"
                    newRole = "SUPER USER"
                    Session("EffectiveRole") = newRole
                Case "CRE EXPERT"
                    newRole = "CRE EXPERT"
                    Session("EffectiveRole") = newRole
                Case Else
                    ' Unknown profile
                    _logger.Warning("SetProfile - Unknown profile received | User: {User} | Profile: {Profile}",
                    userName, profile)
            End Select
            ' Profile changed
            _logger.Information("SetProfile - Profile changed | User: {User} | PreviousProfile: {PrevProfile} | NewProfile: {NewProfile} | PreviousRole: {PrevRole} | NewRole: {NewRole}",
                                userName, previousProfile, profile, previousRole, newRole)


            Return Json(New With {.success = True})
        End Function


