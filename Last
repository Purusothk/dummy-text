    Public Function SaveProject(projectData As SaveNewAnalysisWrapper) As Boolean Implements ITaskListRepository.SaveProject
        Dim sw = Stopwatch.StartNew()
        _logger.Information("SaveProject - SP call started | Username: {Username}", Cur_UserID)
        Dim saved As Boolean = True
        Dim jsonMADB As String = JsonConvert.SerializeObject(projectData.MADB)
        Dim jsonLOGG As String = JsonConvert.SerializeObject(projectData.LOGG)
        Dim jsonPROJ As String = JsonConvert.SerializeObject(projectData.PROJ)
        Dim jsonPRCR As String = JsonConvert.SerializeObject(projectData.PRCR)

        Try
            Using conn As OracleConnection = _dbContext.CreateConnection()
                conn.Open()
                Dim createAnalysisSuccess As Boolean = False
                Using cmd As New OracleCommand()
                    cmd.Connection = conn
                    cmd.CommandText = "QRER. PKG_SCREEN_TASKLIST.SP_CREATE_NEW_ANALYSIS"
                    cmd.CommandType = CommandType.StoredProcedure
                    'Input Parameters
                    cmd.Parameters.Add("P_Formname", OracleDbType.Varchar2).Value = "TaskList"
                    cmd.Parameters.Add("P_username", OracleDbType.Varchar2).Value = Cur_UserID
                    cmd.Parameters.Add("P_qry_ID", OracleDbType.Int32).Value = 1
                    cmd.Parameters.Add("p_json_re_madb_IN", OracleDbType.Varchar2).Value = jsonMADB
                    cmd.Parameters.Add("p_json_re_proj_IN", OracleDbType.Varchar2).Value = jsonPROJ
                    cmd.Parameters.Add("p_json_re_prcr_IN", OracleDbType.Varchar2).Value = jsonPRCR
                    'Output parameters
                    Dim outparam As New OracleParameter("p_json_re_madb_OUT", OracleDbType.Clob)
                    outparam.Direction = ParameterDirection.Output
                    cmd.Parameters.Add(outparam)
                    cmd.ExecuteNonQuery()
                    If outparam.Value IsNot Nothing AndAlso Not Convert.IsDBNull(outparam.Value) Then
                        Try
                            Dim jsonString As String

                            If TypeOf outparam.Value Is OracleClob Then
                                Dim clob As OracleClob = DirectCast(outparam.Value, OracleClob)
                                jsonString = clob.Value
                            Else
                                jsonString = outparam.Value.ToString()
                            End If

                            If Not String.IsNullOrEmpty(jsonString) Then
                                Dim data = JsonConvert.DeserializeObject(Of List(Of Dictionary(Of String, String)))(jsonString)
                                If data IsNot Nothing AndAlso data.Count > 0 AndAlso data(0).ContainsKey("STATUS") AndAlso String.Equals(data(0)("STATUS"), "SUCCESS", StringComparison.OrdinalIgnoreCase) Then
                                    createAnalysisSuccess = True
                                End If
                            End If
                        Catch ex As Exception
                            Console.WriteLine("Error processing output: " & ex.Message)
                        End Try
                    End If
                End Using
                'LOGG DB CALL only if create analysis succeeded
                If createAnalysisSuccess Then
                    Using cmd As New OracleCommand()
                        cmd.Connection = conn
                        cmd.CommandText = "QRER.Pkg_table_RE_LOGG.SP_put_RE_Logg"
                        cmd.CommandType = CommandType.StoredProcedure
                        'Input Parameters
                        cmd.Parameters.Add("P_Formname", OracleDbType.Varchar2).Value = "TaskList"
                        cmd.Parameters.Add("P_username", OracleDbType.Varchar2).Value = Cur_UserID
                        cmd.Parameters.Add("p_JSON_re_logg_IN", OracleDbType.Varchar2).Value = jsonLOGG
                        cmd.ExecuteNonQuery()
                    End Using
                    saved = True
                End If
            End Using
        Catch ex As Exception
            saved = False
        End Try
        _logger.Information("SaveProject - SP executed | User: {User} | ElapsedMs: {ElapsedMs}ms", Cur_UserID, sw.ElapsedMilliseconds)
        Return saved
    End Function

    Public Function ChangeProjectStatus(projectId As Integer, oldStatusId As Integer, oldStatusFlowid As Integer, newStatusId As Integer) As StatusChangeResult Implements ITaskListRepository.ChangeProjectStatus
        Dim sw = Stopwatch.StartNew()
        _logger.Information("ChangeProjectStatus - SP call started | Username: {Username}", Cur_UserID)
        Dim result As New StatusChangeResult

        Try
            Using conn As OracleConnection = _dbContext.CreateConnection()
                conn.Open()

                Using cmd As New OracleCommand()
                    cmd.Connection = conn
                    cmd.CommandText = "QRER.PKG_GENERIC_ACTIONS.SP_Ins_StatusID_flowID_change"
                    cmd.CommandType = CommandType.StoredProcedure
                    'Input Parameters
                    cmd.Parameters.Add("P_Username", OracleDbType.Varchar2).Value = Cur_UserID
                    cmd.Parameters.Add("P_RE_PROJ_ID", OracleDbType.Int32).Value = projectId
                    cmd.Parameters.Add("P_OLD_PROJ_STATUS_ID", OracleDbType.Int32).Value = oldStatusId
                    cmd.Parameters.Add("P_OLD_PROJ_STATUS_FLOW_ID", OracleDbType.Int32).Value = oldStatusFlowid
                    cmd.Parameters.Add("P_NEW_PROJ_STATUS_ID", OracleDbType.Int32).Value = newStatusId
                    ' Output Parameters
                    Dim outPutData As New OracleParameter("P_STATUS_CHANGE_JSON", OracleDbType.Clob)
                    outPutData.Direction = ParameterDirection.Output
                    cmd.Parameters.Add(outPutData)
                    cmd.ExecuteNonQuery()

                    If outPutData.Value IsNot Nothing AndAlso Not Convert.IsDBNull(outPutData.Value) Then
                        Try
                            Dim jsonString As String

                            If TypeOf outPutData.Value Is OracleClob Then
                                Dim clob As OracleClob = DirectCast(outPutData.Value, OracleClob)
                                jsonString = clob.Value
                            Else
                                jsonString = outPutData.Value.ToString()
                            End If

                            _logger.Information("ChangeProjectStatus - SP raw output | User:{User} | Proj:{Proj} | Old:{Old} | OldFlow:{OldFlow} | New:{New} | Json:{Json}",
                                               Cur_UserID, projectId, oldStatusId, oldStatusFlowid, newStatusId, jsonString)

                            If Not String.IsNullOrEmpty(jsonString) Then
                                Dim list = JsonConvert.DeserializeObject(Of List(Of StatusChangeResult))(jsonString)
                                If list IsNot Nothing AndAlso list.Any() Then
                                    result = list.First()
                                End If
                            End If
                        Catch ex As Exception
                            _logger.Error(ex, "ChangeProjectStatus - Error processing SP output | User:{User} | Proj:{Proj} | Old:{Old} | New:{New}",
                                          Cur_UserID, projectId, oldStatusId, newStatusId)
                        End Try
                    Else
                        _logger.Warning("ChangeProjectStatus - SP returned null/empty output | User:{User} | Proj:{Proj} | Old:{Old} | OldFlow:{OldFlow} | New:{New}",
                                        Cur_UserID, projectId, oldStatusId, oldStatusFlowid, newStatusId)
                    End If
                End Using
            End Using

        Catch ex As Exception
            Throw New Exception("Error executing SP_Ins_StatusID_flowID_change", ex)
        End Try
        _logger.Information("ChangeProjectStatus - SP executed | User: {User} | ElapsedMs: {ElapsedMs}ms", Cur_UserID, sw.ElapsedMilliseconds)
        Return result
    End Function

