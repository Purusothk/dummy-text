            <script>
                function formatAllTextboxes() {

                    var inputs = document.getElementsByTagName('input');

                    for (var i = 0; i < inputs.length; i++) {
                        var input = inputs[i]

                        if (input.type === 'text' && input.getAttribute('tag') === 'MyNumber') {

                            let start = input.selectionStart;
                            let end = input.selectionEnd;
                            let value = parseFloat(input.value.replace(',', '.'));

                            let integerPart = Math.floor(value);
                            let decimalPart = value - integerPart;
                            let formattedIntegerPart = integerPart.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".");
                            let formattedNumber = formattedIntegerPart;

                            if (decimalPart > 0) {
                                let roundedDecimalPart = decimalPart.toFixed(2);
                                let decimalString = roundedDecimalPart.substring(2);
                                formattedNumber = formattedIntegerPart + "," + decimalString;
                            }

                            input.value = formattedNumber;

                            input.setSelectionRange(start, end);
                        }
                    }
                }

                function formatPercentage() {

                    var inputs = document.querySelectorAll('input[tag3="MyPct"]');

                    for (var i = 0; i < inputs.length; i++) {
                        var textbox = inputs[i];
                        textbox.value = textbox.value + " %";
                    }
                }

                function unformatAllTextboxes() {

                    var inputs = document.getElementsByTagName('input');

                    for (var i = 0; i < inputs.length; i++) {

