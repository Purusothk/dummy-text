               userName, ex.Message, sw.ElapsedMilliseconds)
                Return Json(New With {
                            .success = False,
                            .message = ex.Message
                })
            Catch ex As Exception
                sw.Stop()
                ' Unexpected error
                _logger.Error(ex, "SaveCollateral - Unhandled exception | User: {User} | ElapsedMs: {ElapsedMs}ms",
