// Function to initialize Project Credits Tab
function initializeProjectCreditsTab() {

    AnalysisScreen.isProjectCreditsDataDirty = false;
    AnalysisScreen.isProjectCreditsInitializing = true;
    AnalysisScreen.isProjectCreditsSaving = false;
    AnalysisScreen.originalGaraniteBreyne = null;

    // Number Formatting (shared helpers from currencyformatter.js)
    var formatNumber = NumberFormat.formatNumber;
    var parseNumber = NumberFormat.parseNumber;

    // Initialize formatted number inputs
    new FormattedNumberInput('.formatted-number');

    // Class to handle calculated fields
    class CalculatedField {
        constructor(selector, calculationFunction) {
            this.selector = selector;
            this.calculationFunction = calculationFunction;
        }

        update() {
            let result = this.calculationFunction();
            $(this.selector).val(formatNumber(result));
        }
    }

    // Class to handle duration inputs (only numbers, no decimals, range 0 to 999)
    class DurationInput {
        constructor(selector) {
            this.selector = selector;
            this.initialize();
        }

        initialize() {
            $(this.selector).on('input', (e) => {
                let value = $(e.target).val();
                // Remove any non-numeric characters
                let sanitizedValue = value.replace(/[^0-9]/g, '');
                $(e.target).val(sanitizedValue);
            });

            $(this.selector).on('blur', (e) => {
                let value = $(e.target).val();
                let parsedValue = parseInt(value, 10);
                if (!isNaN(parsedValue)) {
                    // Ensure the value is within the range of 0 to 999
                    if (parsedValue < 0) {
                        parsedValue = 0;
                    } else if (parsedValue > 999) {
                        parsedValue = 999;
                    }
                    $(e.target).val(parsedValue);
                    // Trigger the change event to update dependent fields
                    $(e.target).trigger('change');
                }
            });

            // Format the initial value
            $(this.selector).each((index, element) => {
                let initialValue = $(element).val();
                if (initialValue) {
                    let parsedValue = parseInt(initialValue, 10);
                    if (!isNaN(parsedValue)) {
                        // Ensure the value is within the range of 0 to 999
                        if (parsedValue < 0) {
                            parsedValue = 0;
                        } else if (parsedValue > 999) {
                            parsedValue = 999;
                        }
                        $(element).val(parsedValue);
                    }
                }
            });
        }
    }

    // Initialize duration inputs
    new DurationInput('.duration-input');

    // Class to handle credit card number inputs (format xxx-xxxxxxx-xx)
    class CreditCardInput {
        constructor(selector) {
            this.selector = selector;
            this.initialize();
        }

        initialize() {
            $(this.selector).on('input', (e) => {
                const $el = $(e.target);
                clearSpecificFieldErrors($el);
                let value = $el.val();
                // Remove any non-numeric characters
                let sanitizedValue = value.replace(/[^0-9]/g, '');

                // Apply the credit card format xxx-xxxxxxx-xx
                let formattedValue = this.formatCreditCardNumber(sanitizedValue);
                $el.val(formattedValue);
            });

            $(this.selector).on('blur', (e) => {
                const $el = $(e.target);
                let value = $el.val();
                // Remove hyphens for validation
                let sanitizedValue = value.replace(/[^0-9]/g, '');

                // Check if the sanitized value has the correct length (12 digits for xxx-xxxxxxx-xx)
                if (sanitizedValue.length >0 && sanitizedValue.length!== 12) {
                    // If the length is not correct, clear the field or show an error                    
                    setFieldError($el, 'Please enter a valid number (format: XXX-XXXXXXX-XX)');
                    $el.val('');
                } else {
                    // Reformat the value to ensure it follows the xxx-xxxxxxx-xx format
                    let formattedValue = this.formatCreditCardNumber(sanitizedValue);
                    $el.val(formattedValue);
                }
            });

            // Format the initial value
            $(this.selector).each((_, element) => {
                const $el = $(element);
                let initialValue = $el.val();
                if (initialValue) {
                    let sanitizedValue = initialValue.replace(/[^0-9]/g, '');
                    let formattedValue = this.formatCreditCardNumber(sanitizedValue);
                    $el.val(formattedValue);
                }
            });
        }

        formatCreditCardNumber(value) {
            // Remove any non-numeric characters
            let sanitizedValue = value.replace(/[^0-9]/g, '');

            // Apply the credit card format xxx-xxxxxxx-xx
            let formattedValue = '';
            if (sanitizedValue.length > 0) {
                formattedValue += sanitizedValue.substring(0, 3);
            }
            if (sanitizedValue.length > 3) {
                formattedValue += '-' + sanitizedValue.substring(3, 10);
            }
            if (sanitizedValue.length > 10) {
                formattedValue += '-' + sanitizedValue.substring(10, 12);
            }

            return formattedValue;
        }
    }

    // Initialize credit card number inputs
    new CreditCardInput('.credit-card-input');

    class LineCreditInput {
        constructor(selector) {
            this.selector = selector;
            this.initialize();
        }

        initialize() {

            $(this.selector).on('input', (e) => {

                const $el = $(e.target);
                clearSpecificFieldErrors($el);
                let value = $el.val();
                let digits = value.replace(/[^0-9]/g, '');
                digits = digits.substring(0, 11);
                let formatted = '';

                if (digits.length > 0) {
                    formatted += digits.substring(0, 8);
                }

                if (digits.length > 8) {
                    formatted += '/' + digits.substring(8, 11);
                }

                $el.val(formatted);
            });

            $(this.selector).on('blur', (e) => {

                const $el = $(e.target);
                let digits = $el.val().replace(/[^0-9]/g, '');

                if (digits.length > 0 && digits.length !== 11) {

                    setFieldError(
                        $el,
                        'Please enter a valid number (format: XXXXXXXX/XXX)'
                    );

                    $el.val('');
                } else {
                    let formatted = '';

                    if (digits.length > 0) {
                        formatted += digits.substring(0, 8);
                    }

                    if (digits.length > 8) {
                        formatted += '/' + digits.substring(8, 11);
                    }
                    $el.val(formatted);
                }
            });

            $(this.selector).each((_, element) => {

                const $el = $(element);
                let initialValue = $el.val();

                if (initialValue) {

                    let digits = initialValue.replace(/[^0-9]/g, '');
                    digits = digits.substring(0, 11);

                    let formatted = '';

                    if (digits.length > 0) {
                        formatted += digits.substring(0, 8);
                    }

                    if (digits.length > 8) {
                        formatted += '/' + digits.substring(8, 11);
                    }

                    $el.val(formatted);
                }
            });
        }
    }

    new LineCreditInput('.line-credit-input');

    // Format the date to dd-mm-yyyy format to store in db
    function formatDateToOracle(input) {
        if (!input) return null;
        let d = new Date(input);
        if (isNaN(d)) return null;

        let dd = String(d.getDate()).padStart(2, '0');
        let mm = String(d.getMonth() + 1).padStart(2, '0');
        let yyyy = d.getFullYear();

        return `${dd}-${mm}-${yyyy}`;
    }

    function formatDdMmYyDateTimeToInputDate(input) {
        if (!input) return '';

        // Expected format: "13-02-2026 19:05:46"
        var datePart = input.split(' ')[0]; // "13-02-2026"
        var parts = datePart.split('-');

        if (parts.length !== 3) {
            return '';
        }

        var dd = parts[0];
        var mm = parts[1];
        var yyyy = parts[2];

        return yyyy + '-' + mm + '-' + dd; // "2026-02-13"
    }

    function prefillFromServer() {

        var raw = $('#project-credits-data').val();
        if (!raw) return;

        var data;
        
        try {
            data = JSON.parse(raw);
        } catch (e) {
            console.error('Invalid JSON in project-credits-data', e);
            //showWarningMessage('Data Invalid', e || 'Invalid JSON in project-credits-data');
            return;
        }

        var sponsorId = data.SponsorID
        // Create dynamic rows (without wiping prefilled values). Ensure toggleFields(true) does not call resetAllValues().
        toggleFields(sponsorId);
        
        // --- Project costs: fill by data-cost-id ---
        if (Array.isArray(data.BelfiusProjectCostsData)) {
            data.BelfiusProjectCostsData.forEach(function (cost) {
                var selector = '.project-cost-input[data-cost-id="' + cost.CostId + '"]';
                var $input = $(selector);
                if ($input.length) {
                    $input.val(cost.CostAmount).data('prefilled', true).trigger('blur');
                }
            });
        }


        var credits = Array.isArray(data.BelfiusCreditData) ? data.BelfiusCreditData : [];
        var rows = [
            $('#belfius-credit-1'),
            $('#belfius-credit-2'),
            $('#belfius-credit-3'),
            $('#belfius-credit-ground'),
            $('#belfius-credit-garanite-breyne')
        ];

        function fillRow($row, cred) {
            if (!$row || !$row.length || !cred) return;
            var slotId = cred.CreditId || cred.RE_CRED_ID || cred.RE_CRED_ID;
            if (slotId)
                $row.attr('data-credit-id', slotId).data('credit-id', slotId);
            //if (cred.CreditId) $row.attr('data-credit-id', cred.CreditId).data('credit-id', cred.CreditId);
            var r = function (sel, val, isSelect) {
                var $el = $row.find(sel);
                if (!$el.length) return;
                if (val == null || val === '') return;
                $el.val(val).data('prefilled', true);
                if (isSelect) $el.trigger('change'); else $el.trigger('blur');
            };

            r('[data-role="breyne-percentage"]', cred.PercentageGarantyBreyneId, true);
            r('[data-role="amount"]', cred.CreditAmount);
            r('[data-role="duration"]', cred.CreditDuration);
            r('[data-role="capital-grace"]', cred.CredCapitalGrace);
            r('[data-role="credit-identifier"]', cred.CreditIdentifier, true);
            r('[data-role="credit-number"]', cred.CreditCardNumber);
            r('[data-role="purpose"]', cred.CreditPurposeId, true);
            r('[data-role="type"]', cred.CreditTypeId, true);
        }

        var unmatched = [];
        credits.forEach(function (cred) {
            var slot = cred.CreditId || cred.RE_CRED_ID || null;
            if (slot) {
                var $match = $('[data-credit-id="' + slot + '"]').first();
                if ($match.length) { fillRow($match, cred); return; }
            }

            unmatched.push(cred);
        });

        var ri = 0;

        unmatched.forEach(function (cred) {
            while (ri < rows.length && rows[ri].length && rows[ri].data('credit-id')) ri++;
            if (ri >= rows.length) { console.warn('Extra Belfius credit ignored:', cred); return; }
            fillRow(rows[ri], cred);
            ri++;
        });

        // --- Final recalculations ---
        calculateTotalSum();
        updateBelfiusTotalCredit();
        updateOwnFunds();
        updatePreSales();
        updateTotalFunds();
        updateTotalCreditCharges();
        updateTotalFundsMinusCosts();
    }

   
    // Function to toggle the dropdowns based on CRE Project selection
    function toggleFields(sponsorId) {

        // Keep track of fields that are allowed to be visible
        var allowedFields = new Set();

        //Getting CRE Project dropdown value
        var creProjectValue = $('#cre-project-options').val();
        var creTypeValue = $('#cre-type-options').val();
        var projectGoalValue = $('#project-goal-options').val();
        
        function allow(fieldId) {
            allowedFields.add(fieldId);
            $('#' + fieldId).show();
        }

        // Enable fields based on conditions
        if (creProjectValue != 1 && creProjectValue != 2 && creProjectValue != 3) {
            $('#number-of-products').prop('disabled', true).addClass('disabled-dropdown').val('1');
        }
        if (creProjectValue == 2 || creProjectValue == 3) {
            allow('breyne-law-field');
            allow('ground-building-split-field');
            allow('pre-sales-field');
            allow('deposit-pre-sales-field');
            allow('signed-pre-sales-field');
            allow('building-issues-field');
            $('#number-of-products').prop('disabled', false).removeClass('disabled-dropdown');
        }
        if (creProjectValue == 1) {
            allow('total-credit-charges-field');
            allow('credit-charge-capital-field');
            allow('credit-charge-interest-field');
            $('#number-of-products').prop('disabled', false).removeClass('disabled-dropdown');
        }
        if ((creProjectValue == 2 || creProjectValue == 3) && (creTypeValue == 3)) {
            allow('sales-strategy-options-field');
        }
        if ((creProjectValue == 1) && (creTypeValue == 4 || creTypeValue == 8)) {
            allow('continuity-of-the-business-model-field');
            allow('long-term-tenancy-agreement-field');
        }
        if (creTypeValue == 1) {
            allow('enough-renting-prospects-field');
        }
        if ((creProjectValue == 2 || creProjectValue == 3) && (creTypeValue == 3 || creTypeValue == 4 || creTypeValue == 8)) {
            allow('fixed-exit-field');
        }
        if (projectGoalValue == 5 || projectGoalValue == 6) {
            allow('actual-value-building-ground-field');
        }
        if (sponsorId == 1) {
            allow('sponsor-contribution-field');
        }
        $('[id$="-field"]').each(function () {
            var fieldId = this.id;
            var $field = $(this);

            if (!allowedFields.has(fieldId)) {
                // Only reset if it was visible before
                if ($field.is(':visible')) {
                    $field.find('input, select, textarea')
                        .val('')
                        .removeData('prefilled');
                }
                $field.hide();
            }
        });

        updateBelfiusCreditRows();
        updateTotalCreditCharges();
    };
    
    function getAnalysisCreationDate() {
        var rawJson = $('#project-credits-data').val();

        if (!rawJson) {
            return '';
        }

        try {
            var savedData = JSON.parse(rawJson);

            if (!savedData || !savedData.BelfiusCreditData || savedData.BelfiusCreditData.length === 0) {
                return '';
            }
            return savedData.BelfiusCreditData[0].AnalysisCreationDate || '';
        } catch (e) {
            console.log('Invalid project credits JSON', e);
            return '';
        }
    }

    function applyEnvironmentPermitDateRules() {
        var analysisCreationDateRaw = getAnalysisCreationDate();
        var maxDate = formatDdMmYyDateTimeToInputDate(analysisCreationDateRaw);

        if (maxDate) {
            $('#environment-permit-date').attr('max', maxDate);
        }
        // Enable date selection only when Yes = 1
        if ($('#environment-permit').val() === '1') {
            $('#environment-permit-date').prop('disabled', false);
        } else {
            $('#environment-permit-date').val('').prop('disabled', true);
        }
    }

    applyEnvironmentPermitDateRules();

    $('#environment-permit').on('change', function () {
        applyEnvironmentPermitDateRules();
    });

    //Dynamically showing Belfius Credit Rows
    function updateBelfiusCreditRows() {
        var numberOfProducts = $('#number-of-products').val();
        var groundBuildingSplit = $('#ground-building-split').val();
        var breyneLaw = $('#breyne-law').val();

        $('[data-credit-type]').each(function () {
            var $row = $(this);
            var shouldShow = false;

            var id = $row.attr('id');

            if (id.startsWith('belfius-credit-')) {
                if (id === 'belfius-credit-ground') {
                    shouldShow = (groundBuildingSplit === '1');
                } else if (id === 'belfius-credit-garanite-breyne') {
                    shouldShow = (breyneLaw === '1');
                } else {
                    var idx = parseInt(id.replace('belfius-credit-', ''), 10);
                    shouldShow = idx <= numberOfProducts;
                }
            }
            if (shouldShow) {
                $row.show();
            } else {
                if ($row.is(':visible')) {
                    // row is transitioning from visible -> hidden
                    resetCreditRow($row);
                }
                $row.hide();
            }
        });
        updateBelfiusTotalCredit();
    };

    // Initialize the credit rows based on the initial values
    updateBelfiusCreditRows();

    // Update credit rows when the relevant fields change
    $('#number-of-products, #ground-building-split, #breyne-law').on('change', updateBelfiusCreditRows);

    function resetCreditRow($row) {
        $row.find('input, select').each(function () {
            $(this).val('').removeData('prefilled');
        });
    }


    function updateCreditIdentifierMode($row) {

        var identifier = parseInt($row.find('[data-role="credit-identifier"]').val(), 10);
        var $creditNumber = $row.find('[data-role="credit-number"]');

        $creditNumber.val('');

        if (!identifier) {
            $creditNumber.prop('readonly', true).off('input blur');
            return;
        }

        $creditNumber.prop('readonly', false);

        // PROD
        if (identifier === 1) {
            $creditNumber.off('input blur').removeClass('line-credit-input').addClass('credit-card-input');
            new CreditCardInput('#' + $creditNumber.attr('id'));
        }

        // LINE
        else if (identifier === 2) {
            $creditNumber.off('input blur').removeClass('credit-card-input').addClass('line-credit-input');
            new LineCreditInput('#' + $creditNumber.attr('id'));
        }
    }

    $(document)
        .off('change', '[data-role="credit-identifier"]')
        .on('change', '[data-role="credit-identifier"]', function () {
            updateCreditIdentifierMode(
                $(this).closest('tr')
            );
        });

    // Function to update Project Costs table dynamically
    function updateProjectCostsTable() {
        var projectGoalId = $('#project-goal-options').val();
        var creProjectOption = $('#cre-project-options').val();
        var breyneLaw = $('#breyne-law').val();

        // Capture existing values before clearing DOM
        var existingValues = {};
        $('.project-cost-input').each(function () {
            var id = $(this).data('cost-id');
            existingValues[id] = $(this).val();
        });

        // Clear the container
        var $container = $('#project-costs-container');
        $container.empty();
                
        // Get all project costs from the model
        var projectCostsData = $container.attr('data-project-costs');
        var allProjectCosts = [];
        try {
            allProjectCosts = typeof projectCostsData === 'string' ? JSON.parse(projectCostsData) : [];
        } catch (e) {
            console.error("Error parsing project costs:", e);
        }

        var allowedCostIds = new Set();
        switch (projectGoalId) {
            case '1': // Buying
                [1, 2, 3, 8].forEach(id => allowedCostIds.add(id));
                break;
            case '2': // Buying + transformations
                [1, 2, 3, 4, 5, 8].forEach(id => allowedCostIds.add(id));
                break;
            case '3': // Ground buying + building
                [1, 2, 3, 4, 5, 8].forEach(id => allowedCostIds.add(id));
                break;
            case '4': // Buying via public sale
                [2, 3, 8].forEach(id => allowedCostIds.add(id));
                break;
            case '5': // Building
                [3, 4, 5, 8].forEach(id => allowedCostIds.add(id));
                break;
            case '6': // Trasnformations
                [2, 3, 4, 5, 8].forEach(id => allowedCostIds.add(id));
                break
            case '7': // Renovation with architect
                [4, 5, 6, 7, 8].forEach(id => allowedCostIds.add(id));
                break
            default:
                // Handle default case or do nothing
                break;
        }

