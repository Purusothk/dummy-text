Imports System.Collections
 
''' <summary>

''' Scalable PDF rendering interface.

''' Register once in DI — reuse from any controller for any report.

'''

''' Usage pattern (same for every future page):

'''   1. Get data from existing service

'''   2. Build dataSources dictionary  (key = DataSource name in .rdlc)

'''   3. Call GeneratePdf → get byte()

'''   4. Return File(bytes, "application/pdf", "filename.pdf")

''' </summary>

Public Interface IPdfReportService
 
    ''' <summary>

    ''' Renders an .rdlc report to a PDF byte array.

    ''' </summary>

    ''' <param name="rdlcPath">Virtual path to the .rdlc file, e.g. "~/Reports/MyReport.rdlc"</param>

    ''' <param name="reportName">Friendly name used for logging and error messages</param>

    ''' <param name="dataSources">

    '''   Key   = DataSource name as defined inside the .rdlc

    '''   Value = IEnumerable data (List, DataTable, etc.)

    ''' </param>

    ''' <param name="parameters">Optional report parameters (e.g. Language "FR"/"NL")</param>

    ''' <returns>PDF bytes ready to stream as a file download</returns>

    Function GeneratePdf(

        rdlcPath As String,

        reportName As String,

        dataSources As Dictionary(Of String, IEnumerable),

        Optional parameters As Dictionary(Of String, String) = Nothing

    ) As Byte()
 
End Interface

