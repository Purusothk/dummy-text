
GET: Analysis/GenerateAnalysisPdf
<HttpGet>
Public Async Function GenerateAnalysisPdf() As Task(Of ActionResult)
    Dim sw = Stopwatch.StartNew()
    Dim userName = Current_LoginUser
    _logger.Information("GenerateAnalysisPdf - Request received | User: {User}", userName)

    Try
        Dim sessionValidation = validateSessionParameters()
        If Not sessionValidation.IsValid Then
            _logger.Warning("GenerateAnalysisPdf - Session invalid | User: {User} | Reason: {Reason}", userName, sessionValidation.Message)
            Return New HttpStatusCodeResult(400, sessionValidation.Message)
        End If

        Dim projectId = sessionValidation.ProjectId
        Dim projectStatusId = sessionValidation.ProjectStatusId
        Dim projectFlowId = sessionValidation.ProjectFlowId

        Dim allFields As New List(Of AnalysisPdfFieldModel)()

        ' ---- Admin tab (CURATED - already matches business mockup) ----
        Try
            Dim adminData = Await _adminTabService.GetAdminDataAsync(projectId, projectStatusId, projectFlowId)
            allFields.AddRange(_adminTabService.GetAdminPdfFields(adminData))
        Catch ex As Exception
            _logger.Error(ex, "GenerateAnalysisPdf - Admin tab failed | ProjectId: {ProjectId}", projectId)
            allFields.Add(New AnalysisPdfFieldModel("Admin", "Error", "Note", "Admin data unavailable", 0))
        End Try

        ' ---- Actor tab (SPECIFIC FIELDS ONLY) ----
        Try
            If projectStatusId.HasValue AndAlso projectFlowId.HasValue Then
                Dim actorData = Await _actorTabService.GetActorTabDataAsync(projectId, projectStatusId.Value, projectFlowId.Value)
                ' ActorId, BelfiusClient, ActorName live on MainDebtor (MainDebtorActorModel),
                ' NOT directly on ActorTabViewModel - point reflection at actorData.MainDebtor.
                Dim actorFields = New String() {"ActorId", "ActorName", "BelfiusClient"}
                allFields.AddRange(PdfFieldReflectionHelper.GetAutoPdfFields("Actor", "Main Debtor", actorData.MainDebtor, includeOnly:=actorFields))
            End If
        Catch ex As Exception
            _logger.Error(ex, "GenerateAnalysisPdf - Actor tab failed | ProjectId: {ProjectId}", projectId)
            allFields.Add(New AnalysisPdfFieldModel("Actor", "Error", "Note", "Actor data unavailable", 0))
        End Try

        ' ---- Project & Credits tab (SPECIFIC FIELDS ONLY) ----
        Try
            Dim projectCreditsData = _projectCreditsTabService.GetProjectCreditsData(projectId, projectStatusId, projectFlowId)
            ' <<< PUT PROJECT & CREDITS FIELD NAME(S) HERE >>>
            Dim projectCreditsFields = New String() {"FieldName1"}
            allFields.AddRange(PdfFieldReflectionHelper.GetAutoPdfFields("Project & Credits", "All Fields", projectCreditsData, includeOnly:=projectCreditsFields))
        Catch ex As Exception
            _logger.Error(ex, "GenerateAnalysisPdf - Project & Credits tab failed | ProjectId: {ProjectId}", projectId)
            allFields.Add(New AnalysisPdfFieldModel("Project & Credits", "Error", "Note", "Project & Credits data unavailable", 0))
        End Try

        ' ---- Project Asset tab (SPECIFIC FIELDS ONLY) ----
        Try
            Dim assetData = _assetTabRepository.GetAssetData(projectId, projectStatusId, projectFlowId)
            ' <<< PUT ASSET FIELD NAMES HERE (must match AssetTabModel property names exactly) >>>
            Dim assetFields = New String() {"FieldName1", "FieldName2", "FieldName3"}
            allFields.AddRange(PdfFieldReflectionHelper.GetAutoPdfFields("Project Asset", "All Fields", assetData, includeOnly:=assetFields))
        Catch ex As Exception
            _logger.Error(ex, "GenerateAnalysisPdf - Project Asset tab failed | ProjectId: {ProjectId}", projectId)
            allFields.Add(New AnalysisPdfFieldModel("Project Asset", "Error", "Note", "Project Asset data unavailable", 0))
        End Try

        ' ---- Collateral tab (CURATED) ----
        ' Mirrors GetCollateralData's EDIT/CREATE logic: prefer saved data
        ' (what the UI actually shows), fall back to create-mode defaults
        ' only if nothing has been saved yet.
        Try
            Dim collateralData = _collateralTabService.GetSavedCollateralDetails(projectId, projectStatusId, projectFlowId)
            If collateralData Is Nothing OrElse Not collateralData.Any() Then
                collateralData = _collateralTabService.GetCollateraldata(projectId, projectStatusId, projectFlowId)
            End If
            allFields.AddRange(_collateralTabService.GetCollateralPdfFields(collateralData))
        Catch ex As Exception
            _logger.Error(ex, "GenerateAnalysisPdf - Collateral tab failed | ProjectId: {ProjectId}", projectId)
            allFields.Add(New AnalysisPdfFieldModel("Collateral", "Error", "Note", "Collateral data unavailable", 0))
        End Try

        ' ---- Guidance tab (SPECIFIC FIELDS ONLY) ----
        Try
            Dim guidanceData = _guidanceTabRepository.GetGuidanceData(projectId, projectStatusId, projectFlowId)
            ' GuidanceTabModel uses raw DB-column-style property names (PROJ_ID, PROJ_STATUS_ID, ...)
            ' so supply friendly labels via labelOverrides instead of showing underscores in the PDF.
            Dim guidanceFields = New String() {"PROJ_ID", "PROJ_STATUS_ID"}
            Dim guidanceLabels = New Dictionary(Of String, String) From {
                {"PROJ_ID", "Project ID"},
                {"PROJ_STATUS_ID", "Project Status"}
            }
            allFields.AddRange(PdfFieldReflectionHelper.GetAutoPdfFields("Guidance", "All Fields", guidanceData, includeOnly:=guidanceFields, labelOverrides:=guidanceLabels))
        Catch ex As Exception
            _logger.Error(ex, "GenerateAnalysisPdf - Guidance tab failed | ProjectId: {ProjectId}", projectId)
            allFields.Add(New AnalysisPdfFieldModel("Guidance", "Error", "Note", "Guidance data unavailable", 0))
        End Try

        If Not allFields.Any() Then
            _logger.Warning("GenerateAnalysisPdf - No fields resolved for any tab | ProjectId: {ProjectId}", projectId)
            Return New HttpStatusCodeResult(500, "No report data available.")
        End If

        ' Render RDLC -> PDF bytes
        Dim lrLocalReport As New LocalReport()
        lrLocalReport.ReportPath = Server.MapPath("~/Report/AnalysisReport.rdlc")

        Dim reportDataSource As New ReportDataSource("AnalysisFields", allFields)
        lrLocalReport.DataSources.Add(reportDataSource)

        Dim deviceInfo As String =
            "<DeviceInfo>" &
            "<PageHeight>297mm</PageHeight>" &
            "<PageWidth>210mm</PageWidth>" &
            "<MarginTop>10mm</MarginTop>" &
            "<MarginLeft>10mm</MarginLeft>" &
            "<MarginRight>10mm</MarginRight>" &
            "<MarginBottom>10mm</MarginBottom>" &
            "</DeviceInfo>"

        Dim mimeType, encoding, extension As String
        Dim streamIds As String()
        Dim warnings As Warning()

        Dim pdfBytes As Byte() = lrLocalReport.Render("PDF", deviceInfo, mimeType, encoding, extension, streamIds, warnings)

        sw.Stop()
        _logger.Information("GenerateAnalysisPdf - Completed | User: {User} | ProjectId: {ProjectId} | FieldCount: {Count} | SizeBytes: {Size} | ElapsedMs: {ElapsedMs}ms",
                            userName, projectId, allFields.Count, pdfBytes.Length, sw.ElapsedMilliseconds)

        Dim fileName As String = $"Analysis_Project_{projectId}_{DateTime.Now:yyyyMMdd_HHmmss}.pdf"
        Return File(pdfBytes, "application/pdf", fileName)

    Catch ex As Exception
        sw.Stop()
        Dim fullError As String = ex.Message
        Dim innerEx = ex.InnerException
        While innerEx IsNot Nothing
            fullError &= " | Inner: " & innerEx.Message
            innerEx = innerEx.InnerException
        End While
        _logger.Error(ex, "GenerateAnalysisPdf - Unhandled exception | User: {User} | ElapsedMs: {ElapsedMs}ms | FullError: {FullError}",
                      userName, sw.ElapsedMilliseconds, fullError)
        Return New HttpStatusCodeResult(500, "Error generating PDF: " & fullError)
    End Try
End Function 


















Imports System.Reflection

Public Class PdfFieldReflectionHelper

    ' Properties that show up on nearly every tab ViewModel but aren't real
    ' report data - status/plumbing fields, always excluded.
    Private Shared ReadOnly DefaultExcludedProperties As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase) From {
        "IsSuccess", "Message", "IsDirty"
    }

    ''' <summary>
    ''' Converts any object's public simple-typed properties into a flat list
    ''' of AnalysisPdfFieldModel rows for the given tab/section.
    ''' </summary>
    ''' <param name="includeOnly">
    ''' Optional. If provided, ONLY these property names are included, in the
    ''' order given - everything else on the object is ignored. Use this to
    ''' show a curated subset (e.g. 3 fields) instead of every property.
    ''' If Nothing, all simple properties are included (minus excludes) as before.
    ''' </param>
    ''' <param name="labelOverrides">
    ''' Optional. Dictionary of PropertyName -> friendly display label, e.g.
    ''' {"PROJ_ID", "Project ID"}. Use this when the underlying property names
    ''' are raw/technical (like PROJ_STATUS_ID) and you want a readable label
    ''' in the PDF instead. Any property not in this dictionary falls back to
    ''' its raw property name, same as before.
    ''' </param>
    Public Shared Function GetAutoPdfFields(tabName As String, sectionName As String, obj As Object, Optional additionalExcludes As IEnumerable(Of String) = Nothing, Optional includeOnly As IEnumerable(Of String) = Nothing, Optional labelOverrides As Dictionary(Of String, String) = Nothing) As List(Of AnalysisPdfFieldModel)

        Dim rows As New List(Of AnalysisPdfFieldModel)()
        If obj Is Nothing Then Return rows

        Dim excludeSet As New HashSet(Of String)(DefaultExcludedProperties, StringComparer.OrdinalIgnoreCase)
        If additionalExcludes IsNot Nothing Then
            For Each ex In additionalExcludes
                excludeSet.Add(ex)
            Next
        End If

        Dim order As Integer = 0
        Dim objType = obj.GetType()

        ' If includeOnly is given, walk THAT list (preserves your chosen order)
        ' instead of reflecting over every property on the object.
        If includeOnly IsNot Nothing Then
            For Each propName In includeOnly
                Dim prop As PropertyInfo = objType.GetProperty(propName)
                If prop Is Nothing Then Continue For ' name typo or property doesn't exist - skip silently

                Dim rawValue As Object
                Try
                    rawValue = prop.GetValue(obj)
                Catch
                    Continue For
                End Try

                Dim label As String = prop.Name
                If labelOverrides IsNot Nothing AndAlso labelOverrides.ContainsKey(prop.Name) Then
                    label = labelOverrides(prop.Name)
                End If

                rows.Add(New AnalysisPdfFieldModel(tabName, sectionName, label, FormatValue(rawValue), order))
                order += 1
            Next
            Return rows
        End If

        ' Default behavior: dump every simple property (minus excludes)
        Dim properties As PropertyInfo() = objType.GetProperties()

        For Each prop As PropertyInfo In properties

            If excludeSet.Contains(prop.Name) Then Continue For

            ' Skip collections/lists (dropdown options, nested detail lists) -
            ' these aren't simple Label/Value pairs and need custom handling
            ' once this tab gets a curated mapping.
            If GetType(System.Collections.IEnumerable).IsAssignableFrom(prop.PropertyType) AndAlso prop.PropertyType IsNot GetType(String) Then
                Continue For
            End If

            Dim rawValue As Object
            Try
                rawValue = prop.GetValue(obj)
            Catch
                Continue For ' property getter threw - skip rather than fail the whole PDF
            End Try

            Dim displayValue As String = FormatValue(rawValue)

            rows.Add(New AnalysisPdfFieldModel(tabName, sectionName, prop.Name, displayValue, order))
            order += 1

        Next

        Return rows

    End Function

    Private Shared Function FormatValue(rawValue As Object) As String

        If rawValue Is Nothing Then Return ""

        If TypeOf rawValue Is DateTime Then
            Return CType(rawValue, DateTime).ToString("dd-MM-yyyy")
        End If

        If TypeOf rawValue Is Boolean Then
            Return If(CBool(rawValue), "Yes", "No")
        End If

        Return rawValue.ToString()

    End Function

End Class

