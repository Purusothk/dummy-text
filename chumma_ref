    ' Sponsor identification
    <JsonProperty("RE_SPNS_ACTOR_ID")>
    Public Property ActorId As String

    <JsonProperty("RE_SPNS_CI_ID")>
    Public Property CI As String

    <JsonIgnore>
    Public Property Rating1 As Integer?

    <JsonProperty("RE_SPNS_MASTERSCALE_DATE_DT")>
    Public Property RatingDate As Date?

    <JsonIgnore>
    Public Property RatingDateDisplayFormat As String
        Get
            If RatingDate.HasValue Then
                ' Ensure the date is formatted correctly as dd-MM-yyyy
                Return RatingDate.Value.ToString("dd-MM-yyyy")
            Else
                Return "N/A"
            End If
        End Get
        Set(value As String)
            If value = "N/A" Then
                RatingDate = Nothing
            ElseIf Not String.IsNullOrEmpty(value) Then
                ' Parse the date string with the correct format
                RatingDate = DateTime.ParseExact(value, "dd-MM-yyyy", CultureInfo.InvariantCulture)
            Else
                RatingDate = Nothing
            End If
        End Set
    End Property

    <JsonProperty("RE_SPNS_CLIENT_SW")>
    Public Property BelfiusClient As Integer?

