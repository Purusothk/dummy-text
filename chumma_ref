Imports System.Globalization
Imports Newtonsoft.Json

Public Class MainDebtorActorModel

    ' Core identification properties
    <JsonProperty("RE_PROJ_ID")>
    Public Property ProjectId As Integer

    <JsonProperty("RE_PROJ_STATUS_ID")>
    Public Property ProjectStatusId As Integer

    <JsonProperty("RE_PROJ_STATUS_FLOW_ID")>
    Public Property ProjectStatusFlowId As Integer

    ' Actor identification
    <JsonProperty("RE_MADB_ACTOR_ID")>
    Public Property ActorId As String

    <JsonProperty("RE_MADB_CI_ID")>
    Public Property CI As String

    <JsonProperty("RE_MADB_MASTERSCALE_ID")>
    Public Property Rating1 As Integer?

    <JsonProperty("RE_MADB_MASTERSCALE_DATE_DT")>
    Public Property RatingDate As Date?

    <JsonIgnore>
    Public Property RatingDateDisplayFormat As String
        Get
            If RatingDate.HasValue Then
                ' Ensure the date is formatted correctly as dd-MM-yyyy
                Return RatingDate.Value.ToString("dd-MM-yyyy")
            Else
                Return String.Empty
            End If
        End Get
        Set(value As String)
            If Not String.IsNullOrEmpty(value) Then
                ' Parse the date string with the correct format
                RatingDate = DateTime.ParseExact(value, "dd-MM-yyyy", CultureInfo.InvariantCulture)
            Else
                RatingDate = Nothing
            End If
        End Set
    End Property
    <JsonProperty("RE_MADB_CLIENT_SW")>
    Public Property BelfiusClient As Integer?

    <JsonProperty("RE_MADB_PRIVATE_WEALTH_ID")>
    Public Property PrivateWealthProfile As Integer?

    <JsonProperty("RE_MADB_COMMERCIAL_REGIO_ID")>
    Public Property CommercialRegion As Integer?

    <JsonProperty("RE_MADB_BUSINESS_LINE_ID")>
    Public Property BusinessLine As Integer?

    <JsonProperty("RE_MADB_COMMERCIAL_SEGMENT_ID")>
    Public Property CommercialSegment As String

    <JsonProperty("RE_MADB_WATCHLIST_SW")>
    Public Property Watchlist As Integer?

    <JsonProperty("RE_MADB_MAX_EXPOSURE_AM")>
    Public Property ExistingExposure As Decimal?

    <JsonProperty("RE_MADB_LTMR_AM")>
    Public Property LMRT As Decimal?

    ' Sponsor selection (yes/no dropdown) - This comes from RE_PROJ table.
    '<JsonProperty("RE_PROJ_SPONSOR_SW")>
    <JsonIgnore>
    Public Property HasSponsor As Integer

    <JsonIgnore>
    Public Property ActorName As String

    ' Display text fields for main debtor. few fields are getting from SP itself
    ' Few fiels we are lookup into TCOD tables by category

    ' From Stored procedure call
    <JsonIgnore>
    Public Property PrivateWealthProfileDisplayText As String
    <JsonIgnore>
    Public Property CommercialSegmentDisplayText As String


    ' From TCOD table
    <JsonIgnore>
    Public Property RatingFieldDisplayText As String

    <JsonIgnore>
    Public Property WatchlistDisplayText As String

    <JsonIgnore>
    Public Property CommercialRegionDisplayText As String
    <JsonIgnore>
    Public Property BusinessLineDisplayText As String

    ' Operation type for change tracking (INSERT, UPDATE, DELETE, or null)
    ' Note: This property is sent from frontend to determine database operation type.
    <JsonIgnore>
    Public Property Operation As String
    <JsonIgnore>
    Public Property IsDataFromReTable As Boolean

    <JsonProperty("RE_MADB_IS_VALID_ACTOR")>
    Public Property IsValidActorId As Integer?

    Public Sub New()
        HasSponsor = 0 ' 0 = false, 1 = true ( from RE_PROJ table) initially from show the sponsor card.
        'BelfiusClient = 1 ' 0 = false, 1 = true
        Operation = Nothing
        IsDataFromReTable = False
    End Sub
End Class

Public Class SponsorModel
    ' Core identification properties
    <JsonProperty("RE_PROJ_ID")>
    Public Property ProjectId As Integer

    <JsonProperty("RE_PROJ_STATUS_ID")>
    Public Property ProjectStatusId As Integer

    <JsonProperty("RE_PROJ_STATUS_FLOW_ID")>
