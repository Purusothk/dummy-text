                                <div class="col-sm-7">
                                    @Html.TextBoxFor(Function(m) m.ActualValueBuildingGroundAmount, New With {.class = "form-control input-sm formatted-number", .id = "actual-value-building-ground", .data_tbd = "true", .data_label = "Actual Value Building/Ground", .data_review_edit = "true"})
