        Public Function SaveProjectCreditsData() As JsonResult
            Dim sw = Stopwatch.StartNew()
            Dim userName = Current_LoginUser
            _logger.Information("SaveProjectCreditsData - Request received | User: {User}", userName)
            Try
                'Read raw JSON
                Dim screenData As String
                Using reader As New IO.StreamReader(Request.InputStream)
                    screenData = reader.ReadToEnd()
                End Using
                If String.IsNullOrWhiteSpace(screenData) Then
                    _logger.Warning("SaveProjectCreditsData - Empty payload | User: {User}", userName)
                    Return Json(New With {.success = False, .message = "Empty payload"})
                End If
                'Deserialize
                Dim payload As ProjectCreditsTabSaveDto = JsonConvert.DeserializeObject(Of ProjectCreditsTabSaveDto)(screenData)
                'Inject session values
                Dim sessionValidation = validateSessionParameters()

                payload.ProjectId = sessionValidation.ProjectId
                payload.ProjectStatusId = sessionValidation.ProjectStatusId.Value
                payload.ProjectStatusFlowId = sessionValidation.ProjectFlowId.Value
                InjectContextFromSession(payload)
                'STORE BREYNE LAW IN SESSION
                If payload.RE_PRCR IsNot Nothing Then
                    Session("BreyneLaw") = payload.RE_PRCR.RE_PRCR_BREYNE_LAW_SW
                End If

                _logger.Information("SaveProjectCreditsData - Saving | User: {User} | ProjectId: {ProjectId} | StatusId: {StatusId} | FlowId: {FlowId}",
                                    userName, payload.ProjectId, payload.ProjectStatusId, payload.ProjectStatusFlowId)
                'Call service
                _projectCreditsTabService.SaveProjectCreditsData(payload)
                sw.Stop()
                _logger.Information("SaveProjectCreditsData - Success | User: {User} | ProjectId: {ProjectId} | ElapsedMs: {ElapsedMs}ms", userName, payload.ProjectId, sw.ElapsedMilliseconds)
                Return Json(New With {.success = True, .message = "Saved Sucessfully"})
            Catch ex As Exception
                sw.Stop()
                _logger.Error(ex, "SaveProjectCreditsData - Unhandled exception | User: {User} | ElapsedMs: {ElapsedMs}ms", userName, sw.ElapsedMilliseconds)
                Return Json(New With {
                            .success = False,
                            .message = ex.Message})
            End Try
        End Function

        Private Sub InjectContextFromSession(req As ProjectCreditsTabSaveDto)
            Dim sw = Stopwatch.StartNew()
            _logger.Information("InjectContextFromSession - Request received")
            Dim projectId As Integer
            Dim projectStatusId As Integer
            Dim projectFlowId As Integer
            Dim sessionValidation = validateSessionParameters()

            projectId = sessionValidation.ProjectId
            projectStatusId = sessionValidation.ProjectStatusId.Value
            projectFlowId = sessionValidation.ProjectFlowId.Value
            Dim applyContext = Sub(obj As Object)
                                   If obj Is Nothing Then
                                       Exit Sub
                                   End If
                                   Dim t = obj.GetType()
                                   t.GetProperty("RE_PROJ_ID")?.SetValue(obj, projectId)
                                   t.GetProperty("RE_PROJ_STATUS_ID")?.SetValue(obj, projectStatusId)
                                   t.GetProperty("RE_PROJ_STATUS_FLOW_ID")?.SetValue(obj, projectFlowId)
                               End Sub
            applyContext(req.RE_PRCR)
            applyContext(req.RE_CROI)
            applyContext(req.RE_CRGU)
            applyContext(req.RE_PRFU)
            If req.RE_CRED IsNot Nothing Then
                req.RE_CRED.ForEach(Sub(x) applyContext(x))
            End If
            If req.RE_COST IsNot Nothing Then
                req.RE_COST.ForEach(Sub(x) applyContext(x))
            End If
            _logger.Information("InjectContextFromSession - Success | ElapsedMs: {ElapsedMs}ms", sw.ElapsedMilliseconds)
            'If req.RE_ACTR IsNot Nothing Then
            '    req.RE_ACTR.ForEach(Sub(x) applyContext(x))
            'End If
        End Sub

