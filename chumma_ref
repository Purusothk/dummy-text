                ' Empty result  
                If paged.Data Is Nothing OrElse Not paged.Data.Any() Then
                    _logger.Warning("KRWGSearch - No results found | User: {User} | Postcode: {Postcode} | Street: {Street} | ProjectId: {ProjectId} | StatusId: {StatusId} | FlowId: {FlowId}",
                                    userName, postcode, streetname, finalProjectId, finalProjectStatusId, finalProjectFlowId)
                End If
                Dim settings = New Newtonsoft.Json.JsonSerializerSettings With {
                    .ReferenceLoopHandling = Newtonsoft.Json.ReferenceLoopHandling.Ignore,
                    .NullValueHandling = Newtonsoft.Json.NullValueHandling.Ignore
                }

                sw.Stop()
                'Success
                _logger.Information("KRWGSearch - Success | User: {User} | ResultCount: {Count} | Page: {Page} | ProjectId: {ProjectId} | StatusId: {StatusId} | FlowId: {FlowId} | ElapsedMs: {ElapsedMs}ms",
                                    userName, paged.Data?.Count, pageNumber, finalProjectId, finalProjectStatusId, finalProjectFlowId, sw.ElapsedMilliseconds)

                Return Content(
                    Newtonsoft.Json.JsonConvert.SerializeObject(paged, settings), "application/json")

            Catch ex As ApplicationException
                sw.Stop()
                ' Known error  
                _logger.Warning("KRWGSearch - Application error | User: {User} | Message: {Message} | ProjectId: {ProjectId} | StatusId: {StatusId} | FlowId: {FlowId} | ElapsedMs: {ElapsedMs}ms",
                    userName, ex.Message, projectId, projectStatusId, projectFlowId, sw.ElapsedMilliseconds)
                Return New JsonResult With {
                    .Data = New With {.success = False, .message = ex.Message},
                    .JsonRequestBehavior = JsonRequestBehavior.AllowGet
                }
            Catch ex As Exception
                sw.Stop()
                ' Unknown error  
                _logger.Error(ex, "KRWGSearch - Unhandled exception | User: {User} | Postcode: {Postcode} | Street: {Street} | ProjectId: {ProjectId} | StatusId: {StatusId} | FlowId: {FlowId} | ElapsedMs: {ElapsedMs}ms",
                    userName, postcode, streetname, projectId, projectStatusId, projectFlowId, sw.ElapsedMilliseconds)
                Return New JsonResult With {
                    .Data = New With {.success = False, .message = ex.Message},
                    .JsonRequestBehavior = JsonRequestBehavior.AllowGet
                }

            End Try
        End Function

