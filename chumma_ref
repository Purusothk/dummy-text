                            <div class="form-group form-group-sm">
                                <Label class="col-sm-5 control-label">Other proposed collaterals :</Label>
                                <div class="col-sm-7">
                                    @Html.DropDownListFor(Function(m) m.SelectedOtherProposedCollaterals, New SelectList(Model.YesNoOptions, "TcodId", "TcodDescName"), "SELECT", New With {.class = "form-control input-sm", .data_tbd = "true", .id = "other-proposed-collaterals", .data_label = "Other proposed collaterals"})
