    Public Property CommercialRegios As List(Of TcodModel)


    ' Project identification
    Public Property ProjectId As Integer
    Public Property ProjectStatusId As Integer
    Public Property ProjectFlowId As Integer

    ' Conditional Logic and UI State
    Public Property ConditionalFields As ActorConditionalFields
    'Public Property NotApplicableFields As NotApplicableFields

    ' Success/Error handling
    Public Property IsSuccess As Boolean
    Public Property Message As String

    Public Sub New()
        MainDebtor = New MainDebtorActorModel()
        Sponsor = New SponsorModel()
        OtherActors = New List(Of OtherActorModel)()
