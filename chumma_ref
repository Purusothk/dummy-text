    AnalysisScreen.saveProjectCreditsDataToServer = function (closeAfterSave, callback, isTabSwitch) {

        isTabSwitch = isTabSwitch || false;
                
        // Prevent double / triple submit
        if (AnalysisScreen.isProjectCreditsSaving) return;

        AnalysisScreen.isProjectCreditsSaving = true;

        // Environment date validation
        var permitDate = $('#environment-permit-date').val();
        var maxDate = $('#environment-permit-date').attr('max');

        if ($('#environment-permit').val() === '1' && maxDate && permitDate && permitDate > maxDate) {
            showErrorMessage('Validation Failed', 'Environment Permit Date cannot be later than Analysis Receiving Date.');
            scrollTopShowErrorMessage();
            AnalysisScreen.isProjectCreditsSaving = false;
            return;
        }

        if (!closeAfterSave && !isTabSwitch && !validateFormData()) {
            AnalysisScreen.isProjectCreditsSaving = false;
            return;
        }

        // Do nothing if no changes
        if (!AnalysisScreen.isProjectCreditsDataDirty) {
            AnalysisScreen.isProjectCreditsSaving = false;
            if (isTabSwitch) {
                if (typeof callback === 'function') {
                    callback();
                }
            } else if (closeAfterSave) {
                markTabAsSaved('project-credits', closeAfterSave);
                // Return to tasklist
                setTimeout(function () {
                    returnToTaskList();
                }, 1000);
            } else {
                markTabAsSaved('project-credits', closeAfterSave);
                navigateToNextTab();
            }  
            return;
        }        
                
        var payload = collectSavePayload();

        $.ajax({
            url: '/Analysis/SaveProjectCreditsData',
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify(payload),
            success: function (res) {
                if (res && res.success) {
                    showSuccessMessage('Data saved successfully');
                    AnalysisScreen.isProjectCreditsDataDirty = false;
                    markDataAsClean();
                    if (isTabSwitch) {
                        if (typeof callback === 'function') {
                            callback();
                        }
                    } else if (closeAfterSave) {
                        markTabAsSaved('project-credits', closeAfterSave);
                        // Return to tasklist
                        setTimeout(function () {
                            returnToTaskList();
                        }, 1000);
                    } else {
                        markTabAsSaved('project-credits', closeAfterSave);
                        navigateToNextTab();
                    }                 
                } else {
                    showErrorMessage('Save failed: ' + res.message);
                    scrollTopShowErrorMessage();
                }
            },
            error: function (xhr) {
                showErrorMessage('Save Failed', xhr.statusText || 'Failed to save data');
                scrollTopShowErrorMessage();
            },
            complete: function () {
                AnalysisScreen.isProjectCreditsSaving = false;
            }
        });
    };

