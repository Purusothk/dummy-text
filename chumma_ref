    // Calculation of Belfius Credits Total Except Breyne
    function updateBelfiusTotalCredit() {
        var totalAmount = 0;

        // Sum amounts from visible standard credit rows
        for (var i = 1; i <= 3; i++) {
            var creditRow = $('#belfius-credit-' + i);
            if (creditRow.is(':visible')) {
                var amount = parseNumber(creditRow.find('input[id^="belfius-credit-"][id$="-amount"]').val()) || 0;
                totalAmount += amount;
            }
        }

        // Add amount from ground credit row if visible
        var groundCreditRow = $('#belfius-credit-ground');
        if (groundCreditRow.is(':visible')) {
            var groundAmount = parseNumber(groundCreditRow.find('#belfius-credit-ground-amount').val()) || 0;
            totalAmount += groundAmount;
        }

        // updating total amount
        new CalculatedField('#belfius-credits-total', () => totalAmount).update();
        updateTotalFunds();

    }

