        ' POST Analysis/SaveCollateral
        <HttpPost>
        Public Function SaveCollateral(payload As SaveAllCollateralDto) As JsonResult
            Dim sw = Stopwatch.StartNew()
            Dim userName = Current_LoginUser

            ' Request received
            _logger.Information("SaveCollateral - Request received | User: {User} | CollateralCount: {CCount} | OtherCount: {OCount} | NotaryCount: {NCount}",
                                userName, payload?.Collaterals?.Count, payload?.OtherCollaterals?.Count, payload?.Notary?.Count)
            Try
                If payload Is Nothing _
                    OrElse (
                    (payload.Collaterals Is Nothing OrElse payload.Collaterals.Count = 0) _
                    AndAlso (payload.OtherCollaterals Is Nothing OrElse payload.OtherCollaterals.Count = 0) _
                    AndAlso (payload.Notary Is Nothing OrElse payload.Notary.Count = 0)
                    ) Then
                    _logger.Warning("SaveCollateral - Payload is empty | User: {User}", userName)
