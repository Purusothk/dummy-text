    function updateBreyneAmount() {
        var percentageId = $('#belfius-credit-garanite-breyne-percentage-options').val();
        var amountField = $('#belfius-credit-garanite-breyne-amount');

        if (!percentageId) {
            amountField.val('');
            amountField.prop('readonly', true);
            return;
        }

        if (percentageId == 1) {
            amountField.val('');
            amountField.prop('readonly', false);
            return;
        }

        var multiplier = 1;

        if (percentageId == 2) {
            multiplier = 1.05;
        }
        if (percentageId == 3) {
            multiplier = 1.10;
        }

        var totalProjectCosts = parseNumber($('#project-costs').val()) || 0;
        var calculatedAmount = totalProjectCosts * multiplier;
        amountField.val(formatNumber(calculatedAmount));
        amountField.prop('readonly', true);
    }

