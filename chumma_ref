        if ($('#deposit-pre-sales-field').is(':visible') &&
            $('#signed-pre-sales-field').is(':visible') &&
            $('#pre-sales-field').is(':visible')) {
            var preSalesTotal = 0;
            var depositPreSales = parseNumber($('#deposit-pre-sales').val()) || 0;
            var signedPreSales = parseNumber($('#signed-pre-sales').val()) || 0;
            preSalesTotal = depositPreSales + signedPreSales;
