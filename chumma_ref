/* validation error styles */
.validation-error {
    color: #d9534f;
    font-size: 10px;
    margin-top: 5px;
    display: block;
    font-weight: 500;
}

.has-error .form-control {
    border-color: #d9534f;
    box-shadow: 0 0 0 2px rgba(217, 83, 79, 0.1);
}

.has-error .control-label {
    color: #d9534f;

}

.admin-card-body .validation-error {
    margin-top: 5px;
    margin-bottom: 10px;
    padding: 5px 10px;
    background-color: #f2dede;
    border: 1px solid #ebccd1;
    border-radius: 3px;
    color: #a94442;
    font-size: 11px;
    font-weight: normal;
    display: block;
    animation: fadeInError 0.3s ease-in;
}



    .admin-card-body .validation-error .glyphicon {
        margin-right: 5px;
        font-size: 10px;
    }

.admin-card-body .has-error .form-control {
    border-color: #a94442;
    box-shadow: inset 0 1px rgba(0,0,0,.075), 0 0 6px #ce8483;
    transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
}

.admin-card-body .has-error .control-label {
    color: #a94442;
    font-weight: 600;
}

.admin-card-body .has-error {
    position: relative;
}

/* Error Animation */
@keyframes fadeInError {
    from {
        opacity: 0;
        transform: translateY(-5px)
    }

