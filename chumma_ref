                            </div>
                            <div class="form-group form-group-sm">
                                <label class="col-sm-5 control-label">Number of RE as Collaterals :</label>
                                <div class="col-sm-7">
                                    @Html.DropDownListFor(Function(m) m.SelectedNumberOfREAsCollaterals, Model.NumberOfREAsCollaterals, New With {.class = "form-control input-sm", .id = "number-of-re-as-collaterals", .data_tbd = "true", .data_label = "Number of RE as Collaterals"})
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group form-group-sm">
                                <Label class="col-sm-5 control-label">Proposed collateral already used :</Label>
                                <div class="col-sm-7">
