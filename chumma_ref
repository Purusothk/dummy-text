                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Collaterals Card -->
            <div class="admin-card">
                <div class="admin-card-header">
                    <h4 class="admin-card-title">Collaterals</h4>
                </div>
                <div class="admin-card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group form-group-sm">
                                <label class="col-sm-5 control-label">CRE project as collateral (*):</label>
                                <div class="col-sm-7">
                                    @Html.DropDownListFor(Function(m) m.SelectedCREProjectAsCollateral, New SelectList(Model.YesNoOptions, "TcodId", "TcodDescName"), "SELECT", New With {.class = "form-control input-sm", .id = "cre-project-as-collateral", .data_required = "true", .data_label = "CRE project as collateral"})
