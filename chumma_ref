Imports Serilog
Imports Serilog.Events
Imports System.Configuration
Imports System.IO

Namespace App_Start
    Public Class LoggerConfig
        ''' <summary>  
        ''' Configure Serilog logger with settings from Web.config  
        ''' </summary>  
        Public Shared Sub ConfigureLogger()
            Try
                ' Read settings from Web.config  
                Dim logBasePath = If(ConfigurationManager.AppSettings("Serilog:LogBasePath"), Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "Logs"))
                Dim retentionDays = Integer.Parse(If(ConfigurationManager.AppSettings("Serilog:RetentionDays"), "90"))
                Dim minLevel = If(ConfigurationManager.AppSettings("Serilog:MinimumLevel"), "Information")
                Dim enableConsole = Boolean.Parse(If(ConfigurationManager.AppSettings("Serilog:EnableConsole"), "true"))
                Dim appName = If(ConfigurationManager.AppSettings("ApplicationName"), "ImmoSample")
                Dim environment = If(ConfigurationManager.AppSettings("Environment"), "Development")

                ' Validate log path  
                If String.IsNullOrWhiteSpace(logBasePath) Then
                    logBasePath = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "Logs")
                End If

                ' Parse minimum level  
                Dim logLevel As LogEventLevel = LogEventLevel.Information
                Select Case minLevel.ToLower()
                    Case "debug"
                        logLevel = LogEventLevel.Debug
                    Case "information"
                        logLevel = LogEventLevel.Information
                    Case "warning"
                        logLevel = LogEventLevel.Warning
                    Case "error"
                        logLevel = LogEventLevel.Error
                    Case Else
                        logLevel = LogEventLevel.Information
                End Select

                ' Create log directories  
                Dim infoLogPath = Path.Combine(logBasePath, "Application", "Info")
                Dim errorLogPath = Path.Combine(logBasePath, "Application", "Error")
                Directory.CreateDirectory(infoLogPath)
                Directory.CreateDirectory(errorLogPath)

                ' Configure Serilog  
                Dim config = New LoggerConfiguration() _
                    .MinimumLevel.Is(logLevel) _
                    .MinimumLevel.Override("Microsoft", LogEventLevel.Warning) _
                    .MinimumLevel.Override("System", LogEventLevel.Warning) _
                    .Enrich.WithProperty("Application", appName) _
                    .Enrich.WithProperty("Environment", environment) _
                    .Enrich.WithMachineName() _
                    .Enrich.WithThreadId()

                ' Console sink (for development)  
                If enableConsole Then
                    config = config.WriteTo.Console(
                        outputTemplate:="[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
                    )
                End If

                ' Information logs  
                config = config.WriteTo.File(
                    path:=Path.Combine(infoLogPath, "app-.txt"),
                    restrictedToMinimumLevel:=LogEventLevel.Information,
                    rollingInterval:=RollingInterval.Day,
                    retainedFileCountLimit:=retentionDays,
                    fileSizeLimitBytes:=52428800,
                    rollOnFileSizeLimit:=True,
                    shared:=True,
                    outputTemplate:="{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{MachineName}] [{ThreadId}] {SourceContext} - {Message:lj}{NewLine}{Exception}"
                )

                ' Error logs  
                config = config.WriteTo.File(
                    path:=Path.Combine(errorLogPath, "error-.txt"),
                    restrictedToMinimumLevel:=LogEventLevel.Error,
                    rollingInterval:=RollingInterval.Day,
                    retainedFileCountLimit:=retentionDays * 2,
                    fileSizeLimitBytes:=104857600,
                    rollOnFileSizeLimit:=True,
                    shared:=True,
                    outputTemplate:="{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {SourceContext}{NewLine}Message: {Message:lj}{NewLine}{Exception}{NewLine}---{NewLine}"
                )

                ' Create logger  
                Log.Logger = config.CreateLogger()

                ' Startup log  
                Log.Information("========== Application Started ==========")
                Log.Information("Application: {AppName}, Environment: {Environment}", appName, environment)
                Log.Information("Log Path: {LogPath}, Retention: {Days} days", logBasePath, retentionDays)
                Log.Information("========================================")
            Catch ex As Exception
                ' Fallback logger if configuration fails  
                Log.Logger = New LoggerConfiguration() _
                    .WriteTo.Console() _
                    .CreateLogger()
                Log.Fatal(ex, "Failed to configure logger - using fallback console logger")
            End Try
        End Sub

        ''' <summary>  
        ''' Shutdown logger and flush pending logs  
        ''' </summary>  
        Public Shared Sub ShutdownLogger()
            Log.Information("========== Application Stopped ==========")
            Log.CloseAndFlush()
        End Sub
    End Class
End Namespace
