Imports System.Collections

Imports System.Web.Hosting

Imports Microsoft.Reporting.WebForms

Imports Serilog
 
''' <summary>

''' Never changes when new reports are added. Only rdlcPath + data changes per feature.

''' </summary>

Public Class PdfReportService

    Implements IPdfReportService
 
    Private ReadOnly _logger As ILogger
 
    Public Sub New()

        _logger = Log.ForContext(Of PdfReportService)()

    End Sub
 
    Public Function GeneratePdf(

        rdlcPath As String,

        reportName As String,

        dataSources As Dictionary(Of String, IEnumerable),

        Optional parameters As Dictionary(Of String, String) = Nothing

    ) As Byte() Implements IPdfReportService.GeneratePdf
 
        _logger.Information("PdfReportService - Generating PDF | Report:{ReportName}", reportName)
 
        ' 1. Resolve virtual path to physical path

        Dim physicalPath As String = HostingEnvironment.MapPath(rdlcPath)

        If String.IsNullOrEmpty(physicalPath) Then

            Throw New ArgumentException($"PdfReportService - Could not resolve rdlc path: {rdlcPath}")

        End If
 
        ' 2. Create and configure LocalReport

        Dim report As New LocalReport()

        report.ReportPath = physicalPath

        report.EnableExternalImages = True
 
        ' 3. Bind data sources

        ' Key must match the DataSource name defined inside the .rdlc file

        If dataSources IsNot Nothing Then

            For Each kvp In dataSources

                report.DataSources.Add(New ReportDataSource(kvp.Key, kvp.Value))

            Next

        End If
 
        ' 4. Set optional parameters (e.g. Language = "FR" / "NL")

        If parameters IsNot Nothing AndAlso parameters.Count > 0 Then

            Dim reportParams = parameters.Select(

                Function(p) New ReportParameter(p.Key, p.Value)

            ).ToArray()

            report.SetParameters(reportParams)

        End If
 
        ' 5. Render to PDF bytes

        Dim bytes As Byte() = report.Render("PDF")
 
        _logger.Information("PdfReportService - PDF generated successfully | Report:{ReportName} | Size:{Bytes} bytes",

                            reportName, bytes.Length)

        Return bytes
 
    End Function
 
End Class

 
