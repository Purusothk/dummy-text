    function updateTotalFunds() {

        var belfiusCreditsTotal = parseNumber($('#belfius-credits-total').val()) || 0;
        var ownFunds = parseNumber($('#own-funds').val()) || 0;
        var depositPreSales = 0;
        var signedPreSales = 0;
        var otherFunds = parseNumber($('#other-funds').val()) || 0;
        var creProject = $('#cre-project-options').val();

        // Check if the deposit-pre-sales field is visible before getting its value
        if (creProject !== '1' && $('#deposit-pre-sales').is(':visible')) {
            depositPreSales = parseNumber($('#deposit-pre-sales').val()) || 0;
        }

        if (creProject !== '1' && $('#signed-pre-sales').is(':visible')) {
            signedPreSales = parseNumber($('#signed-pre-sales').val()) || 0;
        }

        var totalFunds = belfiusCreditsTotal + ownFunds + depositPreSales + signedPreSales + otherFunds;
        new CalculatedField('#total-funds', () => totalFunds).update();
        updateTotalFundsMinusCosts();
    }

