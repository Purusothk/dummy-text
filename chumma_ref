        ' GET: Analysis (fall back for direct access)
        <HttpGet>
        Public Function Index() As ActionResult
            ViewBag.Header = AppGlobals.Analyse_Header_Text
            ViewBag.Version = AppGlobals.Str_Version

            Dim viewModel As New AnalysisViewModel()

            If Session("AnalysisProjectId") IsNot Nothing Then
                ViewBag.ProjectId = Session("AnalysisProjectId")
                ViewBag.ProjectStatusId = Session("AnalysisProjectStatusId")
                ViewBag.projectFlowId = Session("AnalysisProjectFlowId")
                ViewBag.Mode = Session("AnalysisMode")

                ' CRE context (set after first admin save; null on first visit)
                ViewBag.creProjectId = Session("AnalysisCreProjectId")
                ViewBag.creTypeId = Session("AnalysisCreTypeId")
                ViewBag.creGoalId = Session("AnalysisCreGoalId")
                viewModel.IsSuccess = True

                If Session("AnalysisProjectStatusId") < 3 Then
                    viewModel.NameTabGuidance = "Guidance CRE"
                Else
                    viewModel.NameTabGuidance = "Decision"
                End If
            Else
                viewModel.IsSuccess = False
                viewModel.Message = "No Project selected. please select a project from task list"
            End If

            ' ALWAYS SET ViewBag
            Dim userRole As String = Convert.ToString(Session("EffectiveRole"))
            If String.IsNullOrWhiteSpace(userRole) Then
                viewModel.IsSuccess = False
                viewModel.Message = "Session expired. <a href='" & Url.Action("Index", "Portal") & "'>Click here</a> to go back to portal."
                Return View(viewModel)
            End If
            ViewBag.UserRole = userRole
            Return View(viewModel)
        End Function


        ' POST: Analysis (secure parameter passing)
        <HttpPost>
        Public Function Index(Optional projectId As Integer? = Nothing, Optional projectStatusId As Integer? = Nothing, Optional projectFlowId As Integer? = Nothing, Optional mode As String = "analysis", Optional projectTabId As Integer? = Nothing, Optional creProjectId As Integer? = Nothing) As ActionResult
            ViewBag.Header = AppGlobals.Analyse_Header_Text
            ViewBag.Version = AppGlobals.Str_Version

            Dim viewModel As New AnalysisViewModel()

            ' Store parameters in session for security and presistence
            If projectId.HasValue Then
                ' Default tab id value from tasklist
                Dim finalProjectTabId As Integer = If(projectTabId.HasValue, projectTabId.Value, 1)
                Dim finalProjectStatusId As Integer? = projectStatusId
                Dim finalCreProjectId As Integer? = creProjectId
                Dim isSameProject As Boolean = False
                If Session("AnalysisProjectId") IsNot Nothing Then
                    isSameProject = Convert.ToInt32(Session("AnalysisProjectId")) = projectId.Value
                End If
                If isSameProject Then
                    If Session("ProjectTabId") IsNot Nothing Then
                        finalProjectTabId = Convert.ToInt32(Session("ProjectTabId"))
                    End If
                    If Session("AnalysisProjectStatusId") IsNot Nothing Then
                        finalProjectStatusId = Convert.ToInt32(Session("AnalysisProjectStatusId"))
                    End If
                    If Session("AnalysisCreProjectId") IsNot Nothing Then
                        finalCreProjectId = Convert.ToInt32(Session("AnalysisCreProjectId"))
                    End If
                End If
                Session("AnalysisProjectId") = projectId.Value
                Session("AnalysisProjectStatusId") = finalProjectStatusId
                Session("AnalysisProjectFlowId") = projectFlowId
                Session("AnalysisMode") = mode
                Session("ProjectTabId") = finalProjectTabId
                Session("AnalysisCreProjectId") = finalCreProjectId

                ' Also store project parameters in viewbag for javascript access
                ViewBag.ProjectId = projectId
                ViewBag.ProjectStatusId = finalProjectStatusId
                ViewBag.ProjectFlowId = projectFlowId
                ViewBag.Mode = mode
                ViewBag.ProjectTabId = finalProjectTabId
                ViewBag.CreProjectId = finalCreProjectId

                viewModel.IsSuccess = True

                If Session("AnalysisProjectStatusId") < 3 Then
                    viewModel.NameTabGuidance = "Guidance CRE"
                Else
                    viewModel.NameTabGuidance = "Decision"
                End If
            Else
                viewModel.IsSuccess = False
                viewModel.Message = "Invalid project parameters"
            End If

            Dim userRole As String = Convert.ToString(Session("EffectiveRole"))
            If String.IsNullOrWhiteSpace(userRole) Then
                viewModel.IsSuccess = False
                viewModel.Message = "Session expired. <a href='" & Url.Action("Index", "Portal") & "'>Click here</a> to go back to portal."
                Return View(viewModel)
            End If
            ViewBag.UserRole = userRole
            Return View(viewModel)
        End Function

        ' GET: Analysis/GetTabContent
        Public Async Function GetTabContent(tabName As String) As Task(Of PartialViewResult)
            Dim sw = Stopwatch.StartNew()
            Dim userName = Current_LoginUser

            'Log: request
            _logger.Information("GetTabContent - Request received | Tab: {TabName} | User: {User}", tabName, userName)
            Try
                ' Validate session parameters
                Dim sessionValidation = validateSessionParameters()
                If Not sessionValidation.IsValid Then
                    _logger.Warning("GetTabContent - session invalid | Tab: {TabName} | User: {User} | Reason: {Reason}", tabName, userName, sessionValidation.Message)
                    Return PartialView("_Error", sessionValidation.Message)
                End If

                Dim projectId = sessionValidation.ProjectId
                Dim projectStatusId? = sessionValidation.ProjectStatusId
                Dim projectFlowId? = sessionValidation.ProjectFlowId
                Dim userRole As String = Convert.ToString(Session("EffectiveRole"))
                If String.IsNullOrWhiteSpace(userRole) Then
                    _logger.Warning("GetTabContent - EffectiveRole missing from session | Tab: {TabName} | User: {User} | ProjectId: {ProjectId}", tabName, userName, projectId)
                    Return PartialView("_Error", "Session expired. <a href='" & Url.Action("Index", "Portal") & "'>Click here</a> to go back to portal.")
                End If
                Dim accessResult = AccessHelper.GetAccess(userRole, tabName)
                If accessResult.Access = "NO_ACCESS" Then
                    _logger.Warning("GetTabContent - access denied | Tab: {TabName} | User: {User} | Role: {Role}", tabName, userName, userRole)
                    Return PartialView("_Error", accessResult.Message)
                End If

                ViewBag.Access = accessResult.Access
                ViewBag.UserRole = userRole

                Select Case tabName.ToLower()
                    Case "admin"
                        _logger.Information("GetTabContent - Loading Admin tab | ProjectId: {ProjectId} | StatusId: {StatusId} | FlowId: {FlowId} | User: {User}",
                                            projectId, projectStatusId, projectFlowId, userName)
                        Dim adminData As AdminTabViewModel = Await _adminTabService.GetAdminDataAsync(projectId, projectStatusId, projectFlowId)
                        ' Persist CRE context to session all other tabs can access it
                        Session("AnalysisCreProjectId") = adminData.CommercialReProjId
                        Session("AnalysisCreTypeId") = adminData.ReTypeId
                        Session("AnalysisCreGoalId") = adminData.GoalId

                        _logger.Information("GetTabContent - Admin tab loaded | ProjectId: {ProjectId} | User: {User} | ElapsedMs: {ElapsedMs}ms",
                                            projectId, userName, sw.ElapsedMilliseconds)
                        Return PartialView("_adminTab", adminData)

                    Case "actors"
                        _logger.Information("GetTabContent - Loading Actors tab | ProjectId: {ProjectId} | StatusId: {StatusId} | FlowId: {FlowId} | User: {User}",
                                            projectId, projectStatusId, projectFlowId, userName)
                        ' Get actor tab data with proper async handling and parameter validation
                        If projectStatusId.HasValue AndAlso projectFlowId.HasValue Then
                            Dim actorData As ActorTabViewModel = Await _actorTabService.GetActorTabDataAsync(projectId, projectStatusId.Value, projectFlowId.Value)
                            _logger.Information("GetTabContent - Actors tab loaded | ProjectId: {ProjectId} | User: {User} | ElapsedMs: {ElapsedMs}ms",
                                                projectId, userName, sw.ElapsedMilliseconds)
                            Return PartialView("_actorsTab", actorData)
                        Else
                            ' Return error if required parameters are missing
                            _logger.Warning("GetTabContent - Actors tab missing required parameters | ProjectId: {ProjectId} | StatusId: {StatusId} | FlowId: {FlowId} | User: {User}",
                                            projectId, projectStatusId, projectFlowId, userName)
                            Return PartialView("_Error", "Missing required parameters for actor tab. Please ensure proejct status and flowid are available.")
                        End If

                    Case "project-credits"
                        Dim projectCreditsData As New ProjectCreditsTabViewModel
                        projectCreditsData = _projectCreditsTabService.GetProjectCreditsData(projectId, projectStatusId, projectFlowId)
