                            MOTI_ID_1: Motiv_1 || 0,
                            MOTI_ID_2: Motiv_2 || 0,
                            MOTI_ID_3: Motiv_3 || 0,
                            GUID_OTHER_COMMENT_NM: Argu || ''
                        };

                        fetch('/Analysis/Save_RE_DCRG', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', },
                            body: JSON.stringify(guidelinesData),
                        })
                            .then(response => {
                                if (!response.ok) {
                                    throw new Error('Network response was not ok');
                                }
                                return response.json();
                            })
                            .then(data => {
                                if (data.success) {

                                    showSuccessMessage('Data saved successfully');
                                    markDataAsClean();
                                    swChange = false;

                                    if (isTabSwitch) {
                                        if (typeof callback === 'function') {
                                            callback();
                                        }
                                    } else if (saveAndClose) {
                                        markTabAsSaved('guidelines', saveAndClose);
                                        // Return to tasklist after short delay
                                        setTimeout(function () {
                                            returnToTaskList();
                                        }, 1000);
                                    } else {
                                        if (creProject == "5") {
                                            // Remove alert after short delay
                                            setTimeout(function () {
                                                removeAlert();
                                            }, 2000);
                                        } else {
                                            markTabAsSaved('guidelines', saveAndClose);
                                            // Navigate to next tab after short delay
                                            setTimeout(function () {
                                                //navigateToNextTab(document.getElementById("RE_PROJ_STATUS_ID").value || 0, document.getElementById("txtCreProject").value || 0, document.getElementById("txtGoalId").value || 0, document.getElementById("txtBreyneLaw").value || 0);
                                                navigateToNextTab();
                                            }, 1000);
                                        }
                                    }

                                } else {

                                    console.error('Error saving guidelines data: ', response.message);
                                    showErrorMessage('Save failed', response.message || 'Failed to save data');
                                    markDataAsDirty()

                                }
                            })
                            .catch(error => {
                                console.error('Error saving guidelines data: ', error);
                                showErrorMessage('Save error', 'Failed to save data', +error);
                            });

                    } else {

                        // Validation failed
                        showErrorMessage('Validation failed', messages.join('<br>'));
                        if (focusField != null) {
                            focusField.focus();
                        }
                        event.preventDefault(); // Prevent form submission
                    }
                }
            </script>

            <script>
                function saveDecision() {

                    var messages = [];
                    var focusField;

                    removeAlert();

                    // check 'decision date'
                    var decisionDate = document.getElementById("txtDeciDate");
                    var dateParts = decisionDate.value.split('-');
                    var currentDate = new Date();

                    if (dateParts.length !== 3 || dateParts[0].length !== 2 || dateParts[1].length !== 2 || dateParts[2].length !== 4) {
                        messages.push("Please enter a valid decision date in the format dd-mm-yyyy.");
                        if (focusField == null) {
                            focusField = decisionDate;
                        }
                    } else {
                        // Additional validation to check if the date is valid
                        var day = parseInt(dateParts[0], 10);
                        var month = parseInt(dateParts[1], 10) - 1; // Months are 0-based in JavaScript
                        var year = parseInt(dateParts[2], 10);
                        var date = new Date(year, month, day);

                        if (date.getFullYear() !== year || date.getMonth() !== month || date.getDate() !== day) {
                            messages.push("Please enter a valid decision date in the format dd-mm-yyyy.");
