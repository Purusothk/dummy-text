                .container {
                    display: flex; /* Enables flexbox layout for the container */
                    justify-content: flex-start; /* Align columns to the left */
                    margin: 0; /* No extra margin around container */
                }

                .column {
                    flex: 1; /* Allows the column to grow and shrink as needed */
                    display: flex; /* Enables flexbox layout for the column */
                    flex-direction: column; /* Stacks the flex items vertically */
                }

                    .column + .column {
                        margin-left: 10px; /* Adds a left margin to all columns except the first one */
