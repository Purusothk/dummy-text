            <script>
                function StatusChange(newStatusId) {

                    var statusData = {
                        projectId: document.getElementById("RE_PROJ_ID").value || 0,
                        oldStatusId: document.getElementById("RE_PROJ_STATUS_ID").value || 0,
                        oldStatusFlowid: document.getElementById("RE_PROJ_STATUS_FLOW_ID").value || 0,
                        newStatusId: newStatusId
                    };

                    return fetch('/TaskList/ChangeProjectStatus', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', },
                        body: JSON.stringify(statusData),
                    })
                        .then(response => {
                            if (!response.ok) {
                                throw new Error('Network response was not ok');
                            }
                            return response.json();
                        })
                        .then(data => {
                            if (data.success) {

                                var element = document.getElementById("RE_PROJ_STATUS_ID");
                                if (element) {
                                    element.value = newStatusId;
                                    window.projectStatusId = newStatusId;
                                }

                                var element = document.getElementById("RE_PROJ_STATUS_FLOW_ID");
                                if (element) {
                                    element.value = data.newStatusFlowid;
                                    window.projectFlowId = data.newStatusFlowid;
                                }

                            } else {
                                alert(response.message ? response.message : 'Failed to change status.');
                            }
                        })
                        .catch(error => {
                            alert('Status change failed.');
                        });
                }
            </script>

        </form>
