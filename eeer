@ModelType AssetTabModel
<div class="admin-tab-content">
    <div class="container-fluid">
        <form class="admin-form form-horizontal" id="assetForm">

            <style>
                .ui-datepicker {
                    background: #fff !important; /* White background */
                    border: 1px solid #ccc !important;
                }

                .ui-datepicker-header {
                    background: #f0f0f0 !important;
                }

                .ui-datepicker-current-day {
                    background: #F0B2C9 !important;
                }
            </style>

            <div style="padding-bottom: 20px;" class="form-group form-group-sm">
                @Html.TextBox("txtRef", Model.ASST_RE_EVALUATION_REFERENCE_NM, New With {.class = "form-control input-sm", .readonly = "readonly", .style = "width: 220px;"})
                @Html.TextBox("txtProjId", Model.PROJ_ID, New With {.readonly = "readonly", .style = "background-color: red; width: 50px; display: none;"})
                @Html.TextBox("txtProjStatusId", Model.PROJ_STATUS_ID, New With {.readonly = "readonly", .style = "background-color: red; width: 50px; display: none;"})
                @Html.TextBox("txtProjStatusFlowId", Model.PROJ_STATUS_FLOW_ID, New With {.readonly = "readonly", .style = "background-color: red; width: 50px; display: none;"})
                @Html.TextBox("txtGoalId", Model.PRCR_GOAL_ID, New With {.style = "display: none;"})
                @Html.TextBox("txtBreyneLaw", Model.PRCR_BREYNE_LAW_SW, New With {.style = "display: none;"})
                @Html.TextBox("txtCreType", Model.PRCR_RE_TYPE_ID, New With {.style = "display: none;"})
            </div>

            <!--CRE guidelines-->
            <div class="admin-card">
                <div class="admin-card-header">
                    <h4 class="admin-card-title">CRE guidelines</h4>
                </div>
                <div class="admin-card-body">

                    <table style="display: inline-block; margin-left: 50px; margin-right: 100px; vertical-align: top;" class="form-group form-group-sm">
                        <tr>
                            <td style="text-align: right; padding-bottom: 5px;">
                                @Html.Label("CRE project", New With {.class = "control-label"})
                            </td>
                            <td style="padding-left: 10px; padding-bottom: 5px;">
                                @Html.DropDownList("DropDownCreProject", CType(ViewBag.SelectCreProject, IEnumerable(Of SelectListItem)), Nothing, New With {.class = "form-control input-sm", .readonly = "readonly", .disabled = "disabled", .style = "width: 220px;"})
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align: right; padding-bottom: 5px;">
                                @Html.Label("CRE type", New With {.class = "control-label"})
                            </td>
                            <td style="padding-left: 10px; padding-bottom: 5px;">
                                @Html.DropDownList("DropDownCreType", CType(ViewBag.SelectCreType, IEnumerable(Of SelectListItem)), Nothing, New With {.class = "form-control input-sm", .readonly = "readonly", .disabled = "disabled", .style = "width: 220px;"})
                            </td>
                        </tr>
                        <!-- Only if CRE TYPE is 'Senior housing / Service flats' (3) or 'Retail' (6) or 'Residential or mix' (7) or 'Office' (1)  or 'Logistic' (2) then 'CRE type detail' visible -->
                        @If Model.PRCR_RE_TYPE_ID = 3 Or Model.PRCR_RE_TYPE_ID = 6 Or Model.PRCR_RE_TYPE_ID = 7 Or Model.PRCR_RE_TYPE_ID = 1 Or Model.PRCR_RE_TYPE_ID = 2 Then
                            @<tr>
                                <td style="text-align: right; padding-bottom: 5px;">
                                    @Html.Label("CRE type detail (*)", New With {.class = "control-label"})
                                </td>
                                <td style="padding-left: 10px; padding-bottom: 5px;">
                                    @Html.DropDownList("DropDownCreTypeDetail", CType(ViewBag.SelectCreTypeDetail, IEnumerable(Of SelectListItem)), Nothing, New With {.class = "form-control input-sm", .style = "width: 220px;", .required = "required", .onchange = "swChange = true;"})
                                </td>
                            </tr>
                        End If
                    </table>

                    @If Model.PRCR_RE_TYPE_ID <> 3 And Model.PRCR_RE_TYPE_ID <> 6 And Model.PRCR_RE_TYPE_ID <> 7 And Model.PRCR_RE_TYPE_ID <> 1 And Model.PRCR_RE_TYPE_ID <> 2 Then
                        @<input type="hidden" id="DropDownCreTypeDetail" value="-1" />
                    End If

                    <!-- for 'YIELD PROPERTY' (1): Office (1), Logistic (2), Senior housing / Service flats (3), Residential or mix (7) -->
                    <!-- for 'PROPERTY PROMOTION' (2) or 'DEVELOPMENT' (3): Office (1), Logistic (2) -->
                    <!-- for 'OWN USE BUILDING' (5) -->
                    @If ((Model.PRCR_COMMERCIAL_RE_PRJ_ID = 1) And (Model.PRCR_RE_TYPE_ID = 1 Or Model.PRCR_RE_TYPE_ID = 2 Or Model.PRCR_RE_TYPE_ID = 3 Or Model.PRCR_RE_TYPE_ID = 7)) Or ((Model.PRCR_COMMERCIAL_RE_PRJ_ID = 2 Or Model.PRCR_COMMERCIAL_RE_PRJ_ID = 3) And (Model.PRCR_RE_TYPE_ID = 1 Or Model.PRCR_RE_TYPE_ID = 2)) Or (Model.PRCR_COMMERCIAL_RE_PRJ_ID = 5) Then
                        @<table style="display: inline-block; margin-right: 100px; vertical-align: top;" class="form-group form-group-sm">
                            <tr>
                                <td style="text-align: right; padding-bottom: 5px;">
                                    @Html.Label("Building year (*)", New With {.class = "control-label"})
                                </td>
                                <td style="padding-left: 10px; padding-bottom: 5px;">
                                    @Html.TextBox("txtBuildingYear", Model.CRGU_BUILDING_YEAR, New With {.class = "form-control input-sm", .style = "width: 60px;", .required = "required", .type = "number", .min = "1700", .pattern = "\\d{4}", .onchange = "swChange = true;"})
                                </td>
                                <td style="padding-left: 5px; padding-bottom: 5px;">
                                    @Html.Label("(YYYY)", New With {.class = "control-label"})
                                </td>
                            </tr>
                            <tr>
                                <td style="text-align: right; padding-bottom: 5px;">
                                    @Html.Label("Renovation year (*)", New With {.class = "control-label"})
                                </td>
                                <td style="padding-left: 10px; padding-bottom: 5px;">
                                    @Html.TextBox("txtRenovationYear", Model.CRGU_RENOVATION_YEAR, New With {.class = "form-control input-sm", .style = "width: 60px;", .required = "required", .type = "number", .min = "1700", .pattern = "\\d{4}", .onchange = "swChange = true;"})
                                </td>
                                <td style="padding-left: 5px; padding-bottom: 5px;">
                                    @Html.Label("(YYYY)", New With {.class = "control-label"})
                                </td>
                            </tr>
                            <tr>
                                <td style="text-align: right; padding-bottom: 5px;">
                                    @Html.Label("First usage (*)", New With {.class = "control-label"})
                                </td>
                                <td style="padding-left: 10px; padding-bottom: 5px;">
                                    @Html.TextBox("txtFirstUsageYear", Model.CRGU_FIRST_USAGE_YEAR, New With {.class = "form-control input-sm", .style = "width: 60px;", .required = "required", .type = "number", .min = "1700", .pattern = "\\d{4}", .onchange = "swChange = true;"})
                                </td>
                                <td style="padding-left: 5px; padding-bottom: 5px;">
                                    @Html.Label("(YYYY)", New With {.class = "control-label"})
                                </td>
                            </tr>
                        </table>
                    Else
                        @<input type="hidden" id="txtBuildingYear" value="0" />
                        @<input type="hidden" id="txtRenovationYear" value="0" />
                        @<input type="hidden" id="txtFirstUsageYear" value="0" />
                    End If

                    <table style="display: inline-block; margin-right: 100px; vertical-align: top;" class="form-group form-group-sm">
                        <!-- Only if CRE TYPE is 'Logistic' (2) then 'Compliant building' visible -->
                        @If Model.PRCR_RE_TYPE_ID = 2 Then
                            @<tr>
                                <td style="text-align: right; padding-bottom: 5px;">
                                    @Html.Label("Compliant building ", New With {.class = "control-label"})
                                </td>
                                <td style="padding-left: 10px; padding-bottom: 5px;">
                                    <select id="DropDownCompliantBuilding" data-tbd="true" style="width: 80px;" class="form-control input-sm" required onchange="swChange = true;">
                                        <option value="-1" @(If(Model.CRGU_COMPLIANT_BUILDING_SW = -1, "selected", ""))>SELECT</option>
                                        <option value="1" @(If(Model.CRGU_COMPLIANT_BUILDING_SW = 1, "selected", ""))>Yes</option>
                                        <option value="0" @(If(Model.CRGU_COMPLIANT_BUILDING_SW = 0, "selected", ""))>No</option>
                                    </select>
                                </td>
                            </tr>
                        End If
                        <!-- Only if CRE TYPE is 'Office' (1), 'Logistic' (2) or 'Retail' (6) then 'Prime location' visible -->
                        @If (Model.PRCR_RE_TYPE_ID = 1 Or Model.PRCR_RE_TYPE_ID = 2 Or Model.PRCR_RE_TYPE_ID = 6) Then
                            @<tr>
                                <td style="text-align: right; padding-bottom: 5px;">
                                    @Html.Label("Prime location ", New With {.class = "control-label"})
                                </td>
                                <td style="padding-left: 10px; padding-bottom: 5px;">
                                    <select id="DropDownPrimeLocation" data-tbd="true" style="width: 80px;" class="form-control input-sm" required onchange="swChange = true;">
                                        <option value="-1" @(If(Model.CRGU_PRIME_LOCATION_SW = -1, "selected", ""))>SELECT</option>
                                        <option value="1" @(If(Model.CRGU_PRIME_LOCATION_SW = 1, "selected", ""))>Yes</option>
                                        <option value="0" @(If(Model.CRGU_PRIME_LOCATION_SW = 0, "selected", ""))>No</option>
                                    </select>
                                </td>
                            </tr>
                        End If
                        <!-- Only if CRE TYPE is 'Building lots' (5) then 'Contaminated soils' visible -->
                        @If Model.PRCR_RE_TYPE_ID = 5 Then
                            @<tr>
                                <td style="text-align: right; padding-bottom: 5px;">
                                    @Html.Label("Contaminated soils (*)", New With {.class = "control-label"})
                                </td>
                                <td style="padding-left: 10px; padding-bottom: 5px;">
                                    <select id="DropDownContaminatedSoils" style="width: 160px;" class="form-control input-sm" required onchange="toggleRowCreCondition(); swChange = true;">
                                        <option value="-1" @(If(Model.CRGU_CONTAMINATED_SOILS_SW = -1, "selected", ""))>SELECT</option>
                                        <option value="1" @(If(Model.CRGU_CONTAMINATED_SOILS_SW = 1, "selected", ""))>Yes</option>
                                        <option value="0" @(If(Model.CRGU_CONTAMINATED_SOILS_SW = 0, "selected", ""))>No</option>
                                    </select>
                                </td>
                            </tr>
                            @<tr id="rowCRECONDITION" style="display: none;">
                                <td style="text-align: right; padding-bottom: 5px;">
                                    @Html.Label("CRE condition (*)", New With {.class = "control-label"})
                                </td>
                                <td style="padding-left: 10px; padding-bottom: 5px;">
                                    @Html.DropDownList("DropDownCreCondition", CType(ViewBag.SelectCreCondition, IEnumerable(Of SelectListItem)), Nothing, New With {.class = "form-control input-sm", .style = "width: 160px;", .required = "required", .onchange = "swChange = true;"})
                                </td>
                            </tr>
                        End If
                    </table>

                    @If Model.PRCR_RE_TYPE_ID <> 2 Then
                        @<input type="hidden" id="DropDownCompliantBuilding" value="-1" />
                    End If
                    @If (Model.PRCR_RE_TYPE_ID <> 1 And Model.PRCR_RE_TYPE_ID <> 2 And Model.PRCR_RE_TYPE_ID <> 6) Then
                        @<input type="hidden" id="DropDownPrimeLocation" value="-1" />
                    End If
                    @If Model.PRCR_RE_TYPE_ID <> 5 Then
                        @<input type="hidden" id="DropDownContaminatedSoils" value="-1" />
                        @<input type="hidden" id="DropDownCreCondition" value="@Model.PRCR_CRE_CONDITION_ID" />
                    End If

                    <table style="display: inline-block; vertical-align: top;" class="form-group form-group-sm">
                        @If Model.PRCR_RE_TYPE_ID = 5 Then
                            @<tr>
                                <td style="text-align: right; padding-bottom: 5px;">
                                    @Html.Label("Project aligned with Spatial Implementation Plan ", New With {.class = "control-label"})
                                </td>
                                <td style="padding-left: 10px; padding-bottom: 5px;">
                                    <select id="DropDownProjectAlignedSIP" style="width: 80px;" class="form-control input-sm"  data-tbd="true" required onchange="swChange = true;">
                                        <option value="-1" @(If(Model.CRGU_PROJECT_ALIGNED_SW = -1, "selected", ""))>SELECT</option>
                                        <option value="1" @(If(Model.CRGU_PROJECT_ALIGNED_SW = 1, "selected", ""))>Yes</option>
                                        <option value="0" @(If(Model.CRGU_PROJECT_ALIGNED_SW = 0, "selected", ""))>No</option>
                                    </select>
                                </td>
                            </tr>
                        End If

                        @If ((Model.PRCR_COMMERCIAL_RE_PRJ_ID = 1) And (Model.PRCR_RE_TYPE_ID = 1 Or Model.PRCR_RE_TYPE_ID = 2 Or Model.PRCR_RE_TYPE_ID = 6)) Then
                            @<tr>
                                <td style="text-align: right; padding-bottom: 5px;">
                                    @Html.Label("Tenant risk concentration ", New With {.class = "control-label"})
                                </td>
                                <td style="padding-left: 10px; padding-bottom: 5px;">
                                    <select id="DropDownTenantRisk" style="width: 60px;" class="form-control input-sm"  data-tbd="true" required onchange="swChange = true; toggleActor();">
                                        <option value="1" @(If(Not String.IsNullOrEmpty(Model.ACTR_ACTOR_ID), "selected", ""))>Yes</option>
                                        <option value="0" @(If(String.IsNullOrEmpty(Model.ACTR_ACTOR_ID), "selected", ""))>No</option>
                                    </select>
                                </td>
                                <td style="padding-left: 10px; padding-bottom: 5px;">
                                    @Html.TextBox("txtActorId", Model.ACTR_ACTOR_ID, New With {.class = "form-control input-sm", .style = "width: 80px;", .maxlength = "10", .onchange = "swChange = true; toggleActor();"})
                                </td>
                                <td style="padding-left: 10px; padding-bottom: 5px;">
                                    <button id="ActorButton" type="button" class="btn btn-sm btn-default" onclick="searchActor()">Search</button>
                                </td>
                            </tr>
                            @<tr>
                                <td style="padding-left: 10px; padding-bottom: 5px;">
                                    @Html.TextBox("txtActorName", Model.ACTR_ACTOR_NAME_NM, New With {.class = "form-control input-sm", .style = "width: 160px;", .maxlength = "100", .onchange = "swChange = true;"})
                                </td>
                                <td style="padding-left: 10px; padding-bottom: 5px;">
                                    @Html.TextBox("txtActorQuality", "", New With {.class = "form-control input-sm", .style = "width: 60px;", .readonly = "readonly", .disabled = "disabled"})
                                </td>
                                <td style="padding-left: 10px; padding-bottom: 5px;">
                                    @Html.DropDownList("DropDownActorQuality", CType(ViewBag.SelectActorQuality, IEnumerable(Of SelectListItem)), Nothing, New With {.class = "form-control input-sm", .style = "width: 80px;", .onchange = "swChange = true;"})
                                </td>
                            </tr>
                        End If
                    </table>

                    @If Model.PRCR_RE_TYPE_ID <> 5 Then
                        @<input type="hidden" id="DropDownProjectAlignedSIP" value="-1" />
                    End If
                    @If (Model.PRCR_COMMERCIAL_RE_PRJ_ID <> 1) Or (Model.PRCR_COMMERCIAL_RE_PRJ_ID = 1 And Model.PRCR_RE_TYPE_ID <> 1 And Model.PRCR_RE_TYPE_ID <> 2 And Model.PRCR_RE_TYPE_ID <> 6) Then
                        @<input type="hidden" id="DropDownTenantRisk" value="0" />
                        @<input type="hidden" id="ActorButton" />
                        @<input typ="hidden" id="txtActorId" value="" />
                        @<input type="hidden" id="txtActorName" value="" />
                        @<input type="hidden" id="txtActorQuality" value="" />
                        @<input type="hidden" id="DropDownActorQuality" value="-1" />
                    End If

                    <script>
                        function toggleRowCreCondition() {

                            var creType = document.getElementById("txtCreType").value;
                            var contaminatedSoils = document.getElementById("DropDownContaminatedSoils").value;
                            var rowCRECONDITION = document.getElementById("rowCRECONDITION");

                            if (creType == 5) {
                                // Hide row initially
                                rowCRECONDITION.style.display = "none";

                                if (contaminatedSoils == "1") {
                                    rowCRECONDITION.style.display = "";
                                }
                            }
                        }
                    </script>

                    <script>
                        function toggleActor() {

                            var creProject = document.getElementById("DropDownCreProject").value;
                            var creType = document.getElementById("DropDownCreType").value;

                            if ((creProject = 1) && (creType == 1 || creType == 2 || creType == 6)) {

                                var tenantRisk = document.getElementById("DropDownTenantRisk").value;
                                var actorId = document.getElementById("txtActorId");
                                var actorButton = document.getElementById("ActorButton");
                                var actorName = document.getElementById("txtActorName");
                                var actorQualityTxt = document.getElementById("txtActorQuality");
                                var actorQualityDrDwn = document.getElementById("DropDownActorQuality");

                                clearSpecificFieldErrors(actorId);

                                if (tenantRisk == "1") {
                                    actorId.style.display = "";
                                    actorName.style.display = "";
                                    if (actorId.value == "-") {
                                        actorButton.style.display = "none";
                                        actorQualityTxt.style.display = "none";
                                        actorQualityDrDwn.style.display = "";
                                        actorName.disabled = false;
                                        actorName.readOnly = false;
                                        document.getElementById("txtActorQuality").value = "";
                                    } else {
                                        actorButton.style.display = "";
                                        actorQualityTxt.style.display = "";
                                        actorQualityDrDwn.style.display = "none";
                                        actorName.disabled = true;
                                        actorName.readOnly = true;
                                        document.getElementById("DropDownActorQuality").value = "-1";
                                    }
                                } else {
                                    actorId.style.display = "none";
                                    actorButton.style.display = "none";
                                    actorName.style.display = "none";
                                    actorQualityTxt.style.display = "none";
                                    actorQualityDrDwn.style.display = "none";
                                    document.getElementById("txtActorId").value = "";
                                    document.getElementById("txtActorName").value = "";
                                    document.getElementById("txtActorQuality").value = "";
                                    document.getElementById("DropDownActorQuality").value = "-1";
                                }
                            }
                        }
                    </script>

                    <script>
                        function searchActor() {

                            const $actorInput = $('#txtActorId');
                            var actorId = $actorInput.val();

                            clearSpecificFieldErrors($actorInput);
                            $('#txtActorName').val('');
                            $('#txtActorQuality').val('');
                            $('#DropDownActorQuality').val('1');

                            // Check if actorId is empty
                            if (!actorId || actorId.trim() === '') {
                                setFieldError($actorInput, 'Actor ID is required');
                                return;
                            }

                            $.get('/Analysis/GetActorDetails', { actorId: actorId.trim() })
                                .done(function (response) {
                                    if (response.error) {
                                        setFieldError($actorInput, response.error);
                                        $('#txtActorName').val('');
                                        $('#txtActorQuality').val('');
                                        return;
                                    }
                                    $('#txtActorName').val(response.ActorName);
                                    $('#txtActorQuality').val(response.QualityName);
                                })
                                .fail(function (xhr, status, error) {
                                    setFieldError($actorInput, 'Failed to fetch actor data. Please try again.');
                                });
                        }
                    </script>
                </div>
            </div>

            <!--Address-->
            <div class="admin-card">
                <div class="admin-card-header">
                    <h4 class="admin-card-title">Address (*)</h4>
                </div>
                <div class="admin-card-body">

                    <table style="display: inline-block; margin-left: 50px; margin-right: 100px; vertical-align: top;" class="form-group form-group-sm">
                        <tr>
                            <td style="text-align: right; padding-bottom: 5px;">
                                @Html.Label("Street", New With {.class = "control-label"})
                            </td>
                            <td style="padding-left: 10px; padding-bottom: 5px;">
                                @Html.TextBox("txtStreet", Model.ASST_STREET_NM, New With {.class = "form-control input-sm", .style = "width: 370px;", .maxlength = "40", .onchange = "swChange = true;"})
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align: right; padding-bottom: 5px;">
                                @Html.Label("Street nr", New With {.class = "control-label"})
                            </td>
                            <td style="padding-left: 10px; padding-bottom: 5px;">
                                @Html.TextBox("txtStreetNr", Model.ASST_STREET_NR_NM, New With {.class = "form-control input-sm", .style = "width: 60px;", .maxlength = "5", .onchange = "swChange = true;"})
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align: right; padding-bottom: 5px;">
                                @Html.Label("Street box", New With {.class = "control-label"})
                            </td>
                            <td style="padding-left: 10px; padding-bottom: 5px;">
                                @Html.TextBox("txtStreetBox", Model.ASST_STREET_BOX_NM, New With {.class = "form-control input-sm", .style = "width: 60px;", .maxlength = "5", .onchange = "swChange = true;"})
                            </td>
                        </tr>
                    </table>

                    <table style="display: inline-block; margin-right: 100px; vertical-align: top;" class="form-group form-group-sm">
                        <tr>
                            <td style="text-align: right; padding-bottom: 5px;">
                                @Html.Label("Postal code", New With {.class = "control-label"})
                            </td>
                            <td style="padding-left: 10px; padding-bottom: 5px;">
                                @Html.TextBox("txtPostalCode", Model.ASST_POSTAL_CODE_ID, New With {.class = "form-control input-sm", .style = "width: 100px;", .maxlength = "10", .onchange = "swChange = true;"})
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align: right; padding-bottom: 5px;">
                                @Html.Label("City", New With {.class = "control-label"})
                            </td>
                            <td style="padding-left: 10px; padding-bottom: 5px;">
                                @Html.TextBox("txtCity", Model.ASST_CITY_NM, New With {.class = "form-control input-sm", .style = "width: 370px;", .maxlength = "40", .onchange = "swChange = true;"})
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align: right; padding-bottom: 5px;">
                                @Html.Label("Country", New With {.class = "control-label"})
                            </td>
                            <td style="padding-left: 10px; padding-bottom: 5px;">
                                @Html.DropDownList("DropDownCountry", CType(ViewBag.SelectCountry, IEnumerable(Of SelectListItem)), Nothing, New With {.class = "form-control input-sm", .style = "width: 120px;", .onchange = "swChange = true;"})
                            </td>
                        </tr>
                    </table>

                    <table style="display: inline-block; vertical-align: top; vertical-align: top;" class="form-group form-group-sm">
                        <tr>
                            <td style="text-align: right; padding-bottom: 5px;">
                                @Html.Label("Other location ref", New With {.class = "control-label"})
                            </td>
                            <td style="padding-left: 10px; padding-bottom: 5px;">
                                @Html.TextBox("txtOtherLocation", Model.ASST_OTHER_LOCATION_REFERENCE_NM, New With {.class = "form-control input-sm", .style = "width: 370px;", .maxlength = "40", .onchange = "swChange = true;"})
                            </td>
                        </tr>
                    </table>

                </div>
            </div>

            <!--Valuation-->
            <div class="admin-card">
                <div class="admin-card-header">
                    <h4 class="admin-card-title">Valuation</h4>
                </div>
                <div class="admin-card-body">

                    <table style="display: inline-block; margin-left: 50px; margin-right: 100px; vertical-align: top;" class="form-group form-group-sm">
                        <tr>
                            <td style="text-align: right; padding-bottom: 5px;">
                                @Html.Label("Nature (*)", New With {.class = "control-label"})
                            </td>
                            <td style="padding-left: 10px; padding-bottom: 5px;">
                                @Html.DropDownList("DropDownNature", CType(ViewBag.SelectNature, IEnumerable(Of SelectListItem)), Nothing, New With {.class = "form-control input-sm", .style = "width: 340px;", .required = "required", .onchange = "swChange = true;"})
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align: right; padding-bottom: 5px;">
                                @Html.Label("Attribute", New With {.class = "control-label"})
                            </td>
                            <td style="padding-left: 10px; padding-bottom: 5px;">
                                @Html.DropDownList("DropDownAttribute", CType(ViewBag.SelectAttribute, IEnumerable(Of SelectListItem)), Nothing, New With {.class = "form-control input-sm", .readonly = "readonly", .disabled = "disabled", .style = "width: 340px;"})
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align: right; padding-bottom: 5px;">
                                @Html.Label("Market value (*)", New With {.class = "control-label"})
                            </td>
