                    <script>
                        function setExpertiseMethodology (){

                            //rule Expertise Methodology - step 1
                            var natureValue = document.getElementById("DropDownNature").value;
                            var attributeValue = document.getElementById("DropDownAttribute").value;
                            var result_part1 = 0;

                            if (natureValue == '35') {
                                result_part1 = 1
                            } else {
                                switch (attributeValue) {
                                    case '11':
                                    case '12':
                                    case '13':
                                        result_part1 = 2;
                                        break;
                                    case '14':
                                    case '15':
                                    case '16':
                                        result_part1 = 3;
                                        break;
                                }
                            }

                            //rule Expertise Methodology - step 2
                            var result_part2 = 0;
                            var txtMarket = document.getElementById("txtMarket").value;
                            var sumCredit = parseFloat('@ViewBag.SumCredit'.replace(',', '.'));

                            // Remove commas and parse as float
                            var valueMarket = parseFloat(txtMarket.replace(/,/g, ''));

                            if (isNaN(valueMarket) || txtMarket.trim() === "") {
                                result_part2 = 0;
                            } else if (valueMarket < 500000) {
                                result_part2 = 1;
                            } else if (valueMarket < 1000000) {
                                result_part2 = 2;
                            } else if (valueMarket < 2500000) {
                                result_part2 = 3;
                            } else {
                                result_part2 = 4;
                            }

                            //rule Expertise Methodology - step 3
                            var result_part3 = 0;

                            if (isNaN(valueMarket) || txtMarket.trim() === "") {
                                result_part3 = 1
                            } else if ((sumCredit / valueMarket) > 0.75) {
                                result_part3 = 2
                            } else {
                                result_part3 = 1
                            }

                            //Concatenate
                            var result_concatenate = 0;

                            result_concatenate = (result_part1 * 100) + (result_part2 * 10) + result_part3

                            //Set Expertise Methodology
                            var expMethod = 0;
                            switch (result_concatenate) {
                                case 111:
                                case 121:
                                case 211:
                                case 212:
                                case 221:
                                case 311:
                                case 321:
                                    expMethod = 1;
                                    break;
                                case 141:
                                case 142:
                                case 241:
                                case 242:
                                case 341:
                                case 342:
                                    expMethod = 2;
                                    break;
                                case 112:
                                case 122:
                                case 131:
                                case 132:
                                case 312:
                                case 322:
                                case 331:
                                case 332:
                                    expMethod = 3;
                                    break;
                                case 222:
                                case 231:
                                case 232:
                                    expMethod = 4;
                                    break;
                            }
                            $('#DropDownExpMethod').val(expMethod);

                            // Forced Sale Value
                            var txtForced = document.getElementById("txtForced").value;

                            if (expMethod == 1) {                                               // 1 = Immotool
                                document.getElementById("txtForcedExpert").value = txtForced;
                                document.getElementById("txtForced").disabled = false;
                                document.getElementById("txtForced").style.backgroundColor = "white";
                            } else {
                                document.getElementById("txtForced").disabled = true;
                                document.getElementById("txtForced").style.backgroundColor = "lightgray";
                            }
                        }
                    </script>

                    <script>
                        function setValuationAmounts() {

                            var txtMarket = document.getElementById("txtMarket").value;
                            var txtForced = document.getElementById("txtForced").value;
                            var txtMarketExpert = document.getElementById("txtMarketExpert").value;
