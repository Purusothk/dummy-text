            <script>
                function formatAllTextboxes() {

                    var inputs = document.getElementsByTagName('input');

                    for (var i = 0; i < inputs.length; i++) {

                        var input = inputs[i];

                        if (input.type === 'text' && input.getAttribute('tag') === 'MyNumber') {

                            let start = input.selectionStart;
                            let end = input.selectionEnd;
                            let value = input.value.replace(/\D/g, ''); // Remove all non-digit characters

                            // Format with thousand separators (dots)
                            let formattedNumber = value.replace(/\B(?=(\d{3})+(?!\d))/g, ".");

                            input.value = formattedNumber;
                            input.setSelectionRange(start, end);
                        }
                    }
                }
            </script>

            <script>
                function unformatAllTextboxes() {

                    var inputs = document.getElementsByTagName('input');

                    for (var i = 0; i < inputs.length; i++) {

                        var input = inputs[i];

                        if (input.type === 'text' && input.getAttribute('tag') === 'MyNumber') {

                            let start = input.selectionStart;
                            let end = input.selectionEnd;
                            // Remove all thousand separators (dots)
                            input.value = input.value.replace(/\./g, '');
                            input.setSelectionRange(start, end);
                        }
                    }
                }
            </script>

            <script>
                window.unFormatThisNumber = function (input) {
                    var value = input.value;
                    value = value.replace(/\./g, ''); // Replace all dots with nothing
                    value = value.replace(/\,/g, '.'); // Replace all commas with dots
                    input.value = value;
                };
            </script>

