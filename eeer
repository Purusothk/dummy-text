            <script>
                function saveGuidelinesTab(saveAndClose, callback, isTabSwitch) {

                    isTabSwitch = isTabSwitch || false;

                    var messages = [];
                    var focusField;
                    var creProject = document.getElementById("txtCreProject").value;
                    var Motiv_1, Motiv_2, Motiv_3;
                    var Argu;

                    removeAlert();

                    // check 'deviation motivations'
