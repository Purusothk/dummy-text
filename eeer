<? xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>System.Data.DataSet</DataProvider>
        <ConnectString>/* Local Connection */</ConnectString>
      </ConnectionProperties>
      <rd:DataSourceID>a1111111-1111-1111-1111-111111111111</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="AnalysisFields">
      <Fields>
        <Field Name="TabName">
          <DataField>TabName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SectionName">
          <DataField>SectionName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Label">
          <DataField>Label</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Value">
          <DataField>Value</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SortOrder">
          <DataField>SortOrder</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText></CommandText>
      </Query>
    </DataSet>
  </DataSets>
  <Body>
    <ReportItems>
      <Textbox Name="TitleTextbox">
        <CanGrow>true</CanGrow>
        <Height>0.3in</Height>
        <Width>6.5in</Width>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Project Analysis Report</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>14pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <Style>
          <Border>
            <Style>None</Style>
          </Border>
        </Style>
        <Top>0in</Top>
        <Left>0in</Left>
      </Textbox>
      <Tablix Name="Tablix1">
        <TablixBody>
          <TablixColumns>
            <TablixColumn>
              <Width>2in</Width>
            </TablixColumn>
            <TablixColumn>
              <Width>4.5in</Width>
            </TablixColumn>
          </TablixColumns>
          <TablixRows>
            <!-- Row 0: TabName group header. Two cells, same background color and
                 no border between them, so it reads as one solid bar across the
                 row without relying on ColSpan (not valid on TablixCell in this schema). -->
            <TablixRow>
              <Height>0.3in</Height>
              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="TabNameHeaderTextbox">
                      <CanGrow>true</CanGrow>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=Fields!TabName.Value</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>12pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                                <Color>White</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style />
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <BackgroundColor>#34495E</BackgroundColor>
                        <PaddingLeft>4pt</PaddingLeft>
                        <PaddingTop>2pt</PaddingTop>
                        <PaddingBottom>2pt</PaddingBottom>
                        <Border>
                          <Style>None</Style>
                        </Border>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="TabNameHeaderFillTextbox">
                      <CanGrow>true</CanGrow>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value></Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>12pt</FontSize>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style />
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <BackgroundColor>#34495E</BackgroundColor>
                        <Border>
                          <Style>None</Style>
                        </Border>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
              </TablixCells>
            </TablixRow>
            <!-- Row 1: SectionName group header. Same two-cell-same-color technique. -->
            <TablixRow>
              <Height>0.25in</Height>
              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="SectionNameHeaderTextbox">
                      <CanGrow>true</CanGrow>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=Fields!SectionName.Value</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>10pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                                <Color>White</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style />
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <BackgroundColor>#5D6D7E</BackgroundColor>
                        <PaddingLeft>4pt</PaddingLeft>
                        <PaddingTop>2pt</PaddingTop>
                        <PaddingBottom>2pt</PaddingBottom>
                        <Border>
                          <Style>None</Style>
                        </Border>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="SectionNameHeaderFillTextbox">
                      <CanGrow>true</CanGrow>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value></Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>10pt</FontSize>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style />
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <BackgroundColor>#5D6D7E</BackgroundColor>
                        <Border>
                          <Style>None</Style>
                        </Border>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
              </TablixCells>
            </TablixRow>
            <!-- Row 2: Detail row - Label | Value -->
            <TablixRow>
              <Height>0.2in</Height>
              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="LabelTextbox">
                      <CanGrow>true</CanGrow>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=Fields!Label.Value</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>9pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style />
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <BackgroundColor>#F5F5F5</BackgroundColor>
                        <PaddingLeft>4pt</PaddingLeft>
                        <Border>
                          <Style>Solid</Style>
                          <Color>LightGrey</Color>
                          <Width>0.5pt</Width>
                        </Border>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ValueTextbox">
                      <CanGrow>true</CanGrow>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=Fields!Value.Value</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>9pt</FontSize>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style />
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <PaddingLeft>4pt</PaddingLeft>
                        <Border>
                          <Style>Solid</Style>
                          <Color>LightGrey</Color>
                          <Width>0.5pt</Width>
                        </Border>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
              </TablixCells>
            </TablixRow>
          </TablixRows>
        </TablixBody>
        <TablixColumnHierarchy>
          <TablixMembers>
            <TablixMember />
            <TablixMember />
          </TablixMembers>
        </TablixColumnHierarchy>
        <TablixRowHierarchy>
          <TablixMembers>
            <!-- TabNameGroup: dynamic, one iteration per distinct TabName.
                 Not itself a leaf - it has two children below. -->
            <TablixMember>
              <Group Name="TabNameGroup">
                <GroupExpressions>
                  <GroupExpression>=Fields!TabName.Value</GroupExpression>
                </GroupExpressions>
              </Group>
              <SortExpressions>
                <SortExpression>
                  <Value>=Fields!TabName.Value</Value>
                </SortExpression>
              </SortExpressions>
              <TablixMembers>
                <!-- Static leaf: the TabName header row itself. No Group ->
                     appears exactly once per TabNameGroup iteration.
                     Maps to TablixRow[0]. -->
                <TablixMember />
                <!-- SectionNameGroup: dynamic, one iteration per distinct
                     SectionName within this Tab. Not a leaf - has two children. -->
                <TablixMember>
                  <Group Name="SectionNameGroup">
                    <GroupExpressions>
                      <GroupExpression>=Fields!SectionName.Value</GroupExpression>
                    </GroupExpressions>
                  </Group>
                  <SortExpressions>
                    <SortExpression>
                      <Value>=Fields!SectionName.Value</Value>
                    </SortExpression>
                  </SortExpressions>
                  <TablixMembers>
                    <!-- Static leaf: the SectionName header row itself.
                         Maps to TablixRow[1]. -->
                    <TablixMember />
                    <!-- Details: dynamic leaf, one row per underlying data
                         row (field). Maps to TablixRow[2]. -->
                    <TablixMember>
                      <Group Name="Details" />
                      <SortExpressions>
                        <SortExpression>
                          <Value>=Fields!SortOrder.Value</Value>
                        </SortExpression>
                      </SortExpressions>
                    </TablixMember>
                  </TablixMembers>
                </TablixMember>
              </TablixMembers>
            </TablixMember>
          </TablixMembers>
        </TablixRowHierarchy>
        <DataSetName>AnalysisFields</DataSetName>
        <Top>0.4in</Top>
        <Left>0in</Left>
        <Height>0.75in</Height>
        <Width>6.5in</Width>
      </Tablix>
    </ReportItems>
    <Height>8in</Height>
  </Body>
  <Width>6.5in</Width>
  <Page>
    <PageHeight>11in</PageHeight>
    <PageWidth>8.5in</PageWidth>
    <LeftMargin>1in</LeftMargin>
    <RightMargin>1in</RightMargin>
    <TopMargin>1in</TopMargin>
    <BottomMargin>1in</BottomMargin>
    <ColumnSpacing>0in</ColumnSpacing>
  </Page>
  <rd:ReportUnitType>Inch</rd:ReportUnitType>
  <rd:ReportID>b2222222-2222-2222-2222-222222222222</rd:ReportID>
</Report>