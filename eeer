                            messages.push("At least 1 deviation motivation is required.");
                            if (focusField == null) {
                                focusField = document.getElementById("DropDownDeviatMotiv_1");
                            }
                        }
                        else {
                            if (
                                (document.getElementById("DropDownDeviatMotiv_1").value == document.getElementById("DropDownDeviatMotiv_2").value && document.getElementById("DropDownDeviatMotiv_1").value != "0") ||
                                (document.getElementById("DropDownDeviatMotiv_1").value == document.getElementById("DropDownDeviatMotiv_3").value && document.getElementById("DropDownDeviatMotiv_1").value != "0") ||
                                (document.getElementById("DropDownDeviatMotiv_2").value == document.getElementById("DropDownDeviatMotiv_3").value && document.getElementById("DropDownDeviatMotiv_2").value != "0")
                            ) {
                                messages.push("You can't choose the same deviation motivation twice.");
