                            DECI_DECISION_ID: document.getElementById("DropDownDecision").value || 0,
                            DECI_DECISION_DATE_DT: document.getElementById("txtDeciDate").value || '',
                            DECI_RATIONALE_NM: document.getElementById("txtRationale").value || '',
                            DECI_CONDTIONS_NM: document.getElementById("txtDeciCondition").value || '',
                            DECI_COLLATERALS_NM: document.getElementById("txtCollateral").value || '',
                            DECM_USER_ID_1: document.getElementById("txtUser1").value || '',
                            DECM_USER_ID_2: document.getElementById("txtUser2").value || '',
                            DECM_USER_ID_3: document.getElementById("txtUser3").value || '',
                            DECM_USER_ID_4: document.getElementById("txtUser4").value || '',
                            DECM_USER_ID_5: document.getElementById("txtUser5").value || '',
                            DECM_USER_ID_6: document.getElementById("txtUser6").value || '',
                            DECM_USER_ID_7: document.getElementById("txtUser7").value || '',
                            DECM_USER_ID_8: document.getElementById("txtUser8").value || '',
                            DECM_USER_ID_9: document.getElementById("txtUser9").value || '',
                            DECM_USER_ID_10: document.getElementById("txtUser10").value || '',
                            DECI_CONTACT_NM: document.getElementById("txtContactName").value || '',
                            DECI_CONTACT_EMAIL_NM: document.getElementById("txtContactEmail").value || '',
                            DECI_CONTACT_PHONE_NR: document.getElementById("txtContactPhone").value || ''
                        };

                        fetch('/Analysis/Save_RE_DECI', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', },
                            body: JSON.stringify(decisionData),
                        })
                            .then(response => {
                                if (!response.ok) {
                                    throw new Error('Network response was not ok');
                                }
                                return response.json();
                            })
                            .then(data => {
                                if (data.success) {

                                    showSuccessMessage('Decision data saved successfully');
                                    markDataAsClean();
                                    swChange = false;

                                    // Approved
                                    if (document.getElementById("DropDownDecision").value == "1") {

                                        // status change to "Decision taken"
                                        StatusChange(5);

                                        document.getElementById('btnPDFsynth_OwnUse').style.display = 'none';
                                        document.getElementById('btnPDFminut_OwnUse').style.display = 'inline-block';

                                        var FVT_Validated = true; // to do
                                        var expMethod = document.getElementById("txtExpMethod").value;

                                        if (document.getElementById("DropDownMatchCommittee").value == "1" && (FVT_Validated || expMethod == 1)) {

                                            document.getElementById('btnDeciTaken_OwnUse').style.display = 'none';
                                            document.getElementById('btnReadyCS_OwnUse').style.display = 'inline-block';
                                            $('#DropDownDeciLevel, #DropDownDecision, #txtDeciDate, #DropDownMatchCommittee').prop('disabled', true);
                                            $('#txtRationale, #txtDeciCondition, #txtCollateral').prop('disabled', true);
                                            $('#txtUser1, #txtUser2, #txtUser3, #txtUser4, #txtUser5').prop('disabled', true);
                                            $('#txtUser6, #txtUser7, #txtUser8, #txtUser9, #txtUser10').prop('disabled', true);

                                            setTimeout(function () { removeAlert(); }, 2000);
                                        }
                                        else {

                                            if (document.getElementById("DropDownMatchCommittee").value != "1") {
                                                messages.push("If this file needs to move to the next status, you must answer 'Yes' to the question.");
                                                if (focusField == null) {
                                                    focusField = document.getElementById("DropDownMatchCommittee");
                                                }
                                            }
                                            if (!FVT_Validated) {
                                                messages.push("If this file needs to move to the next status, FVT should be validated'.");
                                            }
                                            showErrorMessage('Warning', messages.join('<br>'));
                                            if (focusField != null) {
                                                focusField.focus();
                                            }
                                        }
                                    }
                                    // Refused
                                    else {

                                        // status change to "Decision taken"
                                        StatusChange(5).then(() => {

                                            // status change to "Refused"
                                            return StatusChange(7);

                                        });

                                        // Return to tasklist after short delay
                                        setTimeout(function () { returnToTaskList(); }, 1000);
                                    }

                                } else {
                                    console.error('Error saving decision data: ', response.message);
                                    showErrorMessage('Save failed', response.message || 'Failed to save decision data');
                                    markDataAsDirty()
                                }
                            })
                            .catch(error => {
                                console.error('Error saving decision data: ', error);
                                showErrorMessage('Save error', 'Failed to save decision data', +error);
                            });
                    } else {

                        // Validation failed
                        showErrorMessage('Validation failed', messages.join('<br>'));
                        if (focusField != null) {
                            focusField.focus();
                        }
                        event.preventDefault(); // Prevent form submission
                    }
                }
            </script>

            <script>
                function saveContactPerson() {

                    var messages = [];
                    var focusField;

                    removeAlert();

                    var contactName = document.getElementById("txtContactName");
                    var contactEmail = document.getElementById("txtContactEmail");
                    var contactPhone = document.getElementById("txtContactPhone");

                    if (!contactName.value) {
                        messages.push("Name of contact person is required.");
                        if (focusField == null) {
                            focusField = contactName;
                        }
                    }
                    if (!contactEmail.value) {
                        messages.push("E-mail of contact person is required.");
                        if (focusField == null) {
                            focusField = contactEmail;
                        }
                    }
                    if (!contactPhone.value) {
                        messages.push("Phone of contact person is required.");
                        if (focusField == null) {
                            focusField = contactPhone;
                        }
                    }

                    if (messages.length === 0) {

                        // Saving the part "Contact Person"

                        var contactData = {
